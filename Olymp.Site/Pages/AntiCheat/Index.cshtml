@page
@attribute [Authorize(Policy = PolicyNames.Admin)]
@model IndexModel
@{
    ViewData["Title"] = Localizer["AntiCheat"];
}
<h1>@ViewData["Title"]</h1>

<div class="btn-group">
    <a class="btn btn-info" asp-page="./PlagiarismTest">@Localizer["Plagiarism Test"]</a>
    <a class="btn btn-info" asp-page="./AIDetectionTest">@Localizer["AI Detection Test"]</a>
    <a class="btn btn-primary" asp-page="./ByDate">@Localizer["ByDate"]</a>
</div>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating mb-3">
        <select asp-for="Input.ContestId" asp-items="Model.ContestList" class="form-select">
            <option selected></option>
        </select>
        <label asp-for="Input.ContestId"></label>
        <span asp-validation-for="Input.ContestId" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Threshold" class="form-control">
        <label asp-for="Input.Threshold"></label>
        <span asp-validation-for="Input.Threshold" class="text-danger"></span>
    </div>
    <div class="btn-group">
        <button type="submit" class="btn btn-primary" asp-route-action="Plagiarism">@Localizer["Plagiarism"]</button>
        <button type="submit" class="btn btn-primary" asp-route-action="AIUsing">@Localizer["Detect AI Using"]</button>
    </div>
</form>

<hr />
<partial name="_PlagiarismReport" for="PlagiarismReports" />
<partial name="_AIUsingReport" for="AIUsingReports" />