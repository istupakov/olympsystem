@model IEnumerable<AIUsingReport>

<div class="accordion" id="aireport">
    @foreach (var report in Model)
    {
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#user-@report.Competitor.Id" aria-expanded="false"
                    aria-controls="user-@report.Competitor.Id">
                    @report.Competitor.Name
                    (@string.Format("probability {0:p2}", report.Cases.Max(x => x.Result.Probability)))
                </button>
            </h2>
            <div id="user-@report.Competitor.Id" class="accordion-collapse collapse" data-bs-parent="#aireport">
                <div class="accordion-body">
                    <ul>
                        @foreach (var group in report.Cases.GroupBy(x => x.Submission.Problem))
                        {
                            <li>
                                <h3>@group.Key.NameWithNumber
                                    (@string.Format("probability {0:p2}", group.Max(x => x.Result.Probability)))</h3>
                                <ul>
                                    @foreach (var c in group)
                                    {
                                        <li>
                                            <h4>@string.Format("probability {0:p2}", c.Result.Probability)</h4>
                                            <p>@c.Submission.Id
                                                (@c.Submission.CommitTime, @c.Submission.Compilator.Name,
                                                @string.Format(Localizer[c.Submission.StatusTemplate],
                                                c.Submission.StatusTestNumber))
                                    <a asp-page="/Submissions/Download"
                                        asp-route-id="@c.Submission.Id">@Localizer["download"]</a>
                                    <span class="user-select-none">|</span>
                                    <a asp-page="/Submissions/Code"
                                        asp-route-id="@c.Submission.Id">@Localizer["view"]</a>

                                    <samp>
                                        <p>Probability: @c.Result.Probability</p>
                                        <p>Cyrillic Comments: @c.Result.CyrillicComments</p>
                                        <p>English comments: @c.Result.EnglishComments</p>
                                        @foreach (var fragment in c.Result.SuspiciousFragments ?? [])
                                                    {
                                                        <pre><code>@fragment</code></pre>
                                                    }
                                                </samp>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>