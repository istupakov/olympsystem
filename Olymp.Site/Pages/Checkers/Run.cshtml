@page
@attribute [Authorize(Policy = PolicyNames.JuryOrAdmin)]
@model RunModel
@{
    ViewData["Title"] = Localizer["Run"];
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a asp-page="./Index" class="btn btn-outline-secondary">@Localizer["Back to checkers"]</a>
</div>

@if (Model.CheckerList.Count == 0) {
    <div class="alert alert-warning" role="alert">@Localizer["No connected runners"]</div>
}
@if (Model.CompilatorList.Count == 0) {
    <div class="alert alert-warning" role="alert">@Localizer["No available compilators"]</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="form-floating">
                <select asp-for="Input.CheckerId" asp-items="Model.CheckerList" class="form-select" required>
                    <option value="">@Localizer["Select a runner"]</option>
                </select>
                <label asp-for="Input.CheckerId"></label>
            </div>
            <span asp-validation-for="Input.CheckerId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <div class="form-floating">
                <select asp-for="Input.CompilatorName" asp-items="Model.CompilatorList" class="form-select" required>
                    <option value="">@Localizer["Select a compilator"]</option>
                </select>
                <label asp-for="Input.CompilatorName"></label>
            </div>
            <span asp-validation-for="Input.CompilatorName" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Code" class="form-label"></label>
        <textarea asp-for="Input.Code" class="form-control font-monospace" style="height: 20rem" spellcheck="false" autocapitalize="off" autocomplete="off" wrap="off" required></textarea>
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Input" class="form-label"></label>
        <textarea asp-for="Input.Input" class="form-control font-monospace" style="height: 10rem" spellcheck="false" autocapitalize="off" autocomplete="off" wrap="off"></textarea>
        <span asp-validation-for="Input.Input" class="text-danger"></span>
    </div>
    <p class="small text-body-secondary">@Localizer["Execution limits: {0} s, {1} MB", RunModel.TimeLimitSeconds, RunModel.MemoryLimitMb]</p>
    <button type="submit" class="btn btn-primary" disabled="@(Model.CheckerList.Count == 0 || Model.CompilatorList.Count == 0)">@Localizer["Run"]</button>
</form>

@if (Model.Output is not null) {
    <section class="mt-4">
        <h2 class="h4">@Localizer["Execution result"]</h2>
        <pre class="border rounded bg-body-tertiary p-3 text-break" style="white-space: pre-wrap;"><samp>@Model.Output</samp></pre>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
