@page
@using Olymp.Site.Services.Checker;
@attribute [Authorize(Policy = PolicyNames.JuryOrAdmin)]
@model IndexModel
@{
	ViewData["Title"] = Localizer["Checkers"];
	var checkers = Model.Checkers.ToArray();
	var isAdmin = User.IsInRole(RoleNames.Admin);
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
	<h1 class="mb-0">@ViewData["Title"]</h1>
	<div class="d-flex flex-wrap gap-2">
		@if (isAdmin) {
			<form method="post" asp-page-handler="DisableCompilators">
				<button type="submit" class="btn btn-outline-danger" disabled="@(checkers.Any(x => x.SelfTestingStatus is CheckerSelfTestingStatus.Unknown or CheckerSelfTestingStatus.InProcess))">@Localizer["Disable compilators without a runner"]</button>
			</form>
		}
		<a asp-page="./Run" class="btn btn-outline-primary">@Localizer["Run"]</a>
	</div>
</div>

@if (Model.StatusMessage is { } message) {
	<div class="alert alert-success" role="status">@message</div>
}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@if (checkers.Length == 0) {
	<div class="alert alert-warning" role="alert">@Localizer["No connected runners"]</div>
}

@foreach (var checker in checkers) {
	var selfTestingStatus = checker.SelfTestingStatus;
	var results = checker.SelfTestingResults.ToLookup(x => x.Compilator.Configuration.Name);
	var (statusText, statusClass) = selfTestingStatus switch {
		CheckerSelfTestingStatus.InProcess => ("Self-testing in progress", "primary"),
		CheckerSelfTestingStatus.Success => ("Self-testing passed", "success"),
		CheckerSelfTestingStatus.Failed => ("Self-testing failed", "danger"),
		_ => ("Waiting for self-testing", "secondary")
	};
	<section class="mb-4">
		<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
			<div>
				<h2 class="h4 mb-1">@checker.Name</h2>
				<div class="small text-body-secondary text-break">@checker.Id</div>
				<div class="small text-body-secondary">@Localizer["Connecting time"]: @checker.ConnectingTime.ToString("g")</div>
			</div>
			<div class="d-flex flex-wrap align-items-center gap-2">
				<span class="badge text-bg-@statusClass">@Localizer[statusText]</span>
				@if (isAdmin) {
					<form method="post" asp-page-handler="AddCompilators">
						<input type="hidden" name="checkerId" value="@checker.Id" />
						<button type="submit" class="btn btn-sm btn-outline-primary" disabled="@(selfTestingStatus != CheckerSelfTestingStatus.Success)">@Localizer["Add runner compilators"]</button>
					</form>
				}
			</div>
		</div>
		@if (checker.VersionLog is { Length: > 0 } versionLog) {
			<details class="mb-3">
				<summary>@Localizer["Version probe log"]</summary>
				<pre class="text-break mt-2" style="white-space: pre-wrap;">@versionLog</pre>
			</details>
		}
		@if (checker.Compilators is not { } compilators) {
			<p class="text-body-secondary">@Localizer["Loading compiler versions..."]</p>
		}
		else if (compilators.Count == 0) {
			<p class="text-danger">@Localizer["No available compilators"]</p>
		}
		else {
			@foreach (var compilator in compilators) {
				var tests = results[compilator.Configuration.Name].ToArray();
				var completed = tests.Length == Model.GetTestCount(compilator.Configuration);
				var passed = tests.Count(x => x.Result == x.Test.ExpectedResult);
				var failed = tests.Length - passed;
				var hasError = compilator.Error is not null || failed > 0 || (completed && tests.Length == 0);
				var testClass = hasError ? "danger" : completed ? "success" : "secondary";
				<details class="border rounded mb-2" open="@hasError">
					<summary class="p-3">
						<span class="fw-semibold">@compilator.DisplayName</span>
						<span class="badge text-bg-@testClass ms-2">
							@if (compilator.Error is not null) {
								@Localizer["Unavailable"]
							}
							else if (failed > 0) {
								@Localizer["Passed {0} of {1}; failures: {2}", passed, tests.Length, failed]
							}
							else if (tests.Length == 0) {
								@Localizer[completed ? "No tests" : "Waiting for tests"]
							}
							else if (!completed) {
								@Localizer["Passed {0}; self-testing in progress", passed]
							}
							else {
								@Localizer["Passed {0} of {1}", passed, tests.Length]
							}
						</span>
						<span class="d-block small text-body-secondary mt-1">@Localizer["Configuration"]: @compilator.Configuration.Name (@compilator.Configuration.ConfigName)</span>
					</summary>
					<div class="border-top p-3">
						@if (!string.IsNullOrWhiteSpace(compilator.Description)) {
							<p class="text-break">@compilator.Description</p>
						}
						@if (compilator.Error is { } error) {
							<p class="text-danger">@Localizer["Version could not be determined"]</p>
							<pre class="text-break text-danger" style="white-space: pre-wrap;">@error</pre>
						}
						@if (tests.Length > 0) {
							<div class="table-responsive">
								<table class="table table-sm align-middle mb-0">
									<thead>
										<tr>
											<th scope="col">@Localizer["Test"]</th>
											<th scope="col">@Localizer["Expected result"]</th>
											<th scope="col">@Localizer["Actual result"]</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var test in tests) {
											<tr class="@(test.Result == test.Test.ExpectedResult ? null : "table-danger")">
												<th scope="row" class="fw-normal text-break">@test.Test.Name</th>
												<td>@test.Test.ExpectedResult</td>
												<td>@test.Result</td>
											</tr>
											<tr>
												<td colspan="3" class="pt-0">
													<details class="mt-1">
														<summary>@Localizer["View log"]</summary>
														<pre class="text-break mt-2" style="white-space: pre-wrap;">@test.Output</pre>
													</details>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</div>
				</details>
			}
		}
	</section>
}
