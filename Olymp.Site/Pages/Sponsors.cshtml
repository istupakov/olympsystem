@page
@{
  ViewData["Title"] = Localizer["Sponsors"];
}
<h1>@ViewData["Title"]</h1>

<div class="row">
  <div class="col m-3">
    <a href="https://t-technologies.ru/">
      <img class="img-fluid sponsor-logo-light" src="~/sponsors/T-Technology_logo_rus_black.svg" alt="@Localizer["T-Technologies"]" asp-append-version="true" />
      <img class="img-fluid sponsor-logo-dark" src="~/sponsors/T-Technology_logo_rus_white.svg" alt="@Localizer["T-Technologies"]" asp-append-version="true" />
    </a>
  </div>
</div>
