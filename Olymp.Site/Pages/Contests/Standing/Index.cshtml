@page "{id:int}"
@model IndexModel
@{
	ViewData["Title"] = Localizer["Results for {0}", Model.Contest.Name];
	ViewData["ShowApprovedBadge"] = false;
}
<h1>@Model.Contest.Name</h1>

<div class="table-responsive">
	@if (ViewData["Table"] is not null) {
		@Html.Raw(ViewData["Table"])
	}
	else {
		<partial name="_StandingTable" for="Standing" />
	}
</div>

@section Scripts {
	<script>
		$("table").addClass("table caption-top table-sm table-hover table-striped table-bordered")
		$(".successmark").addClass("text-success-emphasis text-center")
		$(".failmark").addClass("text-danger-emphasis text-center")
		$(".firstmark").addClass("table-success text-center")
	</script>
}
