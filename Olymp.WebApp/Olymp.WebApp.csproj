<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Olymp.Domain\Olymp.Domain.csproj" />
    <ProjectReference Include="..\Olymp.Site\Olymp.Site.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/AccountResources.resx;Resources/SiteResources.resx">
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedClassName>%(Filename)</StronglyTypedClassName>
      <StronglyTypedNamespace>$(RootNamespace).Resources</StronglyTypedNamespace>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="GenerateDesignTimeResources" BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareResources" Condition="'$(DesignTimeBuild)' == 'true'" />

  <Target Name="ExcludeLegacySiteStaticWebAssets" AfterTargets="ResolveReferencedProjectsStaticWebAssetsConfiguration">
    <ItemGroup>
      <StaticWebAssetProjectConfiguration Remove="@(StaticWebAssetProjectConfiguration)"
                                         Condition="'%(Source)' == 'Olymp.Site' Or '%(Source)' == 'Olymp.Site.IdentityUI'" />
    </ItemGroup>
  </Target>

  <Target Name="ExcludeLegacySitePublishSettings" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Olymp.Site'))/appsettings*.json" />
    </ItemGroup>
  </Target>

</Project>
