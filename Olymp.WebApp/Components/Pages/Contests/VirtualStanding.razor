@page "/contests/{Id:int}/virtual"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@using Olymp.WebApp.Components.Contests
@inject NavigationManager Navigation
@inject IDbContextFactory<OlympContext> ContextFactory

@if (_contest is not null)
{
    <PageTitle>@SiteResources.VirtualContest – @_contest.Name</PageTitle>
    <ContestHeader Contest="_contest" ActiveSection="virtual" />
    <h2 class="h4">@SiteResources.VirtualContest</h2>
    <p class="small text-body-secondary">@SiteResources.VirtualContestHelp</p>
    <AuthorizeView Policy="SignedIn">
        <Authorized>
            <AuthorizeView Policy="@PolicyNames.PermanentAccount" Context="personalAccount">
                <Authorized>
                    <p><a class="btn btn-primary" href="contests/@Id/problems" target="@(_standing is not null ? "_blank" : null)" rel="noopener">@SiteResources.GoToTrainingProblems</a></p>
                </Authorized>
                <NotAuthorized>
                    <p>@SiteResources.TrainingPersonalAccountRequired</p>
                </NotAuthorized>
            </AuthorizeView>
        </Authorized>
        <NotAuthorized>
            <p>@SiteResources.TrainingRegistrationHelp</p>
        </NotAuthorized>
    </AuthorizeView>
    @if (_error is not null)
    {
        <p class="alert alert-danger" role="alert">@_error</p>
    }
    @if (_standing is null)
    {
        <AuthorizeView Policy="@PolicyNames.PermanentAccount" Context="startAccount">
            <Authorized>
                <EditForm Model="Input" FormName="virtual-contest" OnValidSubmit="ShowStanding" class="mb-4">
                    <DataAnnotationsValidator />
                    <div class="row g-3 align-items-end">
                        <div class="col-sm-8 col-md-5">
                            <label for="virtual-start" class="form-label">@SiteResources.ContestStart</label>
                            <InputDate id="virtual-start" Type="InputDateType.DateTimeLocal" step="60" class="form-control" @bind-Value="Input!.StartDate" ParsingErrorMessage="@SiteResources.InvalidDate" />
                            <ValidationMessage For="() => Input!.StartDate" />
                        </div>
                        <div class="col-sm-auto"><button class="btn btn-primary">@SiteResources.ShowVirtualStanding</button></div>
                    </div>
                    <p class="form-text">@string.Format(SiteResources.VirtualTimeZone, TimeZoneInfo.Local.Id)</p>
                </EditForm>
            </Authorized>
        </AuthorizeView>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-3">@SiteResources.ContestStart</dt>
            <dd class="col-sm-9"><time datetime="@_start.ToString("O", CultureInfo.InvariantCulture)">@_start.ToLocalTime().ToString("g") @_start.ToLocalTime().ToString("zzz")</time></dd>
            <dt class="col-sm-3">@SiteResources.ContestEnd</dt>
            <dd class="col-sm-9"><time datetime="@_end.ToString("O", CultureInfo.InvariantCulture)">@_end.ToLocalTime().ToString("g") @_end.ToLocalTime().ToString("zzz")</time></dd>
        </dl>
        <div class="d-flex flex-wrap align-items-start gap-3">
            <AuthorizeView Policy="@PolicyNames.PermanentAccount" Context="startAccount">
                <Authorized>
                    <a class="btn btn-outline-secondary mb-3" href="@QueryHelpers.AddQueryString(Navigation.Uri, "edit", "true")">@SiteResources.ChangeVirtualStart</a>
                </Authorized>
            </AuthorizeView>
            <StandingControls BaseUrl="@Navigation.GetUriWithQueryParameter("highlight", (string?)null)"
                              Highlight="Highlight" CanHighlight="@(_relatedUserIds.Count > 0)"
                              IsCoach="@StandingHighlights.IsCoach(_standing.Results.Select(row => row.User), HttpContext.User)" />
        </div>
        <StandingTable Standing="_standing" HighlightedUserIds="@(Highlight ? _relatedUserIds : null)" />
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "start")] public string? Start { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] public bool Edit { get; set; }
    [SupplyParameterFromQuery] public bool Highlight { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private HashSet<int> _relatedUserIds = [];
    [SupplyParameterFromForm(FormName = "virtual-contest")] private InputModel? Input { get; set; }
    private Contest? _contest;
    private Olymp.Domain.Standing? _standing;
    private DateTimeOffset _start, _end;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        var now = DateTime.Now;
        bool initializeInput = Input is null;
        Input ??= new() { StartDate = new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0) };
        _standing = null;
        _relatedUserIds = [];
        _error = null;
        await using var db = await ContextFactory.CreateDbContextAsync();
        _contest = await db.Contests.AsNoTracking().SingleOrDefaultAsync(item => item.Id == Id && !item.IsHidden && item.IsOpen);
        if (_contest is null || !_contest.AllowShowStanding)
        {
            _contest = null;
            Navigation.NotFound();
            return;
        }
        if (Start is null) return;
        if (!DateTimeOffset.TryParseExact(Start, ["O", "yyyy-MM-dd'T'HH:mm:sszzz", "yyyy-MM-dd'T'HH:mm:ss'Z'"],
            CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out _start) || !TryGetEnd(_start, out _end))
        {
            _error = SiteResources.InvalidDate;
            return;
        }
        if (Edit)
        {
            if (initializeInput) Input.StartDate = _start.LocalDateTime;
            return;
        }

        _contest = await StandingQuery.LoadAsync(db, Id, HttpContext.RequestAborted);
        _standing = Olymp.Domain.Standing.Create(_contest, includeAll: true, official: false, notFreeze: true, startTime: _start);
        _relatedUserIds = StandingHighlights.GetUserIds(_standing.Results.Select(row => row.User), HttpContext.User);
    }

    private void ShowStanding()
    {
        if (Input!.StartDate is not DateTime date || TimeZoneInfo.Local.IsInvalidTime(date))
        {
            _error = SiteResources.InvalidDate;
            return;
        }
        var start = new DateTimeOffset(date, TimeZoneInfo.Local.GetUtcOffset(date));
        if (!TryGetEnd(start, out _))
        {
            _error = SiteResources.InvalidDate;
            return;
        }
        string url = QueryHelpers.AddQueryString($"contests/{Id}/virtual", "start", start.ToString("O", CultureInfo.InvariantCulture));
        Navigation.NavigateTo(Highlight ? QueryHelpers.AddQueryString(url, "highlight", "true") : url);
    }

    private bool TryGetEnd(DateTimeOffset start, out DateTimeOffset end)
    {
        try { end = start + _contest!.Duration; return true; }
        catch (ArgumentOutOfRangeException) { end = default; return false; }
    }

    public sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(SiteResources), ErrorMessageResourceName = nameof(SiteResources.InvalidDate))]
        public DateTime? StartDate { get; set; }
    }
}
