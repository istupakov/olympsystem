@page "/contests/{Id:int}/registration"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@using Olymp.WebApp.Services
@using Olymp.WebApp.Services.Contests
@using Olymp.WebApp.Components.Contests

@attribute [Authorize(Policy = PolicyNames.OlympUser)]
@attribute [ExcludeFromInteractiveRouting]

@inject OlympContext Context
@inject CompetitorManagementService Competitors
@inject TimeProvider Clock
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation
@inject UserManager<User> Users

@if (contest is not null && user is not null)
{
    <PageTitle>@string.Format(SiteResources.RegistrationForContest, contest.Name)</PageTitle>
    <ContestHeader Contest="contest" ActiveSection="registration" />
    @if (IsClosed)
    {
        <p class="alert alert-info" role="status">@SiteResources.RegistrationClosed</p>
    }

    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (participant is not null)
    {
        <p>@SiteResources.AlreadyRegistered</p>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="fw-semibold">@participant.Name</span>
            <CompetitorBadges User="participant" />
        </div>
    }
    else if (!IsClosed && missingFields.Count == 0)
    {
        <div class="form-floating mb-3">
            <input id="participant-name" class="form-control" value="@CompetitorManagementService.GetParticipantName(user)" placeholder="@SiteResources.Competitor" disabled />
            <label for="participant-name">@SiteResources.Competitor</label>
        </div>
    }

    @if (participant is not null)
    {
        @if (participant.IsOutOfCompetition)
        {
            @if (!string.IsNullOrEmpty(participant.UserName) && !string.IsNullOrEmpty(participant.PasswordHash))
            {
                <p>@SiteResources.ParticipantAccountSignIn</p>
                <dl class="row">
                    <dt class="col-sm-3">@AccountResources.UserName</dt>
                    <dd class="col-sm-9 text-break">@participant.UserName</dd>
                    <dt class="col-sm-3">@AccountResources.Password</dt>
                    <dd class="col-sm-9 text-break">@participant.PasswordHash</dd>
                </dl>
            }
            else
            {
                <p class="text-body-secondary">@SiteResources.ParticipantAccountNotIssued</p>
            }
        }
        @if (canCancel)
        {
            <form method="post" @formname="cancel-registration" @onsubmit="CancelAsync">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-outline-danger">@SiteResources.CancelRegistration</button>
            </form>
        }
    }
    else if (!IsClosed)
    {
        @if (missingFields.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <p>@SiteResources.RegistrationProfileRequired</p>
                <ul class="mb-0">
                    @foreach (var field in missingFields)
                    {
                        <li>@field</li>
                    }
                </ul>
            </div>
        }
        <p><a href="account/manage">@SiteResources.EditProfile</a></p>

        <EditForm Model="Input" method="post" FormName="contest-registration" OnValidSubmit="RegisterAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="Input.OutOfCompetition" id="Input.OutOfCompetition" class="form-check-input" disabled="@(!HasGroup)" />
                <label for="Input.OutOfCompetition" class="form-check-label">
                    <DisplayName For="() => Input.OutOfCompetition" />
                    @if (!HasGroup)
                    {
                        <span>@($" ({SiteResources.RegistrationGroupRequired})")</span>
                    }
                </label>
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="Input.AcceptRules" id="Input.AcceptRules" class="form-check-input" aria-required="true" />
                <label for="Input.AcceptRules" class="form-check-label">
                    @AccountResources.AcceptRulesPrefix <a href="contests/@Id/rules" target="_blank" rel="noopener">@SiteResources.ContestRulesAgreement</a>
                </label>
                <ValidationMessage For="() => Input.AcceptRules" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@(missingFields.Count > 0)">@AccountResources.Register</button>
        </EditForm>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "contest-registration")]
    private InputModel Input { get; set; } = default!;

    private Contest? contest;
    private OlympUser? user;
    private Competitor? participant;
    private bool canCancel;
    private readonly List<string> missingFields = [];
    private string? error;

    private bool HasGroup => !string.IsNullOrWhiteSpace(user?.Details);
    private bool IsClosed => contest is not null && Clock.GetUtcNow() >= contest.EndTime;

    protected override async Task OnParametersSetAsync()
    {
        Input ??= new();
        contest = await Context.Contests.AsNoTracking()
            .SingleOrDefaultAsync(item => item.Id == Id && !item.IsHidden, HttpContext.RequestAborted);
        if (contest is null || contest.IsAcm)
        {
            contest = null;
            Navigation.NotFound();
            return;
        }

        int userId = int.Parse(Users.GetUserId(HttpContext.User)!);
        user = await Context.OlympUsers.AsNoTracking().Include(item => item.Organization)
            .SingleAsync(item => item.Id == userId, HttpContext.RequestAborted);
        participant = await Context.Competitors.AsNoTracking().Include(item => item.Contest).Include(item => item.Members)
            .SingleOrDefaultAsync(item => item.ContestId == Id && item.Members.Any(member => member.Id == userId), HttpContext.RequestAborted);
        canCancel = !IsClosed && participant is not null
            && (await Authorization.AuthorizeAsync(HttpContext.User, participant, PolicyNames.CancelRegistration)).Succeeded;

        missingFields.Clear();
        if (string.IsNullOrWhiteSpace(user.FirstName))
            missingFields.Add(AccountResources.FirstName);
        if (string.IsNullOrWhiteSpace(user.LastName))
            missingFields.Add(AccountResources.LastName);
        if (string.IsNullOrWhiteSpace(user.Organization?.Name))
            missingFields.Add(AccountResources.University);

        if (!HasGroup)
            Input.OutOfCompetition = true;
    }

    private async Task RegisterAsync()
    {
        if (contest is null || user is null || IsClosed)
            return;
        if (missingFields.Count > 0)
        {
            error = SiteResources.RegistrationUpdateFailed;
            return;
        }

        try
        {
            await Competitors.RegisterIndividualAsync(Id, user.Id, Input.OutOfCompetition, HttpContext.RequestAborted);
        }
        catch (OperationValidationException)
        {
            error = SiteResources.RegistrationUpdateFailed;
            return;
        }
        catch (IdentityOperationException exception)
        {
            error = string.Join(" ", exception.Errors.Select(item => item.Description));
            return;
        }

        Navigation.Refresh();
    }

    private async Task CancelAsync()
    {
        if (contest is null || participant is null || IsClosed)
            return;
        try
        {
            await Competitors.CancelRegistrationAsync(HttpContext.User, Id, participant.Id, HttpContext.RequestAborted);
        }
        catch (OperationValidationException)
        {
            error = SiteResources.RegistrationUpdateFailed;
            return;
        }
        catch (IdentityOperationException exception)
        {
            error = string.Join(" ", exception.Errors.Select(item => item.Description));
            return;
        }

        Navigation.Refresh();
    }

    private sealed class InputModel
    {
        [Display(Name = nameof(SiteResources.ParticipateOutOfCompetition), ResourceType = typeof(SiteResources))]
        public bool OutOfCompetition { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessageResourceName = nameof(SiteResources.ContestRulesRequired), ErrorMessageResourceType = typeof(SiteResources))]
        public bool AcceptRules { get; set; }
    }
}
