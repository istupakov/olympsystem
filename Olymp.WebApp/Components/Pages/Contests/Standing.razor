@page "/contests/{Id:int}/standing"

@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@using Olymp.WebApp.Components.Contests
@inject NavigationManager Navigation
@inject IDbContextFactory<OlympContext> ContextFactory

@if (contest is not null)
{
    <PageTitle>@string.Format(SiteResources.ResultsForContest, contest.Name)</PageTitle>
    <ContestHeader Contest="contest" ActiveSection="standing" />
    @if (contest.IsOpen && !string.IsNullOrWhiteSpace(contest.Description))
    {
        <div class="contest-description mb-4 overflow-auto">@((MarkupString)contest.Description)</div>
    }
    <StandingControls BaseUrl="@($"contests/{Id}/standing")" Official="Official" HasOfficialStanding="HasOfficialStanding" />
    @if (savedTable is not null)
    {
        <SavedStandingView Html="@savedTable" />
    }
    else if (standing is not null)
    {
        <StandingTable Standing="standing" />
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery]
    public bool Official { get; set; }

    private Contest? contest;
    private Olymp.Domain.Standing? standing;
    private string? savedTable;

    private bool HasOfficialStanding => contest is not null && (contest.FinalTableId is null || contest.OfficialTableId is not null);

    protected override async Task OnParametersSetAsync()
    {
        savedTable = null;
        standing = null;
        await using var context = await ContextFactory.CreateDbContextAsync();
        contest = await context.Contests.AsNoTracking().SingleOrDefaultAsync(item => item.Id == Id && !item.IsHidden);
        if (contest is null || !contest.AllowShowStanding || (Official && !HasOfficialStanding))
        {
            contest = null;
            Navigation.NotFound();
            return;
        }

        var tableId = Official ? contest.OfficialTableId : contest.FinalTableId;
        if (tableId is not null)
        {
            var data = await context.Blobs.Where(blob => blob.Id == tableId).Select(blob => blob.Data).SingleAsync();
            savedTable = System.Text.CodePagesEncodingProvider.Instance.GetEncoding(1251)!.GetString(data);
            return;
        }

        contest = await context.Contests.AsNoTrackingWithIdentityResolution()
            .Include(item => item.Competitors).ThenInclude(item => item.Members)
            .Include(item => item.Problems).ThenInclude(item => item.Submissions).ThenInclude(item => item.User)
            .AsSplitQuery()
            .SingleAsync(item => item.Id == Id);
        standing = Olymp.Domain.Standing.Create(contest, includeAll: !Official, official: Official, notFreeze: false, startTime: null);
    }
}
