@page "/contests/{ContestId:int}/problems"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@using Olymp.Domain.Models
@using Olymp.WebApp.Components.Contests
@using Olymp.WebApp.Components.Problems
@using Olymp.WebApp.Components.Submissions

@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject NavigationManager Navigation
@inject IDbContextFactory<OlympContext> ContextFactory
@inject IAuthorizationService Authorization

@if (contest is not null)
{
    <PageTitle>@(ProblemId.HasValue && selected is not null
        ? $"{selected.NameWithNumber} – {contest.Name}"
        : string.Format(SiteResources.ProblemsForContest, contest.Name))</PageTitle>
    <ContestHeader Contest="contest" ActiveSection="problems" />
    @if (selected is not null)
    {
        <ProblemWorkspace Problems="problems" Selected="selected" ProblemUrl="ProblemUrl" Scope="@Scope">
            @if (canSubmit)
            {
                <p><a href="@ProblemUrl(selected.Id)#submit-heading">@SiteResources.JumpToSubmission</a></p>
            }
            <ProblemStatementView Problem="selected" Examples="examples" />
            @if (canSubmit)
            {
                <SubmitSolutionForm Problem="selected" Action="@FormUrl" />
            }
            else
            {
                <p class="text-body-secondary">@SiteResources.SubmissionNotAllowed</p>
            }
            <SubmissionList ContestId="ContestId" ProblemId="selected.Id" Scope="@Scope" Page="@(SubmissionPage ?? 1)" />
        </ProblemWorkspace>
    }
    else
    {
        <p>@SiteResources.NoProblemsFound</p>
    }
}

@code {
    [Parameter]
    public int ContestId { get; set; }

    [SupplyParameterFromQuery]
    public int? ProblemId { get; set; }

    [SupplyParameterFromQuery]
    public string? Scope { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? SubmissionPage { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private Contest? contest;
    private IReadOnlyList<Problem> problems = [];
    private Problem? selected;
    private IReadOnlyList<Test> examples = [];
    private bool canSubmit;

    private string ProblemUrl(int problemId)
    {
        string url = $"contests/{ContestId}/problems?problemId={problemId}";
        return string.IsNullOrEmpty(Scope) ? url : QueryHelpers.AddQueryString(url, "scope", Scope);
    }

    private string FormUrl => SubmissionPage is null or 1 ? ProblemUrl(selected!.Id)
        : QueryHelpers.AddQueryString(ProblemUrl(selected!.Id), "page", SubmissionPage.Value.ToString(CultureInfo.InvariantCulture));

    protected override async Task OnParametersSetAsync()
    {
        var token = HttpContext.RequestAborted;
        await using var context = await ContextFactory.CreateDbContextAsync(token);
        contest = await context.Contests.AsNoTracking()
            .Where(item => item.Id == ContestId && !item.IsHidden)
            .Include(item => item.Problems.Where(problem => problem.IsActive))
            .SingleOrDefaultAsync(token);
        if (contest is null || !contest.AllowShowProblems)
        {
            contest = null;
            Navigation.NotFound();
            return;
        }

        problems = contest.Problems.OrderBy(problem => problem.Number).ThenBy(problem => problem.Id).ToList();
        selected = ProblemId.HasValue
            ? problems.SingleOrDefault(problem => problem.Id == ProblemId.Value)
            : problems.FirstOrDefault();
        if (selected is null)
        {
            if (ProblemId.HasValue)
            {
                contest = null;
                Navigation.NotFound();
            }
            return;
        }

        examples = await context.Tests.AsNoTracking()
            .Where(test => test.ProblemId == selected.Id && test.IsOpen && test.IsActive)
            .OrderBy(test => test.Number)
            .ToListAsync(token);

        canSubmit = (await Authorization.AuthorizeAsync(HttpContext.User, selected,
            new SubmitSolutionRequirement())).Succeeded;
    }
}
