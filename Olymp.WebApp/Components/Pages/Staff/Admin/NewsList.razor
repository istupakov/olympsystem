@page "/admin/news"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<OlympContext> ContextFactory

<PageTitle>@SiteResources.AdminSection – @SiteResources.News</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="mb-0">@SiteResources.News</h1>
    <a class="btn btn-primary" href="admin/news/new">@SiteResources.CreateNews</a>
</div>

@if (news is null)
{
    <p role="status">@SiteResources.StaffLoading</p>
}
else
{
    <div class="list-group">
        @foreach (var item in news)
        {
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="text-break">
                    <div class="fw-semibold">@item.Title</div>
                    <time class="small text-body-secondary" datetime="@item.PublicationDate.ToString("O", CultureInfo.InvariantCulture)">@item.PublicationDate.LocalDateTime.ToString("g")</time>
                </div>
                <a class="btn btn-outline-primary btn-sm" href="admin/news/@item.Id/edit">@SiteResources.StaffEdit</a>
            </div>
        }
    </div>
    @if (news.Count == 0)
    {
        <p>@SiteResources.NoNews</p>
    }
}

@code {
    private List<News>? news;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await ContextFactory.CreateDbContextAsync();
        news = await context.News.AsNoTracking().OrderByDescending(item => item.PublicationDate)
            .ThenByDescending(item => item.Id).ToListAsync();
    }
}
