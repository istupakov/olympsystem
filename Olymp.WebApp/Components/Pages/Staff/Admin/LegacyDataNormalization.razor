@page "/admin/normalization"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Olymp.WebApp.Services.Administration
@using Olymp.WebApp.Services
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<LegacyDataNormalization> Logger

<PageTitle>@SiteResources.StaffNormalization</PageTitle>
<h1 class="mb-4">@SiteResources.StaffNormalization</h1>
<p>@SiteResources.StaffNormalizationIntroduction</p>
@if (_error is not null) { <p class="alert alert-danger" role="alert">@_error</p> }
@if (_applied is not null) { <p class="alert alert-success" role="status">@string.Format(SiteResources.StaffNormalizationApplied, _applied)</p> }
@if (_preview is not null)
{
    <p role="status">@string.Format(SiteResources.StaffNormalizationCount, ChangeCount)</p>
    @if (_preview.UnrecognizedCompilers > 0 || _preview.UnrecognizedPairs > 0)
    {
        <p class="alert alert-warning" role="alert">@string.Format(SiteResources.StaffNormalizationUnrecognized, _preview.UnrecognizedCompilers, _preview.UnrecognizedPairs)</p>
        <section class="card mb-4">
            <h2 class="card-header h5">@SiteResources.StaffNormalizationSkipped</h2>
            <div class="card-body table-responsive">
                <table class="table table-striped table-bordered text-nowrap align-middle">
                    <thead><tr><th scope="col">@SiteResources.StaffNormalizationOperation</th><th scope="col">ID</th><th scope="col">@SiteResources.StaffName</th><th scope="col">@SiteResources.StaffNormalizationField</th><th scope="col">@SiteResources.StaffExpected</th><th scope="col">@SiteResources.StaffActual</th></tr></thead>
                    <tbody>
                        @foreach (var skipped in _preview.Skipped)
                        {
                            <tr>
                                <td>
                                    @if (skipped.MergeSourceId is not null)
                                    {
                                        @SiteResources.StaffNormalizationMerges <text> · @skipped.MergeSourceId → @skipped.MergeDestinationId</text>
                                    }
                                    else { @SiteResources.StaffNormalizationRename }
                                </td>
                                <td>@skipped.Id</td><td>@skipped.Name</td><td>@skipped.Field</td><td><span class="text-nowrap">@(skipped.Expected ?? "–")</span></td><td><span class="text-nowrap">@(skipped.Actual ?? "–")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    <section class="card mb-4">
        <h2 class="card-header h5">@SiteResources.ContestParticipants</h2>
        <div class="card-body">
            <p>@SiteResources.StaffNormalizationParticipants</p>
            <p role="status">@string.Format(SiteResources.StaffNormalizationCount, _preview.Participants.Length)</p>
            @if (_preview.Participants.Length > 0)
            {
                <p class="alert @(_preview.StandingOrderChanges ? "alert-warning" : "alert-info")" role="status">
                    @(_preview.StandingOrderChanges ? SiteResources.StaffNormalizationOrderChanged : SiteResources.StaffNormalizationOrderPreserved)
                </p>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-nowrap align-middle">
                        <thead><tr><th scope="col">ID</th><th scope="col">@SiteResources.StaffContest</th><th scope="col">@SiteResources.StaffNormalizationBefore</th><th scope="col">@SiteResources.StaffNormalizationAfter</th></tr></thead>
                        <tbody>
                            @foreach (var change in _preview.Participants)
                            {
                                <tr><td>@change.Id</td><td>@change.Context</td><td>@change.Before</td><td>@change.After</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    <section class="card mb-4">
        <h2 class="card-header h5">@SiteResources.StaffCompilers</h2>
        <div class="card-body">
            <p>@SiteResources.StaffNormalizationCompilers</p>
            <p role="status">@string.Format(SiteResources.StaffNormalizationCount, _preview.Compilers.Length)</p>
            @if (_preview.Compilers.Length > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-nowrap align-middle">
                        <thead><tr><th scope="col">ID</th><th scope="col">@SiteResources.StaffNormalizationBefore</th><th scope="col">@SiteResources.StaffNormalizationAfter</th><th scope="col">@SiteResources.StaffNormalizationDescriptionBefore</th><th scope="col">@SiteResources.StaffNormalizationDescriptionAfter</th><th scope="col">@SiteResources.StaffConfiguration</th><th scope="col">@SiteResources.StaffCommandLine</th></tr></thead>
                        <tbody>
                            @foreach (var change in _preview.Compilers)
                            {
                                <tr><td>@change.Id</td><td>@change.Before</td><td>@change.After</td><td>@(change.DescriptionBefore ?? "–")</td><td>@change.DescriptionAfter</td><td><code>@change.Configuration</code></td><td><code class="text-nowrap">@change.Command</code></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    <section class="card mb-4">
        <h2 class="card-header h5">@SiteResources.StaffNormalizationMerges</h2>
        <div class="card-body">
            <p>@SiteResources.StaffNormalizationMergeDescription</p>
            <p role="status">@string.Format(SiteResources.StaffNormalizationCount, _preview.Merges.Length)</p>
            @if (_preview.Merges.Length > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-nowrap align-middle">
                        <thead><tr><th scope="col">@SiteResources.StaffNormalizationRemove</th><th scope="col">@SiteResources.StaffNormalizationKeep</th><th scope="col">@SiteResources.StaffNormalizationMoveSubmissions</th><th scope="col">@SiteResources.StaffConfiguration</th><th scope="col">@SiteResources.StaffCommandLine</th></tr></thead>
                        <tbody>
                            @foreach (var merge in _preview.Merges)
                            {
                                <tr>
                                    <td><div>@merge.Source.Id · @merge.Source.Name</div><small class="text-body-secondary">@(merge.Source.Description ?? "–")</small></td>
                                    <td><div>@merge.Destination.Id · @merge.Destination.Name</div><small class="text-body-secondary">@merge.Destination.Description</small></td>
                                    <td>@merge.SubmissionIds.Length</td>
                                    <td><code>@merge.Source.Configuration</code></td>
                                    <td><code class="text-nowrap">@merge.Source.Command</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    <section class="card mb-4">
        <h2 class="card-header h5">@SiteResources.StaffNormalizationEmptyCompilers</h2>
        <div class="card-body">
            <p>@SiteResources.StaffNormalizationEmptyDescription</p>
            <p role="status">@string.Format(SiteResources.StaffNormalizationCount, _preview.EmptyCompilers.Length)</p>
            @if (_preview.EmptyCompilers.Length > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-nowrap align-middle">
                        <thead><tr><th scope="col">ID</th><th scope="col">@SiteResources.StaffNormalizationBefore</th><th scope="col">@SiteResources.StaffDescription</th><th scope="col">@SiteResources.StaffConfiguration</th><th scope="col">@SiteResources.StaffCommandLine</th></tr></thead>
                        <tbody>
                            @foreach (var compiler in _preview.EmptyCompilers)
                            {
                                <tr><td>@compiler.Id</td><td>@compiler.Name</td><td>@(compiler.Description ?? "–")</td><td><code>@compiler.Configuration</code></td><td><code class="text-nowrap">@compiler.Command</code></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    @if (ChangeCount > 0)
    {
        @if (_confirm)
        {
            <div class="alert alert-warning" role="alert">
                <p>@string.Format(SiteResources.StaffNormalizationConfirm, _preview.Participants.Length, _preview.Compilers.Length, _preview.Merges.Length, _preview.Merges.Sum(item => item.SubmissionIds.Length), _preview.EmptyCompilers.Length)</p>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-danger" type="button" disabled="@_busy" @onclick="ApplyAsync">@SiteResources.StaffNormalizationApply</button>
                    <button class="btn btn-outline-secondary" type="button" disabled="@_busy" @onclick="() => _confirm = false">@SiteResources.StaffCancel</button>
                </div>
            </div>
        }
        else
        {
            <button class="btn btn-outline-danger me-2" type="button" disabled="@_busy" @onclick="() => _confirm = true">@SiteResources.StaffNormalizationApply</button>
        }
    }
}
<button class="btn btn-outline-secondary" type="button" disabled="@_busy" @onclick="PrepareAsync">@(_preview is null ? SiteResources.StaffPreview : SiteResources.StaffNormalizationRefresh)</button>
@if (_busy) { <span class="ms-2" role="status">@SiteResources.StaffLoading</span> }

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    private LegacyDataNormalizationService.Preview? _preview;
    private int ChangeCount => _preview is null ? 0 : _preview.Participants.Length + _preview.Compilers.Length + _preview.Merges.Length + _preview.EmptyCompilers.Length;
    private int? _applied;
    private bool _busy;
    private bool _confirm;
    private string? _error;

    private Task PrepareAsync() => RunAsync(async service =>
    {
        _applied = null;
        _confirm = false;
        _preview = await service.PrepareAsync((await AuthenticationState).User);
    });

    private Task ApplyAsync() => RunAsync(async service =>
    {
        if (!_confirm || _preview is null) return;
        _applied = await service.ApplyAsync((await AuthenticationState).User, _preview);
        _preview = null;
        _confirm = false;
    });

    private async Task RunAsync(Func<LegacyDataNormalizationService, Task> action)
    {
        if (_busy) return;
        _busy = true;
        _error = null;

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            await action(scope.ServiceProvider.GetRequiredService<LegacyDataNormalizationService>());
        }
        catch (UnauthorizedAccessException) { _error = SiteResources.StaffAccessDenied; }
        catch (OperationValidationException exception)
        {
            _error = exception.Message;
            _preview = null;
            _confirm = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to normalize legacy data");
            _error = SiteResources.StaffSaveFailed;
            _preview = null;
            _confirm = false;
        }
        finally { _busy = false; }
    }
}
