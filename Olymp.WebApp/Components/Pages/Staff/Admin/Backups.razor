@page "/admin/backups"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using Olymp.WebApp.Services.DatabaseMaintenance
@inject DatabaseBackupService BackupsService
@inject ILogger<Backups> Logger

<StaffPageTitle Title="@SiteResources.BackupTitle" />
<h1>@SiteResources.BackupTitle</h1>
@if (_restored)
{
    <p class="alert alert-success" role="status">@SiteResources.BackupRestored</p>
    <form method="post" action="Account/Logout" data-enhance="false">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="Account/Login?ReturnUrl=%2Fadmin%2Fbackups" />
        <button class="btn btn-primary">@SiteResources.BackupSignInAgain</button>
    </form>
}
else
{
@if (_error is not null || _succeeded)
{
    <div class="alert @(_error is not null ? "alert-danger" : "alert-success") alert-dismissible" role="@(_error is not null ? "alert" : "status")">
        @(_error ?? SiteResources.BackupSucceeded)
        <button type="button" class="btn-close" aria-label="@SiteResources.Dismiss" @onclick="ClearNotification"></button>
    </div>
}
@if (_busy || BackupsService.State.Running)
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>@(_activity ?? SiteResources.BackupBusy)</span>
    </div>
}
<section class="mb-4">
    <h2>@SiteResources.BackupDatabase</h2>
    <p>@SiteResources.BackupDescription</p>
    @if (_snapshot is not null)
    {
        <p>@string.Format(SiteResources.BackupDisk, GiB(_snapshot.Free), GiB(_snapshot.Total), GiB(_snapshot.Files.Sum(item => item.Size)))</p>
    }
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-primary" disabled="@(_busy || BackupsService.State.Running || _snapshot is null)" @onclick="() => CreateAsync(false)">@SiteResources.BackupFull</button>
        <button class="btn btn-outline-primary" disabled="@(_busy || BackupsService.State.Running || _snapshot?.CanCreateDifferential != true)" @onclick="() => CreateAsync(true)">@SiteResources.BackupDiff</button>
        <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="RefreshAsync">@SiteResources.BackupRefresh</button>
    </div>
    @if (_snapshot is { CanCreateDifferential: false })
    {
        <p class="text-body-secondary">@SiteResources.BackupNeedsFull</p>
    }
    @if (_deletion is not null)
    {
        <div class="alert alert-warning" role="alert">
            <p>@string.Format(SiteResources.BackupDeleteConfirm, MiB(_deletion.Sum(item => item.Size)))</p>
            <ul>@foreach (var file in _deletion) { <li class="text-break">@file.Name</li> }</ul>
            <button class="btn btn-danger me-2" disabled="@(_busy || BackupsService.State.Running)" @onclick="DeleteAsync">@SiteResources.StaffConfirm</button>
            <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="() => _deletion = null">@SiteResources.StaffCancel</button>
        </div>
    }
    @if (_restoration is not null)
    {
        <div class="alert alert-warning" role="alert">
            <p>@SiteResources.BackupRestoreConfirm</p>
            <ul>@foreach (var file in _restoration) { <li class="text-break">@file.Name</li> }</ul>
            <button class="btn btn-danger me-2" disabled="@(_busy || BackupsService.State.Running)" @onclick="RestoreAsync">@SiteResources.StaffConfirm</button>
            <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="() => _restoration = null">@SiteResources.StaffCancel</button>
        </div>
    }
    @if (_snapshot is not null)
    {
        @if (_snapshot.Files.Length == 0) { <p>@SiteResources.BackupEmpty</p> }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>@SiteResources.BackupFile</th><th>@SiteResources.BackupType</th><th>@SiteResources.BackupDate</th><th>@SiteResources.BackupSize</th><th>@SiteResources.BackupBase</th><th>@SiteResources.StaffActions</th></tr></thead>
                    <tbody>
                        @foreach (var file in _snapshot.Files)
                        {
                            var full = file.Differential ? _snapshot.Files.FirstOrDefault(item => item.Id == file.BaseId && item.Readable && !item.Differential && !item.CopyOnly) : null;
                            <tr @key="file.Name">
                                <td class="text-break">@file.Name</td>
                                <td>@(!file.Readable ? SiteResources.BackupUnreadable : file.Differential ? SiteResources.BackupDiffType : file.CopyOnly ? SiteResources.BackupCopyType : SiteResources.BackupFullType)</td>
                                <td>@file.Created?.ToString("g")</td><td>@MiB(file.Size).ToString("N2")</td>
                                <td class="text-break">@(file.Differential ? full?.Name ?? SiteResources.BackupMissingBase : null)</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (file.Readable && !BackupsService.State.Running)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@($"admin/backups/{Uri.EscapeDataString(file.Name)}/download?single=true")" data-enhance-nav="false" @onclick="ClearNotification">@SiteResources.BackupDownload</a>
                                            @if (file.Differential && full is not null)
                                            {
                                                <a class="btn btn-sm btn-outline-primary" href="@($"admin/backups/{Uri.EscapeDataString(file.Name)}/download")" data-enhance-nav="false" @onclick="ClearNotification">@SiteResources.BackupDownloadBundle</a>
                                            }
                                        }
                                        <button class="btn btn-sm btn-outline-danger" disabled="@(_busy || BackupsService.State.Running)" @onclick="() => PreviewAsync(file.Name)">@SiteResources.StaffDelete</button>
                                        @if (BackupsService.CanRestore && file.Readable && (!file.Differential || full is not null))
                                        {
                                            <button class="btn btn-sm btn-outline-warning" disabled="@(_busy || BackupsService.State.Running)" @onclick="() => PreviewRestoreAsync(file.Name)">@SiteResources.BackupRestore</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>
<section>
    <h2>@SiteResources.StaffExportAllContests</h2>
    <p>@SiteResources.BackupExportDescription</p>
    <ContestExportForm DownloadUrl="admin/contests/export" />
    <a class="btn btn-outline-primary" href="admin/contests/import">@SiteResources.MaterialImportTitle</a>
</section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    private DatabaseBackupService.Snapshot? _snapshot;
    private DatabaseBackupService.Backup[]? _deletion;
    private DatabaseBackupService.Backup[]? _restoration;
    private bool _restored;
    private string? _error;
    private bool _succeeded;
    private string? _activity;
    private bool _busy => _activity is not null;
    private readonly CancellationTokenSource _lifetime = new();

    protected override Task OnInitializedAsync() => RefreshAsync();
    private static double GiB(long size) => size / (1024d * 1024 * 1024);
    private static double MiB(long size) => size / (1024d * 1024);
    private Task RefreshAsync() => RunAsync(BackupsService.State.Running ? SiteResources.BackupBusy : SiteResources.BackupRefreshing, async token =>
    {
        _deletion = null;
        _restoration = null;
        await ReadSnapshotAsync(BackupsService.State.Running, token);
    });
    private Task CreateAsync(bool differential) => RunAsync(differential ? SiteResources.BackupCreatingDiff : SiteResources.BackupCreatingFull, async token =>
    {
        _deletion = null;
        _restoration = null;
        await BackupsService.StartAsync((await AuthenticationState).User, differential);
        await ReadSnapshotAsync(true, token);
    });
    private async Task ReadSnapshotAsync(bool waitForBackup, CancellationToken token)
    {
        if (waitForBackup)
            while (BackupsService.State.Running) await Task.Delay(500, token);
        _snapshot = await BackupsService.ReadAsync((await AuthenticationState).User, token);
        if (waitForBackup)
        {
            if (BackupsService.State.Failed) _error = SiteResources.BackupFailed;
            else _succeeded = true;
        }
    }
    private Task PreviewAsync(string name) => RunAsync(SiteResources.BackupRefreshing, async _ =>
    {
        _restoration = null;
        _deletion = await BackupsService.PreviewDeleteAsync((await AuthenticationState).User, name);
    });
    private Task PreviewRestoreAsync(string name) => RunAsync(SiteResources.BackupRefreshing, async token =>
    {
        _deletion = null;
        _restoration = await BackupsService.PreviewRestoreAsync((await AuthenticationState).User, name, token);
    });
    private Task RestoreAsync() => RunAsync(SiteResources.BackupRestoring, async token =>
    {
        if (_restoration is null) return;
        try
        {
            await BackupsService.RestoreAsync((await AuthenticationState).User, _restoration, token);
            _restoration = null;
            _restored = true;
        }
        catch (Exception exception) when (exception is not OperationCanceledException and not UnauthorizedAccessException and not Olymp.WebApp.Services.OperationValidationException)
        {
            Logger.LogError(exception, "Development database restore failed");
            _error = SiteResources.BackupRestoreFailed;
        }
    });
    private Task DeleteAsync() => RunAsync(SiteResources.BackupDeleting, async token =>
    {
        if (_deletion is null) return;
        await BackupsService.DeleteAsync((await AuthenticationState).User, _deletion);
        _deletion = null;
        _snapshot = await BackupsService.ReadAsync((await AuthenticationState).User, token);
    });
    private void ClearNotification()
    {
        _error = null;
        _succeeded = false;
    }
    private async Task RunAsync(string activity, Func<CancellationToken, Task> action)
    {
        if (_busy || _lifetime.IsCancellationRequested) return;
        var token = _lifetime.Token;
        _activity = activity;
        ClearNotification();
        try { await action(token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (UnauthorizedAccessException) { _snapshot = null; _deletion = null; _error = SiteResources.StaffAccessDenied; }
        catch (Olymp.WebApp.Services.OperationValidationException exception) { _error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Backup management operation failed");
            _error = SiteResources.BackupReadFailed;
        }
        finally { _activity = null; }
    }
    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        GC.SuppressFinalize(this);
    }
}
