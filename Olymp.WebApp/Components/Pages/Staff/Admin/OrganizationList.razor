@page "/admin/organizations"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject StaffGridState GridState

<PageTitle>@SiteResources.StaffOrganizations</PageTitle>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="mb-0">@SiteResources.StaffOrganizations</h1>
    <a class="btn btn-primary" href="@DetailUrl("admin/organizations/new")">@SiteResources.StaffCreateOrganization</a>
</div>
<EditForm Model="_filters" OnValidSubmit="ApplyFilters" class="row g-3 mb-4">
    <div class="col-12">
        <label for="organization-search" class="form-label">@SiteResources.StaffOrganizationSearch</label>
        <InputText id="organization-search" class="form-control" @bind-Value="_filters.Search" />
    </div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary">@SiteResources.StaffFind</button>
        <a class="btn btn-outline-secondary" href="admin/organizations">@SiteResources.StaffReset</a>
    </div>
</EditForm>
<div class="d-flex flex-wrap gap-2 mb-3"><ActiveFilter Name="Search" Label="@SiteResources.StaffOrganization" Value="@Search" /></div>
<StaffGrid @key="Search" TGridItem="Organization" Query="Query" ItemKey="@(item => item.Id)" OrderKey="@(item => item.Id)" EmptyText="@SiteResources.StaffNoOrganizations">
    <TemplateColumn Title="ID" SortBy="_idSort" Sortable="true" Context="item">
        <a href="@DetailUrl($"admin/organizations/{item.Id}/edit", item.Id)">@item.Id</a>
    </TemplateColumn>
    <TemplateColumn Title="@SiteResources.StaffOrganizationName" SortBy="_nameSort" Sortable="true" Context="item">
        <a href="@DetailUrl($"admin/organizations/{item.Id}/edit", item.Id)">@item.Name</a>
    </TemplateColumn>
    <PropertyColumn Property="@(item => item.FullName)" Title="@SiteResources.StaffOrganizationFullName" Sortable="true" />
    <PropertyColumn Property="@(item => item.ACMName)" Title="@SiteResources.StaffTeamPrefix" Sortable="true" />
</StaffGrid>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    private Filters _filters = new();
    private readonly GridSort<Organization> _idSort = GridSort<Organization>.ByAscending(item => item.Id);
    private readonly GridSort<Organization> _nameSort = GridSort<Organization>.ByAscending(item => item.Name).ThenAscending(item => item.Id);
    protected override void OnParametersSet() => _filters = new() { Search = Search };
    internal IQueryable<Organization> Query(OlympContext db)
    {
        var query = db.Organizations.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(Search))
        {
            string search = Search.Trim();
            query = query.Where(item => item.Name.Contains(search) || (item.FullName != null && item.FullName.Contains(search))
                || (item.ACMName != null && item.ACMName.Contains(search)));
        }
        return query.OrderBy(item => item.Name).ThenBy(item => item.Id);
    }
    private void ApplyFilters() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> {
        [nameof(Search)] = _filters.Search, ["page"] = null, ["row"] = null
    }));
    private string DetailUrl(string path, int? itemId = null) => GridState.DetailUrl(Navigation.Uri, path, itemId);
    private sealed class Filters { public string? Search { get; set; } }
}
