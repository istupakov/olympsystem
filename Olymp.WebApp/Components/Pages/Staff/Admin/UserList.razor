@page "/admin/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject StaffGridState GridState
@inject IDbContextFactory<OlympContext> ContextFactory

<PageTitle>@SiteResources.StaffUsers</PageTitle>
<h1 class="mb-4">@SiteResources.StaffUsers</h1>
@if (_relationName is not null)
{
    <p class="alert alert-info"><a href="@_relationUrl">@_relationName</a> · @RelationLabel</p>
}
<EditForm Model="_filters" OnValidSubmit="ApplyFilters" class="row g-3 mb-4">
    <div class="col-12">
        <label for="user-search" class="form-label">@SiteResources.StaffUserSearch</label>
        <InputText id="user-search" class="form-control" @bind-Value="_filters.Search" />
    </div>
    <div class="col-md-6 col-xl-3">
        <label for="user-type" class="form-label">@SiteResources.StaffAccountType</label>
        <InputSelect id="user-type" class="form-select" @bind-Value="_filters.AccountType">
            <option value="">@SiteResources.StaffAll</option>
            <option value="permanent">@SiteResources.StaffPermanentAccounts</option>
            <option value="participant">@SiteResources.ContestParticipants</option>
        </InputSelect>
    </div>
    <div class="col-md-6 col-xl-3">
        <label for="user-role" class="form-label">@SiteResources.StaffRoles</label>
        <InputSelect id="user-role" class="form-select" @bind-Value="_filters.Role">
            <option value="">@SiteResources.StaffAll</option>
            <option value="admin">@SiteResources.AdminSection</option>
            <option value="jury">@SiteResources.JurySection</option>
            <option value="coach">@SiteResources.StaffCoaches</option>
        </InputSelect>
    </div>
    <div class="col-md-6 col-xl-3">
        <label for="user-visibility" class="form-label">@SiteResources.StaffVisibility</label>
        <InputSelect id="user-visibility" class="form-select" @bind-Value="_filters.Visibility">
            <option value="">@SiteResources.StaffAll</option>
            <option value="hidden">@SiteResources.StaffHiddenAccounts</option>
            <option value="visible">@SiteResources.StaffVisibleAccounts</option>
        </InputSelect>
    </div>
    <div class="col-md-6 col-xl-3">
        <label for="user-organization" class="form-label">@SiteResources.StaffOrganization</label>
        <InputSelect id="user-organization" class="form-select" @bind-Value="_filters.Organization">
            <option value="">@SiteResources.StaffAll</option>
            @foreach (var organization in _organizations) { <option value="@organization.Id">@organization.Name</option> }
        </InputSelect>
    </div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary">@SiteResources.StaffFind</button>
        <a class="btn btn-outline-secondary" href="admin/users">@SiteResources.StaffReset</a>
    </div>
</EditForm>
<StaffGrid @key="Navigation.Uri" TGridItem="Row" Query="Query" ItemKey="@(item => item.Id)" OrderKey="@(item => item.Id)" EmptyText="@SiteResources.StaffNoUsers">
    <TemplateColumn Title="ID" SortBy="_idSort" Sortable="true" Context="item">
        <a href="@DetailUrl(item.Id)">@item.Id</a>
    </TemplateColumn>
    <TemplateColumn Title="@AccountResources.PublicName" SortBy="_nameSort" Sortable="true" Context="item">
        <a href="@DetailUrl(item.Id)">@item.Name</a>
        @if (item.ContestId is int contestId)
        {
            <div class="small"><a class="link-secondary" href="jury/contests/@contestId/participants">@item.ContestName</a></div>
        }
    </TemplateColumn>
    <PropertyColumn Property="@(item => item.Login)" Title="@SiteResources.StaffLogin" Sortable="true" />
    <PropertyColumn Property="@(item => item.Email)" Title="@SiteResources.StaffEmail" Sortable="true" />
    <TemplateColumn Title="@SiteResources.StaffAccountType" Context="item">@(item.Participant ? SiteResources.Competitor : SiteResources.StaffPermanentAccount)</TemplateColumn>
    <TemplateColumn Title="@SiteResources.StaffOrganization" SortBy="_organizationSort" Sortable="true" Context="item">
        @if (item.OrganizationId is int id) { <a href="@GridState.DetailUrl(Navigation.Uri, $"admin/organizations/{id}/edit", item.Id)">@item.OrganizationName</a> }
    </TemplateColumn>
    <TemplateColumn Title="@SiteResources.StaffRoles" Context="item">
        @if (item.Admin) { <span class="badge text-bg-secondary me-1">@SiteResources.AdminSection</span> }
        @if (item.Jury) { <span class="badge text-bg-secondary me-1">@SiteResources.JurySection</span> }
        @if (item.Coach) { <span class="badge text-bg-secondary">@SiteResources.StaffCoach</span> }
    </TemplateColumn>
    <TemplateColumn Title="@SiteResources.StaffStatus" Context="item">
        @if (item.Hidden) { <span class="badge text-bg-secondary me-1">@SiteResources.StaffHiddenAccount</span> }
        @if (item.Locked) { <span class="badge text-bg-danger">@SiteResources.StaffBanned</span> }
    </TemplateColumn>
</StaffGrid>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Group { get; set; }
    [SupplyParameterFromQuery] public string? AccountType { get; set; }
    [SupplyParameterFromQuery] public string? Role { get; set; }
    [SupplyParameterFromQuery] public string? Visibility { get; set; }
    [SupplyParameterFromQuery] public int? Organization { get; set; }
    [SupplyParameterFromQuery] public int? CoachOrganization { get; set; }
    [SupplyParameterFromQuery] public int? Coach { get; set; }
    [SupplyParameterFromQuery] public int? Member { get; set; }
    [SupplyParameterFromQuery] public int? Participant { get; set; }
    private Filters _filters = new();
    private List<Organization> _organizations = [];
    private string? _relationName;
    private string? _relationUrl;
    private readonly GridSort<Row> _idSort = GridSort<Row>.ByAscending(item => item.Id);
    private readonly GridSort<Row> _nameSort = GridSort<Row>.ByAscending(item => item.Name).ThenAscending(item => item.Id);
    private readonly GridSort<Row> _organizationSort = GridSort<Row>.ByAscending(item => item.OrganizationName).ThenAscending(item => item.Id);
    private string RelationLabel => CoachOrganization.HasValue ? SiteResources.StaffOrganizationCoaches
        : Coach.HasValue ? SiteResources.StaffCoachedAccounts : Member.HasValue ? SiteResources.StaffMemberships : SiteResources.StaffMembers;

    protected override async Task OnParametersSetAsync()
    {
        _filters = new() { Search = Search, AccountType = AccountType ?? (Group is "permanent" or "participant" ? Group : null),
            Role = Role ?? (Group is "admin" or "jury" or "coach" ? Group : null), Visibility = Visibility, Organization = Organization };
        await using var db = await ContextFactory.CreateDbContextAsync();
        _organizations = await db.Organizations.AsNoTracking().OrderBy(item => item.Name).ToListAsync();
        _relationName = null;
        _relationUrl = null;
        if (CoachOrganization is int organizationId)
        {
            _relationName = _organizations.SingleOrDefault(item => item.Id == organizationId)?.Name ?? $"ID {organizationId}";
            _relationUrl = $"admin/organizations/{organizationId}/edit";
        }
        else if ((Coach ?? Member ?? Participant) is int userId)
        {
            _relationName = await db.Users.Where(item => item.Id == userId).Select(item => item.Name).SingleOrDefaultAsync() ?? $"ID {userId}";
            _relationUrl = $"admin/users/{userId}/edit";
        }
    }

    internal IQueryable<Row> Query(OlympContext db)
    {
        var query = db.Users.AsNoTracking();
        string? accountType = AccountType ?? (Group is "permanent" or "participant" ? Group : null);
        string? selectedRole = Role ?? (Group is "admin" or "jury" or "coach" ? Group : null);
        if (!string.IsNullOrWhiteSpace(Search)) {
            string search = Search.Trim();
            bool hasId = int.TryParse(search, out int id);
            query = query.Where(item => (hasId && item.Id == id) || item.Name.Contains(search)
                || (item.UserName != null && item.UserName.Contains(search)) || (item.Email != null && item.Email.Contains(search)));
        }
        if (selectedRole is "admin" or "jury") {
            string role = selectedRole == "admin" ? RoleNames.Admin : RoleNames.Jury;
            query = query.Where(item => db.UserRoles.Any(link => link.UserId == item.Id && db.Roles.Any(value => value.Id == link.RoleId && value.Name == role)));
        } else if (selectedRole == "coach") query = query.Where(item => db.UserClaims.Any(claim => claim.UserId == item.Id && claim.ClaimType == ClaimNames.CoachOrg));
        if (accountType == "permanent") query = query.Where(item => item is OlympUser);
        else if (accountType == "participant") query = query.Where(item => item is Competitor);
        if (Visibility == "hidden") query = query.Where(item => item.IsHidden);
        else if (Visibility == "visible") query = query.Where(item => !item.IsHidden);
        if (Organization is int organization) query = query.Where(item => item.OrganizationId == organization);
        if (CoachOrganization is int coachOrganization) {
            string value = coachOrganization.ToString(CultureInfo.InvariantCulture);
            query = query.Where(item => db.UserClaims.Any(claim => claim.UserId == item.Id && claim.ClaimType == ClaimNames.CoachOrg && claim.ClaimValue == value));
        }
        if (Coach is int coach) query = query.Where(item => item.CoachId == coach);
        if (Member is int member) query = query.Where(item => db.Competitors.Any(participant => participant.Id == item.Id && participant.Members.Any(account => account.Id == member)));
        if (Participant is int participantId) query = query.Where(item => db.Competitors.Any(participant => participant.Id == participantId && participant.Members.Any(account => account.Id == item.Id)));
        return query.Select(item => new Row {
            Id = item.Id, Name = item.Name, Login = item.UserName, Email = item.Email,
            ContestId = item is Competitor ? ((Competitor)item).ContestId : null,
            ContestName = item is Competitor ? ((Competitor)item).Contest.Name : null,
            Participant = item is Competitor, Hidden = item.IsHidden, Locked = item.LockoutEnabled && item.LockoutEnd > DateTimeOffset.Now,
            OrganizationId = item.OrganizationId, OrganizationName = item.Organization == null ? null : item.Organization.Name,
            Admin = db.UserRoles.Any(link => link.UserId == item.Id && db.Roles.Any(role => role.Id == link.RoleId && role.Name == RoleNames.Admin)),
            Jury = db.UserRoles.Any(link => link.UserId == item.Id && db.Roles.Any(role => role.Id == link.RoleId && role.Name == RoleNames.Jury)),
            Coach = db.UserClaims.Any(claim => claim.UserId == item.Id && claim.ClaimType == ClaimNames.CoachOrg)
        }).OrderBy(item => item.Name).ThenBy(item => item.Id);
    }
    private void ApplyFilters() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> {
        [nameof(Search)] = _filters.Search, [nameof(Group)] = null, [nameof(AccountType)] = _filters.AccountType,
        [nameof(Role)] = _filters.Role, [nameof(Visibility)] = _filters.Visibility, [nameof(Organization)] = _filters.Organization, ["page"] = null, ["row"] = null
    }));
    private string DetailUrl(int id) => GridState.DetailUrl(Navigation.Uri, $"admin/users/{id}/edit", id);
    private sealed class Filters {
        public string? Search { get; set; }
        public string? AccountType { get; set; }
        public string? Role { get; set; }
        public string? Visibility { get; set; }
        public int? Organization { get; set; }
    }
    internal sealed class Row {
        public int Id { get; init; }
        public string Name { get; init; } = "";
        public string? Login { get; init; }
        public string? Email { get; init; }
        public int? ContestId { get; init; }
        public string? ContestName { get; init; }
        public bool Participant { get; init; }
        public bool Hidden { get; init; }
        public bool Locked { get; init; }
        public bool Admin { get; init; }
        public bool Jury { get; init; }
        public bool Coach { get; init; }
        public int? OrganizationId { get; init; }
        public string? OrganizationName { get; init; }
    }
}
