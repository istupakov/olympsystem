@page "/admin/users"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject StaffGridState GridState
@inject IDbContextFactory<OlympContext> ContextFactory

<PageTitle>@SiteResources.StaffUsers</PageTitle>
<h1 class="mb-4">@SiteResources.StaffUsers</h1>
<UnconfirmedUserCleanup OnDeleted="@(() => _gridVersion++)" />
<EditForm Model="_filters" OnValidSubmit="ApplyFilters" class="row g-3 mb-4">
    <div class="col-12">
        <label for="user-search" class="form-label">@SiteResources.StaffUserSearch</label>
        <InputText id="user-search" class="form-control" @bind-Value="_filters.Search" />
    </div>
    <div class="col-md-6 col-xl-3">
        <label for="user-role" class="form-label">@SiteResources.StaffRoles</label>
        <InputSelect id="user-role" class="form-select" @bind-Value="_filters.Role">
            <option value="">@SiteResources.StaffAll</option>
            <option value="admin">@SiteResources.StaffAdministrator</option>
            <option value="jury">@SiteResources.JurySection</option>
            <option value="coach">@SiteResources.StaffCoach</option>
        </InputSelect>
    </div>
    <div class="col-md-6 col-xl-3">
        <label for="user-visibility" class="form-label">@SiteResources.StaffVisibility</label>
        <InputSelect id="user-visibility" class="form-select" @bind-Value="_filters.Visibility">
            <option value="">@SiteResources.StaffAll</option>
            <option value="hidden">@SiteResources.StaffHiddenAccounts</option>
            <option value="visible">@SiteResources.StaffVisibleAccounts</option>
        </InputSelect>
    </div>
    <div class="col-md-6 col-xl-3">
        <label for="user-sign-in" class="form-label">@SiteResources.StaffSignIn</label>
        <InputSelect id="user-sign-in" class="form-select" @bind-Value="_filters.LoginState">
            <option value="">@SiteResources.StaffAll</option>
            <option value="allowed">@SiteResources.StaffSignInAllowed</option>
            <option value="blocked">@SiteResources.StaffBanned</option>
            <option value="unconfirmed">@SiteResources.StaffEmailNotConfirmed</option>
        </InputSelect>
    </div>
    <div class="col-md-6 col-xl-3">
        <label for="user-organization" class="form-label">@SiteResources.StaffOrganization</label>
        <InputSelect @key="_organizations" id="user-organization" class="form-select" @bind-Value="_filters.Organization">
            <option value="">@SiteResources.StaffAll</option>
            @if (Organization is int missingOrganization && !_organizations.Any(item => item.Id == missingOrganization)) { <option value="@missingOrganization">@StaffEntityLabel.Format(missingOrganization, null)</option> }
            @foreach (var organization in _organizations) { <option value="@organization.Id">@StaffEntityLabel.Format(organization.Id, organization.Name)</option> }
        </InputSelect>
    </div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary">@SiteResources.StaffFind</button>
        <a class="btn btn-outline-secondary" href="admin/users">@SiteResources.StaffReset</a>
    </div>
</EditForm>
<div class="d-flex flex-wrap gap-2 mb-3">
    <ActiveFilter Name="Search" Label="@SiteResources.StaffUserSearch" Value="@Search" />
    <ActiveFilter Name="Role" Label="@SiteResources.StaffRoles" Value="@(Role == "admin" ? SiteResources.StaffAdministrator : Role == "jury" ? SiteResources.JurySection : Role == "coach" ? SiteResources.StaffCoach : null)" />
    <ActiveFilter Name="Visibility" Label="@SiteResources.StaffVisibility" Value="@(Visibility == "hidden" ? SiteResources.StaffHiddenAccounts : Visibility == "visible" ? SiteResources.StaffVisibleAccounts : null)" />
    <ActiveFilter Name="LoginState" Label="@SiteResources.StaffSignIn" Value="@LoginStateLabel" />
    <ActiveFilter Name="Organization" Label="@SiteResources.StaffOrganization" Value="@(Organization is int organization ? StaffEntityLabel.Format(organization, _organizations.SingleOrDefault(item => item.Id == organization)?.Name) : null)" />
    <ActiveFilter Name="CoachOrganization" Label="@SiteResources.StaffOrganizationCoaches" Value="@_relations.GetValueOrDefault(nameof(CoachOrganization))" />
    <ActiveFilter Name="Coach" Label="@SiteResources.StaffCoachedAccounts" Value="@_relations.GetValueOrDefault(nameof(Coach))" />
</div>
<StaffGrid @key="(Navigation.Uri, _gridVersion)" TGridItem="Row" Query="Query" ItemKey="@(item => item.Id)" OrderKey="@(item => item.Id)" EmptyText="@SiteResources.StaffNoUsers">
    <TemplateColumn Title="ID" SortBy="_idSort" Sortable="true" Context="item">
        <a href="@DetailUrl(item.Id)">@item.Id</a>
    </TemplateColumn>
    <TemplateColumn Title="@AccountResources.PublicName" SortBy="_nameSort" Sortable="true" Context="item">
        <a href="@DetailUrl(item.Id)">@item.Name</a>
    </TemplateColumn>
    <PropertyColumn Property="@(item => item.Login)" Title="@SiteResources.StaffLogin" Sortable="true" />
    <PropertyColumn Property="@(item => item.Email)" Title="@SiteResources.StaffEmail" Sortable="true" />
    <TemplateColumn Title="@SiteResources.StaffRegistrationDate" SortBy="_registrationSort" Sortable="true" Context="item">@(item.RegistrationDate?.LocalDateTime.ToString("g") ?? "–")</TemplateColumn>
    <TemplateColumn Title="@SiteResources.StaffOrganization" SortBy="_organizationSort" Sortable="true" Context="item">
        @if (item.OrganizationId is int id)
        {
            <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(Organization), id)" Label="@SiteResources.StaffOrganization" Value="@(item.OrganizationName ?? "")"><a href="@GridState.DetailUrl(Navigation.Uri, $"admin/organizations/{id}/edit", item.Id)">@item.OrganizationName</a></QuickFilter>
        }
    </TemplateColumn>
    <TemplateColumn Title="@SiteResources.StaffRoles" Context="item">
        @if (item.Admin) { <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(Role), "admin")" Label="@SiteResources.StaffRoles" Value="@SiteResources.StaffAdministrator"><span class="badge text-bg-secondary">@SiteResources.StaffAdministrator</span></QuickFilter> }
        @if (item.Jury) { <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(Role), "jury")" Label="@SiteResources.StaffRoles" Value="@SiteResources.JurySection"><span class="badge text-bg-secondary">@SiteResources.JurySection</span></QuickFilter> }
        @if (item.Coach) { <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(Role), "coach")" Label="@SiteResources.StaffRoles" Value="@SiteResources.StaffCoach"><span class="badge text-bg-secondary">@SiteResources.StaffCoach</span></QuickFilter> }
    </TemplateColumn>
    <TemplateColumn Title="@SiteResources.StaffVisibility" Context="item">
        <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(Visibility), item.Hidden ? "hidden" : "visible")" Label="@SiteResources.StaffVisibility" Value="@(item.Hidden ? SiteResources.StaffHiddenAccounts : SiteResources.StaffVisibleAccounts)"><span class="badge @(item.Hidden ? "text-bg-secondary" : "text-bg-light")">@(item.Hidden ? SiteResources.StaffHiddenAccounts : SiteResources.StaffVisibleAccounts)</span></QuickFilter>
    </TemplateColumn>
    <TemplateColumn Title="@SiteResources.StaffSignIn" Context="item">
        <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(LoginState), item.Locked ? "blocked" : item.Confirmed ? "allowed" : "unconfirmed")" Label="@SiteResources.StaffSignIn" Value="@SignInLabel(item.Locked ? "blocked" : item.Confirmed ? "allowed" : "unconfirmed")"><span class="badge @(item.Locked ? "text-bg-danger" : item.Confirmed ? "text-bg-success" : "text-bg-warning")">@SignInLabel(item.Locked ? "blocked" : item.Confirmed ? "allowed" : "unconfirmed")</span></QuickFilter>
    </TemplateColumn>
</StaffGrid>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Role { get; set; }
    [SupplyParameterFromQuery] public string? LoginState { get; set; }
    private string? LoginStateLabel => LoginState is "allowed" or "blocked" or "unconfirmed" ? SignInLabel(LoginState) : null;
    private static string SignInLabel(string state) => state switch { "allowed" => SiteResources.StaffSignInAllowed, "blocked" => SiteResources.StaffBanned, _ => SiteResources.StaffEmailNotConfirmed };
    [SupplyParameterFromQuery] public string? Visibility { get; set; }
    [SupplyParameterFromQuery] public int? Organization { get; set; }
    [SupplyParameterFromQuery] public int? CoachOrganization { get; set; }
    [SupplyParameterFromQuery] public int? Coach { get; set; }
    private Filters _filters = new();
    private int _gridVersion;
    private List<Organization> _organizations = [];
    private readonly Dictionary<string, string> _relations = [];
    private readonly GridSort<Row> _idSort = GridSort<Row>.ByAscending(item => item.Id);
    private readonly GridSort<Row> _registrationSort = GridSort<Row>.ByAscending(item => item.RegistrationDate).ThenAscending(item => item.Id);
    private readonly GridSort<Row> _nameSort = GridSort<Row>.ByAscending(item => item.Name).ThenAscending(item => item.Id);
    private readonly GridSort<Row> _organizationSort = GridSort<Row>.ByAscending(item => item.OrganizationName).ThenAscending(item => item.Id);

    protected override async Task OnParametersSetAsync()
    {
        _filters = new() { Search = Search,
            Role = Role, Visibility = Visibility, LoginState = LoginState, Organization = Organization };
        await using var db = await ContextFactory.CreateDbContextAsync();
        _organizations = await db.Organizations.AsNoTracking().OrderBy(item => item.Name).ToListAsync();
        _relations.Clear();
        if (CoachOrganization is int organizationId)
        {
            _relations[nameof(CoachOrganization)] = StaffEntityLabel.Format(organizationId, _organizations.SingleOrDefault(item => item.Id == organizationId)?.Name)!;
        }
        if (Coach is int userId)
            _relations[nameof(Coach)] = StaffEntityLabel.Format(userId, await db.OlympUsers.Where(item => item.Id == userId).Select(item => item.Name).SingleOrDefaultAsync())!;
    }

    internal IQueryable<Row> Query(OlympContext db)
    {
        var query = db.OlympUsers.AsNoTracking();
        string? selectedRole = Role;
        if (!string.IsNullOrWhiteSpace(Search)) {
            string search = Search.Trim();
            bool hasId = int.TryParse(search, out int id);
            query = query.Where(item => (hasId && item.Id == id) || item.Name.Contains(search)
                || (item.UserName != null && item.UserName.Contains(search)) || (item.Email != null && item.Email.Contains(search)));
        }
        if (selectedRole is "admin" or "jury") {
            string role = selectedRole == "admin" ? RoleNames.Admin : RoleNames.Jury;
            query = query.Where(item => db.UserRoles.Any(link => link.UserId == item.Id && db.Roles.Any(value => value.Id == link.RoleId && value.Name == role)));
        } else if (selectedRole == "coach") query = query.Where(item => db.UserClaims.Any(claim => claim.UserId == item.Id && claim.ClaimType == ClaimNames.CoachOrg));
        if (Visibility == "hidden") query = query.Where(item => item.IsHidden);
        else if (Visibility == "visible") query = query.Where(item => !item.IsHidden);
        var now = DateTimeOffset.Now;
        if (LoginState == "blocked") query = query.Where(item => item.LockoutEnabled && item.LockoutEnd > now);
        else if (LoginState == "allowed") query = query.Where(item => item.EmailConfirmed && (!item.LockoutEnabled || item.LockoutEnd == null || item.LockoutEnd <= now));
        else if (LoginState == "unconfirmed") query = query.Where(item => !item.EmailConfirmed && (!item.LockoutEnabled || item.LockoutEnd == null || item.LockoutEnd <= now));
        if (Organization is int organization) query = query.Where(item => item.OrganizationId == organization);
        if (CoachOrganization is int coachOrganization) {
            string value = coachOrganization.ToString(CultureInfo.InvariantCulture);
            query = query.Where(item => db.UserClaims.Any(claim => claim.UserId == item.Id && claim.ClaimType == ClaimNames.CoachOrg && claim.ClaimValue == value));
        }
        if (Coach is int coach) query = query.Where(item => item.CoachId == coach);
        return query.Select(item => new Row {
            Id = item.Id, Name = item.Name, Login = item.UserName, Email = item.Email, RegistrationDate = item.RegistrationDate,
            Hidden = item.IsHidden, Confirmed = item.EmailConfirmed, Locked = item.LockoutEnabled && item.LockoutEnd > now,
            OrganizationId = item.OrganizationId, OrganizationName = item.Organization == null ? null : item.Organization.Name,
            Admin = db.UserRoles.Any(link => link.UserId == item.Id && db.Roles.Any(role => role.Id == link.RoleId && role.Name == RoleNames.Admin)),
            Jury = db.UserRoles.Any(link => link.UserId == item.Id && db.Roles.Any(role => role.Id == link.RoleId && role.Name == RoleNames.Jury)),
            Coach = db.UserClaims.Any(claim => claim.UserId == item.Id && claim.ClaimType == ClaimNames.CoachOrg)
        }).OrderBy(item => item.Name).ThenBy(item => item.Id);
    }
    private void ApplyFilters() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> {
        [nameof(Search)] = _filters.Search, [nameof(Role)] = _filters.Role, [nameof(Visibility)] = _filters.Visibility, [nameof(LoginState)] = _filters.LoginState, [nameof(Organization)] = _filters.Organization, ["page"] = null, ["row"] = null
    }));
    private string DetailUrl(int id) => GridState.DetailUrl(Navigation.Uri, $"admin/users/{id}/edit", id);
    private sealed class Filters {
        public string? Search { get; set; }
        public string? Role { get; set; }
        public string? LoginState { get; set; }
        public string? Visibility { get; set; }
        public int? Organization { get; set; }
    }
    internal sealed class Row {
        public int Id { get; init; }
        public string Name { get; init; } = "";
        public string? Login { get; init; }
        public string? Email { get; init; }
        public DateTimeOffset? RegistrationDate { get; init; }
        public bool Hidden { get; init; }
        public bool Confirmed { get; init; }
        public bool Locked { get; init; }
        public bool Admin { get; init; }
        public bool Jury { get; init; }
        public bool Coach { get; init; }
        public int? OrganizationId { get; init; }
        public string? OrganizationName { get; init; }
    }
}
