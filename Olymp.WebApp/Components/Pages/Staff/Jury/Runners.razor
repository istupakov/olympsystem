@page "/jury/runners"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Olymp.Checker
@using Olymp.WebApp.Services.Checker
@inject ICheckerManager Checkers
@inject IDbContextFactory<OlympContext> ContextFactory
@inject NavigationManager Navigation
@inject ILogger<Runners> Logger
@implements IAsyncDisposable

<PageTitle>@SiteResources.StaffRunner</PageTitle>
<CompilerNavigation />
<h1 class="h3">@SiteResources.StaffRunner</h1>
@if (!_loaded) { <p role="status">@SiteResources.StaffLoading</p> }
else
{
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <button class="btn btn-outline-secondary" @onclick="RefreshAsync">@SiteResources.Refresh</button>
        <span class="small text-body-secondary">@SiteResources.StaffRunnerRefresh</span>
    </div>
    @if (_error is not null) { <p class="alert alert-danger" role="alert">@_error</p> }
    @if (_runners.Count == 0) { <p>@SiteResources.StaffNoRunners</p> }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead><tr><th>@SiteResources.StaffRunner</th><th>ID</th><th>@SiteResources.StaffRunnerConnected</th><th>@SiteResources.StaffSelfTests</th></tr></thead>
                <tbody>
                    @foreach (var runner in _runners)
                    {
                        var tests = runner.SelfTestingResults.ToArray();
                        <tr @key="runner.Id"><td><a href="@RunnerUrl(runner.Id)">@runner.Name</a></td><td class="text-nowrap"><code>@runner.Id</code></td><td>@runner.ConnectingTime.ToLocalTime().ToString("g")</td><td><span class="badge @StatusClass(runner.SelfTestingStatus)">@StatusText(runner.SelfTestingStatus)</span><div class="small mt-1">@Summary(tests)</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (SelectedRunner is { } selected)
    {
        <section class="mb-4" aria-label="@selected.Name">
            <h2 class="h4">@selected.Name</h2>
            <dl class="row small"><dt class="col-sm-3">ID</dt><dd class="col-sm-9 text-break">@selected.Id</dd><dt class="col-sm-3">@SiteResources.StaffRunnerConnected</dt><dd class="col-sm-9">@selected.ConnectingTime.ToLocalTime().ToString("g")</dd></dl>
            @if (selected.Compilators is null) { <p>@SiteResources.StaffLoadingVersions</p> }
            @foreach (var info in RunnerCompilers(selected))
            {
                var tests = selected.SelfTestingResults.Where(item => item.Compilator.Configuration.Name == info.Configuration.Name).ToArray();
                var record = _compilers.FirstOrDefault(item => CompilerMatching.Matches(item, info));
                var failed = info.Error is not null || tests.Any(item => item.Result is not null && item.Result != item.ExpectedResult);
                <details class="card mb-3" open="@failed" @key="info.Configuration.Name">
                    <summary class="card-header">@info.DisplayName <span class="badge @(failed ? "text-bg-danger" : "text-bg-secondary")">@Summary(tests)</span></summary>
                    <div class="card-body">
                        <p class="text-break">@SiteResources.StaffConfiguration: @info.Configuration.Name (@info.Configuration.ConfigName)</p>
                        <p class="text-break">@SiteResources.StaffCommandLine: <code>@info.Configuration.CompileCommand</code></p>
                        @if (!string.IsNullOrWhiteSpace(info.Description)) { <pre class="overflow-auto">@info.Description</pre> }
                        @if (info.Error is not null) { <p class="text-danger">@SiteResources.StaffVersionError</p><pre class="overflow-auto text-danger">@info.Error</pre> }
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (record is not null) { <a href="jury/compilers/@record.Id">@SiteResources.Compiler · ID @record.Id</a> }
                            else { <span>@SiteResources.StaffNotAdded</span> }
                                <a href="jury/trial-run?Runner=@selected.Id&Configuration=@Uri.EscapeDataString(info.Configuration.Name)">@SiteResources.StaffRunCode</a>
                                <AuthorizeView Roles="@RoleNames.Admin">
                                    @if (record is null && info.Error is null && selected.SelfTestingStatus == CheckerSelfTestingStatus.Success) { <a href="jury/compilers/add?Runner=@selected.Id&Configuration=@Uri.EscapeDataString(info.Configuration.Name)">@SiteResources.StaffAddCompiler</a> }
                                </AuthorizeView>
                        </div>
                        @if (tests.Length > 0)
                        {
                            <div class="table-responsive"><table class="table table-sm">
                                <thead><tr><th>@SiteResources.StaffTest</th><th>@SiteResources.StaffExpected</th><th>@SiteResources.StaffActual</th></tr></thead><tbody>
                                    @foreach (var test in tests)
                                    {
                                        <tr class="@(test.Result is not null && test.Result != test.ExpectedResult ? "table-danger" : null)"><td>@test.Name</td><td>@test.ExpectedResult</td><td>@test.Result</td></tr>
                                        @if (!string.IsNullOrEmpty(test.Output)) { <tr><td colspan="3"><details><summary>@SiteResources.StaffLog</summary><pre class="overflow-auto">@test.Output</pre></details></td></tr> }
                                    }
                                </tbody>
                            </table></div>
                        }
                    </div>
                </details>
            }
        </section>
    }
}
