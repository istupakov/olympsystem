@page "/jury/runners"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Olymp.Checker
@using Olymp.WebApp.Services.Checker
@inject ICheckerManager Checkers
@inject IDbContextFactory<OlympContext> ContextFactory
@inject NavigationManager Navigation
@inject ILogger<Runners> Logger
@implements IAsyncDisposable

<StaffPageTitle Title="@SiteResources.StaffRunner" />
<CompilerNavigation />
<h1 class="h3">@SiteResources.StaffRunner</h1>
@if (!_loaded) { <p role="status">@SiteResources.StaffLoading</p> }
else
{
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <button class="btn btn-secondary" @onclick="RefreshAsync">@SiteResources.Refresh</button>
        <span class="small text-body-secondary">@SiteResources.StaffRunnerRefresh</span>
    </div>
    @if (_error is not null) { <p class="alert alert-danger" role="alert">@_error</p> }
    <EditForm Model="_filters" OnValidSubmit="ApplyFilters" class="row g-3 mb-3">
        <div class="col-md-6"><label for="runner-self-test" class="form-label">@SiteResources.StaffSelfTests</label>
            <InputSelect id="runner-self-test" class="form-select" @bind-Value="_filters.SelfTest">
                <option value="">@SiteResources.StaffAll</option>
                @foreach (var status in Enum.GetValues<CheckerSelfTestingStatus>()) { <option value="@status">@StatusText(status)</option> }
            </InputSelect>
        </div>
        <div class="col-md-6"><label for="runner-missing" class="form-label">@SiteResources.StaffUnaddedConfigurations</label>
            <InputSelect id="runner-missing" class="form-select" @bind-Value="_filters.MissingCompiler">
                <option value="">@SiteResources.StaffAll</option><option value="True">@SiteResources.StaffYes</option><option value="False">@SiteResources.StaffNo</option>
            </InputSelect>
        </div>
        <div class="col-12 d-flex gap-2"><button class="btn btn-primary">@SiteResources.StaffFind</button><a class="btn btn-outline-secondary" href="jury/runners">@SiteResources.StaffReset</a></div>
    </EditForm>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <ActiveFilter Name="SelfTest" Label="@SiteResources.StaffSelfTests" Value="@(Enum.TryParse<CheckerSelfTestingStatus>(SelfTest, out var selfTest) ? StatusText(selfTest) : null)" />
        <ActiveFilter Name="MissingCompiler" Label="@SiteResources.StaffUnaddedConfigurations" Value="@(MissingCompiler is bool missing ? missing ? SiteResources.StaffYes : SiteResources.StaffNo : null)" />
    </div>
    <StaffGrid @key="Navigation.Uri" TGridItem="RunnerRow" Items="Rows" ItemKey="@(item => item.Id)" OrderKey="@(item => item.Index)" EmptyText="@SiteResources.StaffNoRunners">
        <TemplateColumn Title="@SiteResources.StaffRunner" Sortable="true" SortBy="@(GridSort<RunnerRow>.ByAscending(item => item.Name))" Context="row"><a href="@RunnerUrl(row.Id)">@row.Name</a></TemplateColumn>
        <TemplateColumn Title="ID" Sortable="true" SortBy="@(GridSort<RunnerRow>.ByAscending(item => item.Id))" Context="row"><a href="@RunnerUrl(row.Id)"><code>@row.Id</code></a></TemplateColumn>
        <TemplateColumn Title="@SiteResources.StaffRunnerConnected" Sortable="true" SortBy="@(GridSort<RunnerRow>.ByAscending(item => item.Connected))" Context="row">@row.Connected.ToLocalTime().ToString("g")</TemplateColumn>
        <TemplateColumn Title="@SiteResources.StaffSelfTests" Sortable="true" SortBy="@(GridSort<RunnerRow>.ByAscending(item => item.Status))" Context="row">
            <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(SelfTest), row.Status)" Label="@SiteResources.StaffSelfTests" Value="@StatusText(row.Status)"><span class="badge @StatusClass(row.Status)">@StatusText(row.Status)</span></QuickFilter>
            <div class="small mt-1">@row.Summary</div>
        </TemplateColumn>
        <TemplateColumn Title="@SiteResources.StaffUnaddedConfigurations" Sortable="true" SortBy="@(GridSort<RunnerRow>.ByAscending(item => item.MissingCompiler))" Context="row">
            <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(MissingCompiler), row.MissingCompiler)" Label="@SiteResources.StaffUnaddedConfigurations" Value="@(row.MissingCompiler ? SiteResources.StaffYes : SiteResources.StaffNo)">@(row.MissingCompiler ? SiteResources.StaffYes : SiteResources.StaffNo)</QuickFilter>
        </TemplateColumn>
    </StaffGrid>
    @if (SelectedRunner is { } selected)
    {
        <section class="card my-4" aria-label="@selected.Name">
            <header class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h2 class="h4 mb-0 text-break">@selected.Name</h2>
                <span class="badge @StatusClass(selected.SelfTestingStatus)">@StatusText(selected.SelfTestingStatus)</span>
            </header>
            <div class="card-body">
                <dl class="row small"><dt class="col-sm-3">ID</dt><dd class="col-sm-9 text-break">@selected.Id</dd><dt class="col-sm-3">@SiteResources.StaffRunnerConnected</dt><dd class="col-sm-9">@selected.ConnectingTime.ToLocalTime().ToString("g")</dd></dl>
                @if (selected.Compilators is null) { <p>@SiteResources.StaffLoadingVersions</p> }
                @foreach (var info in RunnerCompilers(selected))
                {
                    var tests = selected.SelfTestingResults.Where(item => item.Compilator.Configuration.Name == info.Configuration.Name).ToArray();
                    var record = _compilers.FirstOrDefault(item => CompilerMatching.Matches(item, info));
                    var failed = info.Error is not null || tests.Any(item => item.Result is not null && item.Result != item.ExpectedResult);
                    <details class="card mb-3" open="@failed" @key="info.Configuration.Name">
                        <summary class="card-header">
                            @info.DisplayName <span class="badge @ConfigurationStatusClass(info, tests)">@Summary(tests)</span>
                            @if (record is null) { <span class="badge text-bg-warning">@SiteResources.StaffNotAddedToSite</span> }
                            else if (!record.IsActive) { <span class="badge text-bg-secondary">@SiteResources.StaffDisabled</span> }
                        </summary>
                        <div class="card-body">
                            <p class="text-break">@SiteResources.StaffConfiguration: @info.Configuration.Name (@info.Configuration.ConfigName)</p>
                            <p class="text-break">@SiteResources.StaffCommandLine: <code>@info.Configuration.CompileCommand</code></p>
                            @if (!string.IsNullOrWhiteSpace(info.Description)) { <pre class="overflow-auto">@info.Description</pre> }
                            @if (info.Error is not null) { <p class="text-danger">@SiteResources.StaffVersionError</p><pre class="overflow-auto text-danger">@info.Error</pre> }
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (record is not null) { <a href="jury/compilers/@record.Id">@SiteResources.Compiler · ID @record.Id</a> }
                                    <a href="jury/trial-run?Runner=@selected.Id&Configuration=@Uri.EscapeDataString(info.Configuration.Name)">@SiteResources.StaffRunCode</a>
                                    <AuthorizeView Roles="@RoleNames.Admin">
                                        @if (record is null && info.Error is null && selected.SelfTestingStatus == CheckerSelfTestingStatus.Success) { <a href="jury/compilers/add?Runner=@selected.Id&Configuration=@Uri.EscapeDataString(info.Configuration.Name)">@SiteResources.StaffAddCompiler</a> }
                                    </AuthorizeView>
                            </div>
                            @if (tests.Length > 0)
                            {
                                <div class="table-responsive"><table class="table table-sm">
                                    <thead><tr><th>@SiteResources.StaffTest</th><th>@SiteResources.StaffExpected</th><th>@SiteResources.StaffActual</th></tr></thead><tbody>
                                        @foreach (var test in tests)
                                        {
                                            <tr class="@(test.Result is not null && test.Result != test.ExpectedResult ? "table-danger" : null)"><td>@test.Name</td><td>@test.ExpectedResult</td><td>@test.Result</td></tr>
                                            @if (!string.IsNullOrEmpty(test.Output)) { <tr><td colspan="3"><details><summary>@SiteResources.StaffLog</summary><pre class="overflow-auto">@test.Output</pre></details></td></tr> }
                                        }
                                    </tbody>
                                </table></div>
                            }
                        </div>
                    </details>
                }
            </div>
        </section>
    }
}
