@page "/jury/contests/{ContestId:int}/import"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using Olymp.WebApp.Services
@using Olymp.WebApp.Services.Contests
@using Olymp.WebApp.Components.Submissions
@using Olymp.WebApp.Components.Problems
@inject IServiceScopeFactory ScopeFactory
@inject IDbContextFactory<OlympContext> ContextFactory
@inject NavigationManager Navigation
@inject ILogger<ContestImport> Logger
@inject Microsoft.Extensions.Options.IOptions<ContestImportOptions> ImportOptions

<NavigationLock ConfirmExternalNavigation="@(HasPending || _busy || AnyChecking)" OnBeforeInternalNavigation="BeforeNavigation" />
<StaffPageTitle Title="@SiteResources.ImportProblems" Context="@_contest?.Name" />
@if (_contest is not null)
{
    <StaffContestNavigation ContestId="ContestId" ContestName="@_contest.Name" IsHidden="_contest.IsHidden" />
}
<h1 class="h3">@SiteResources.ImportProblems</h1>
@if (_error is not null) { <p class="alert alert-danger" role="alert">@_error</p> }
@if (_status is not null) { <p class="alert alert-success" role="status">@_status</p> }
@if (_canImport)
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-outline-secondary" @onclick="Finish">@SiteResources.ImportFinish</button>
        @if (_preview is not null)
        {
            <button class="btn btn-outline-primary" disabled="@(_busy || AnyChecking || _confirmSave || _exitTarget is not null)" @onclick="ValidateAllAsync">@SiteResources.ImportValidateAll</button>
        }
        @if (_busy || AnyChecking) { <button class="btn btn-outline-secondary" @onclick="Stop">@(_saving ? SiteResources.ImportCancelSave : SiteResources.ImportStop)</button> }
    </div>
    @if (_exitTarget is not null)
    {
        <div class="alert alert-warning" role="alert">
            <p>@SiteResources.ImportLeaveConfirm</p>
            <button class="btn btn-warning" @onclick="Leave">@SiteResources.ImportFinish</button>
            <button class="btn btn-outline-secondary ms-2" @onclick="() => _exitTarget = null">@SiteResources.ImportStay</button>
        </div>
    }
    @if (_validatingAll) { <p role="status">@string.Format(SiteResources.ImportValidationProgress, _validatedCount, _preview!.Rows.Count)</p> }
    @if (_busy) { <p role="status">@(_saving ? SiteResources.ImportWaiting : SiteResources.StaffLoading)</p> }
    <fieldset disabled="@(_busy || AnyChecking || _confirmSave || _exitTarget is not null)">
        <div class="mb-3"><label for="import-zip" class="form-label">ZIP</label><InputFile id="import-zip" class="form-control" accept=".zip" OnChange="UploadAsync" /></div>
        @if (_preview is { } preview)
        {
            <div class="mb-3"><label for="import-line-endings" class="form-label">@SiteResources.ImportLineEndings</label>
                <select id="import-line-endings" class="form-select" @bind="preview.LineEndings" @bind:after="SettingsChangedAsync">
                    <option value="@ImportLineEndings.Crlf">CRLF</option>
                    <option value="@ImportLineEndings.Lf">LF</option>
                </select>
            </div>
            <div class="mb-4"><label for="import-cpp" class="form-label">@SiteResources.ImportValidatorCompiler</label>
                <select id="import-cpp" class="form-select" @bind="preview.ValidatorCompilerId" @bind:after="SettingsChangedAsync">
                    <option value="">@SiteResources.SelectCompiler</option>
                    @foreach (var c in _validatorCompilers) { <option value="@c.Id">@(c.Description ?? c.Name) · ID @c.Id</option> }
                </select>
            </div>
        }
    </fieldset>
    @if (_preview is { } package)
    {
        <div class="problem-browser row g-4 align-items-start">
            <nav class="problem-list col-lg-3 text-break" aria-label="@SiteResources.ProblemList">
                <div class="d-lg-none mb-3"><label for="import-problem" class="form-label">@SiteResources.Problems</label>
                    <select id="import-problem" class="form-select" value="@_selected?.Folder" @onchange="SelectProblem" disabled="@_busy">
                        @foreach (var row in package.Rows) { <option value="@row.Folder">@row.Label · @RowStatus(row) · @SiteResources.ImportValidator: @ValidationStatus(row)</option> }
                    </select>
                </div>
                <div class="list-group d-none d-lg-flex">
                    @foreach (var row in package.Rows)
                    {
                        <a class="list-group-item list-group-item-action @(_selected == row ? "active" : null) @(_busy ? "disabled" : null)" href="@ProblemUrl(row)" aria-current="@(_selected == row ? "page" : null)" aria-disabled="@_busy">
                            <span class="d-block">@row.Label</span><span class="badge @RowBadgeClass(row) text-wrap text-start">@RowStatus(row)</span>
                            <ReferenceBadges HasValidator="row.HasValidator" ValidatorPassed="row.ValidatorPassed" ReferenceCount="row.EffectiveReferenceCount" HasAccepted="row.HasAcceptedReference" />
                        </a>
                    }
                </div>
            </nav>
            @if (_selected is { } task)
            {
                <section id="problem-detail" class="problem-detail col-lg-9 text-break" aria-label="@SiteResources.ImportProblemDetails" @key="task">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <h2 class="h4 mb-0">@task.Label</h2>
                        <span class="badge @RowBadgeClass(task) text-wrap text-start" role="status">@RowStatus(task)</span>
                        <ReferenceBadges HasValidator="task.HasValidator" ValidatorPassed="task.ValidatorPassed" ReferenceCount="task.EffectiveReferenceCount" HasAccepted="task.HasAcceptedReference" />
                    </div>
                    <p class="text-body-secondary">@task.Folder · @(task.Id is { } id ? $"ID {id}" : SiteResources.ImportNewProblem)</p>
                    <div class="table-responsive"><table class="table table-sm">
                        <thead><tr><th>@SiteResources.ImportParameter</th><th>@SiteResources.ImportCurrentValue</th><th>@SiteResources.ImportNewValue</th></tr></thead>
                        <tbody>
                            <tr><th scope="row">@SiteResources.StaffTestNumber</th><td>@task.Previous?.Number</td><td>@task.Parameters.Number</td></tr>
                            <tr><th scope="row">@SiteResources.StaffName</th><td>@task.Previous?.Name</td><td>@task.Parameters.Name</td></tr>
                            <tr><th scope="row">@SiteResources.TimeLimit (@SiteResources.Seconds)</th><td>@task.Previous?.TimeLimit</td><td>@task.TimeLimit</td></tr>
                            <tr><th scope="row">@SiteResources.ImportSlowTimeLimit (@SiteResources.Seconds)</th><td>@task.Previous?.SlowTimeLimit</td><td>@task.SlowTimeLimit</td></tr>
                            <tr><th scope="row">@SiteResources.MemoryLimit (@SiteResources.Megabytes)</th><td>@task.Previous?.MemoryLimit</td><td>@task.Parameters.MemoryLimit</td></tr>
                            <tr><th scope="row">@SiteResources.StaffChecker</th><td>@task.Previous?.CheckerId</td><td>@task.Parameters.CheckerId</td></tr>
                            <tr><th scope="row">@SiteResources.StaffActive</th><td>@(task.Previous is null ? null : task.Previous.IsActive ? SiteResources.StaffYes : SiteResources.StaffNo)</td><td>@(task.Parameters.IsActive ? SiteResources.StaffYes : SiteResources.StaffNo)</td></tr>
                        </tbody>
                    </table></div>
                    <h3 class="h5">@SiteResources.StaffTests (@task.Tests.Count)</h3>
                    <p class="small text-body-secondary">@(task.SuppliesTests ? SiteResources.ImportSupplied : SiteResources.ImportRetained)</p>
                    <p class="small text-body-secondary">@SiteResources.ImportTestLineEndings</p>
                    <p>@SiteResources.ImportAddedTests: @Numbers(task.AddedTests)<br />@SiteResources.ImportChangedTests: @Numbers(task.ChangedTests)<br />@SiteResources.ImportRemovedTests: @Numbers(task.RemovedTests)</p>
                    <details class="mb-3"><summary>@SiteResources.ImportTestSet</summary>
                        <div class="table-responsive"><table class="table table-sm">
                            <thead><tr><th>@SiteResources.StaffTestNumber</th><th>@SiteResources.ImportOpenTest</th><th>@SiteResources.StaffActive</th><th>@SiteResources.StaffScore</th><th>@SiteResources.ImportComment</th></tr></thead>
                            <tbody>@foreach (var test in task.Tests) { <tr><td>@test.Number</td><td>@(test.IsOpen ? SiteResources.StaffYes : SiteResources.StaffNo)</td><td>@(test.IsActive ? SiteResources.StaffYes : SiteResources.StaffNo)</td><td>@test.Score</td><td>@test.Comment</td></tr> }</tbody>
                        </table></div>
                    </details>
                    @foreach (var message in task.StateErrors) { <p class="text-danger" role="alert">@message</p> }
                    @foreach (var message in task.StateWarnings) { <p class="text-warning-emphasis">@message</p> }
                    <h3 class="h5">@SiteResources.StatementPreview</h3>
                    <p class="small text-body-secondary">@(task.SuppliesStatement ? SiteResources.ImportSupplied : SiteResources.ImportRetained)</p>
                    <h4 class="h4">@task.Label</h4>
                    <ProblemStatementView Problem="PreviewProblem(task)" Examples="PreviewExamples(task)" Document="task.Document" ShowPdfLink="false" />
                    @if (task.UsesMarkdown && task.Statement is not null)
                    {
                        <details class="mb-3"><summary>@SiteResources.StatementSource</summary><pre class="overflow-auto">@task.Statement</pre></details>
                    }
                    <h3 class="h5">@SiteResources.ImportValidator</h3>
                    <button class="btn btn-outline-primary mb-3" disabled="@(_busy || AnyChecking || _confirmSave || _exitTarget is not null)" @onclick="CheckValidatorAsync">@SiteResources.ImportValidate</button>
                    @if (task.HasValidator)
                    {
                        <p>validator.cpp · @(task.Validator is not null ? SiteResources.ImportArchiveSolutions : SiteResources.ImportSavedValidator)
                            @if (task.Validator is { ReplacedIds.Count: > 0 }) { <span class="badge text-bg-warning">@SiteResources.ImportWillReplace</span> }
                        </p>
                        @if (task.Validator is { } validator)
                        {
                            @if (validator.AlreadySaved) { <p><span class="badge text-bg-success">@SiteResources.ImportAlreadySaved</span></p> }
                            else
                            {
                                @if (validator.Save && validator.ReplacedIds.Count == 0) { <p><span class="badge text-bg-warning">@SiteResources.ImportUpdateProblem</span></p> }
                                <fieldset disabled="@(_busy || task.IsChecking || _confirmSave || _exitTarget is not null)">
                                    <div class="form-check mb-3"><input id="save-validator" type="checkbox" class="form-check-input" @bind="validator.Save" @bind:after="SolutionsChanged" /><label for="save-validator" class="form-check-label">@SiteResources.ImportSaveValidator</label></div>
                                </fieldset>
                            }
                            @if (validator.ReplacedIds.Count != 0) { <p class="small text-warning-emphasis">@SiteResources.ImportValidatorReplacement</p> }
                        }
                    }
                    <p class="small text-body-secondary" role="status">@ValidationStatus(task)</p>
                    @foreach (var message in task.ValidatorErrors) { <p class="text-danger" role="alert">@message</p> }
                    @foreach (var message in task.ValidatorWarnings.Where(w => w != task.ValidatorMessage)) { <p class="text-warning-emphasis">@message</p> }
                    @if (task.ValidatorResult is { } validation) { <details class="mb-3"><summary>@SiteResources.StaffRunOutput</summary><pre class="overflow-auto">@validation.Log</pre></details> }
                    @if (task.SavedValidatorResult is { } savedValidation && !ReferenceEquals(savedValidation, task.ValidatorResult))
                    {
                        <p class="alert @(savedValidation.Compiled && savedValidation.Tests.All(t => t.IsValid) ? "alert-success" : "alert-warning")">@SiteResources.ImportSavedValidator: @(savedValidation.Compiled ? savedValidation.Tests.All(t => t.IsValid) ? SiteResources.ImportValidatorPassed : SiteResources.ImportValidatorRejected : SiteResources.ImportValidatorCompileFailed)</p>
                        <details class="mb-3"><summary>@SiteResources.StaffRunOutput</summary><pre class="overflow-auto">@savedValidation.Log</pre></details>
                    }
                    <fieldset disabled="@(_busy || _validatingAll || _confirmSave || _exitTarget is not null)">
                        <legend class="h5">@SiteResources.ImportLimits</legend>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6"><label class="form-label" for="import-time">@SiteResources.TimeLimit (@SiteResources.Seconds)</label><input id="import-time" type="number" min="1" class="form-control" @bind="task.TimeLimit" @bind:after="LimitsChanged" /></div>
                            <div class="col-md-6"><label class="form-label" for="import-slow">@SiteResources.ImportSlowTimeLimit (@SiteResources.Seconds)</label><input id="import-slow" type="number" min="1" class="form-control" @bind="task.SlowTimeLimit" @bind:after="LimitsChanged" /></div>
                        </div>
                        <fieldset disabled="@task.IsChecking">
                            <legend class="h5">@SiteResources.ImportSolutions</legend>
                            @if (task.Solutions.Count == 0 && task.ReferenceSolutions.Count == 0) { <p class="text-body-secondary">@SiteResources.ImportNoSolutions</p> }
                            else
                            {
                                <div class="table-responsive" tabindex="0"><table class="table table-sm text-nowrap align-middle">
                                    <thead><tr><th>@SiteResources.ImportRun</th><th>@SiteResources.ImportRunFile</th><th>@SiteResources.Compiler</th><th>@SiteResources.ImportSaveReference</th><th>@SiteResources.Status</th></tr></thead>
                                    <tbody>
                                        @if (task.Solutions.Count != 0) { <tr class="table-light"><th colspan="5">@SiteResources.ImportArchiveSolutions</th></tr> }
                                        @for (int i = 0; i < task.Solutions.Count; i++)
                                        {
                                            var solution = task.Solutions[i];
                                            <tr>
                                                <td><input id="@($"solution-{i}")" type="checkbox" class="form-check-input" aria-label="@($"{SiteResources.ImportRun}: {solution.Filename}")" disabled="@(solution.Save || solution.AlreadySaved)" checked="@(solution.Selected || solution.Save || solution.AlreadySaved)" @onchange="e => solution.Selected = e.Value is true" /></td>
                                                <td><label for="@($"solution-{i}")">@solution.Filename</label></td>
                                                <td>
                                                    <select class="form-select form-select-sm form-control-sm" aria-label="@($"{SiteResources.Compiler}: {solution.Filename}")" @bind="solution.CompilerId" @bind:after="SolutionsChanged">
                                                        <option value="">@SiteResources.SelectCompiler</option>
                                                        @foreach (var compiler in solution.Compilers) { <option value="@compiler.Id">@(compiler.Description ?? compiler.Name) · ID @compiler.Id</option> }
                                                    </select>
                                                    @if ((solution.Selected || solution.Save) && !solution.AlreadySaved && solution.CompilerId is null)
                                                    {
                                                        <span class="small text-warning-emphasis">@SiteResources.SelectCompiler</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (solution.AlreadySaved) { <span class="badge text-bg-success">@SiteResources.ImportAlreadySaved</span> }
                                                    else { <input type="checkbox" class="form-check-input" aria-label="@($"{SiteResources.ImportSaveReference}: {solution.Filename}")" @bind="solution.Save" @bind:after="SolutionsChanged" /> }
                                                </td>
                                                <td>
                                                    @if (solution.ReplacedIds.Count != 0) { <span class="badge text-bg-warning" title="@string.Format(SiteResources.ImportReferenceReplacement, solution.Filename)">@SiteResources.ImportWillReplace</span> }
                                                    else if (solution.Save && !solution.AlreadySaved) { <span class="badge text-bg-warning">@SiteResources.ImportUpdateProblem</span> }
                                                </td>
                                            </tr>
                                        }
                                        @if (task.ReferenceSolutions.Count != 0) { <tr class="table-light"><th colspan="5">@SiteResources.ImportSavedSolutions</th></tr> }
                                        @foreach (var solution in task.ReferenceSolutions)
                                        {
                                            <tr>
                                                <td><input id="@($"reference-{solution.Id}")" type="checkbox" class="form-check-input" aria-label="@($"{SiteResources.ImportRun}: {solution.Filename} · ID {solution.Id}")" checked="@(task.RequiresReferenceChecks && !task.IsReplaced(solution))" disabled /></td>
                                                <td><label for="@($"reference-{solution.Id}")">@solution.Filename</label> <span class="text-body-secondary">· ID @solution.Id</span></td>
                                                <td><span class="form-control-plaintext form-control-sm">@solution.Compiler</span></td>
                                                <td><span class="badge @(task.IsReplaced(solution) ? "text-bg-warning" : "text-bg-success")">@(task.IsReplaced(solution) ? SiteResources.ImportWillReplace : SiteResources.ImportAlreadySaved)</span></td>
                                                <td><SubmissionStatus StatusCode="solution.StatusCode" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table></div>
                                <p class="small text-body-secondary">@SiteResources.ImportRunPreviewHint</p>
                                <button class="btn btn-outline-primary mb-3" disabled="@(SelectedSolutionCount(task) == 0)" @onclick="RunSolutionsAsync">@SiteResources.ImportRunSelected</button>
                                <button class="btn btn-outline-secondary mb-3 ms-2" disabled="@(SelectedSolutionCount(task) == 0)" @onclick="RerunSolutionsAsync">@SiteResources.ImportRerunAll</button>
                                @if (!task.ReferencesChecked || !task.ReferenceValidatorChecked) { <p class="text-warning-emphasis" role="status">@SiteResources.ImportReferenceChecksRequired</p> }
                                @foreach (var solution in task.Solutions.Where(s => s.ReplacedIds.Count != 0))
                                {
                                    <p class="small text-warning-emphasis">@string.Format(SiteResources.ImportReferenceReplacement, solution.Filename)</p>
                                }
                            }
                        </fieldset>
                        @if (task.IsChecking)
                        {
                            <p role="status">@CheckProgress(task)</p>
                            <button class="btn btn-outline-secondary mb-3" @onclick="() => StopChecking(task)">@SiteResources.ImportStop</button>
                        }
                        @if (task.CheckError is not null) { <p class="alert alert-danger" role="alert">@task.CheckError</p> }
                        <ImportRunResults Runs="task.Runs" ShowScore="task.Tests.Any(t => t.Score.HasValue)" IsCurrent="task.IsCurrent" />
                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button class="btn btn-warning" disabled="@(task.IsChecking || !task.HasChanges || task.StateErrors.Count != 0 || task.ValidatorErrors.Count != 0 || !task.ValidatorChecked || !task.ReferencesChecked || !task.ReferenceValidatorChecked)" @onclick="ConfirmSaveAsync">@SiteResources.ImportSaveProblem</button>
                            @if (task.Id.HasValue)
                            {
                                @if (task.Validator is { AlreadySaved: false })
                                {
                                    <button class="btn btn-outline-warning" disabled="@task.IsChecking" @onclick="ConfirmValidatorOnlyAsync">@SiteResources.ImportSaveValidatorOnly</button>
                                }
                                <button class="btn btn-outline-secondary" disabled="@task.IsChecking" @onclick="RefreshAsync">@SiteResources.ImportRefresh</button>
                            }
                        </div>
                    </fieldset>
                    @if (_confirmSave)
                    {
                        <div class="alert alert-warning mt-3" role="alert">
                            @if (_validatorOnlyCheck is { } check)
                            {
                                <p>@SiteResources.ImportConfirmValidatorOnly</p>
                                @if (check.RejectedTests.Count != 0) { <p>@string.Format(SiteResources.ImportValidatorOnlyRejected, Numbers(check.RejectedTests))</p> }
                                <details><summary>@SiteResources.StaffRunOutput</summary><pre class="overflow-auto">@check.Result.Log</pre></details>
                            }
                            else
                            {
                            <p>@string.Format(SiteResources.ImportConfirmProblem, task.Label)</p>
                            <ul>
                                @if (task.TestsChanged)
                                {
                                    <li>@SiteResources.StaffTests: @SiteResources.ImportAddedTests @Numbers(task.AddedTests); @SiteResources.ImportChangedTests @Numbers(task.ChangedTests); @SiteResources.ImportRemovedTests @Numbers(task.RemovedTests)</li>
                                }
                                @if (task.Statement != task.Original?.Text) { <li>@SiteResources.ImportStatementChanged</li> }
                                @foreach (var change in ParameterChanges(task))
                                {
                                    <li>@change.Name: @(change.Before ?? "–") → @change.After</li>
                                }
                            </ul>
                            @foreach (var solution in task.Solutions.Where(s => s.Save && !s.AlreadySaved))
                            {
                                <p>@string.Format(solution.ReplacedIds.Count == 0 ? SiteResources.ImportReferenceAddition : SiteResources.ImportReferenceReplacement, solution.Filename)</p>
                            }
                            @if (task.Validator is { Save: true, AlreadySaved: false } validator)
                            {
                                <p>@(validator.ReplacedIds.Count == 0 ? SiteResources.ImportSaveValidator : SiteResources.ImportValidatorReplacement)</p>
                            }
                            }
                            <button class="btn btn-warning" disabled="@_busy" @onclick="SaveAsync">@SiteResources.StaffConfirm</button>
                            <button class="btn btn-outline-secondary ms-2" disabled="@_busy" @onclick="() => _confirmSave = false">@SiteResources.StaffCancel</button>
                        </div>
                    }
                </section>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    [Parameter] public int ContestId { get; set; }
    [SupplyParameterFromQuery(Name = "task")] public string? TaskFolder { get; set; }
    private Olymp.Domain.Models.Contest? _contest;
    private IReadOnlyList<Olymp.Domain.Models.Compilator> _validatorCompilers = [];
    private ContestImportPreview? _preview;
    private ContestImportRow? _selected;
    private ValidatorImportCheck? _validatorOnlyCheck;
    private bool _canImport, _busy, _saving, _confirmSave, _allowExit, _disposed;
    private string? _error, _status, _exitTarget;
    private CancellationTokenSource? _operation;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly Dictionary<ContestImportRow, CancellationTokenSource> _checks = [];
    private bool _validatingAll;
    private int _validatedCount;
    private CancellationTokenSource? _batchOperation;
    private bool AnyChecking => _checks.Count != 0 || _validatingAll;
    private bool HasPending => _preview?.Rows.Any(r => r.HasChanges) == true;
    private Olymp.Domain.Models.Problem PreviewProblem(ContestImportRow row) => new()
    {
        Name = row.Proposed.Name, Number = row.Proposed.Number, TimeLimit = row.TimeLimit,
        MemoryLimit = row.Proposed.MemoryLimit, Text = row.Statement, Contest = _contest!, ContestId = ContestId,
        Checker = null!, Messages = [], Submissions = [], Tests = []
    };
    private static IReadOnlyList<Olymp.Domain.Models.Test> PreviewExamples(ContestImportRow row) =>
        [.. row.Tests.Where(t => t.IsActive && t.IsOpen).OrderBy(t => t.Number)
            .Select(t => new Olymp.Domain.Models.Test { Number = t.Number, Input = t.Input, Output = t.Output, Problem = null! })];
    private string ProblemUrl(ContestImportRow row) => Navigation.GetUriWithQueryParameter("task", row.Folder);
    private static string Numbers(IEnumerable<int> values) => string.Join(", ", values) is { Length: > 0 } text ? text : "–";
    private static string CheckProgress(ContestImportRow row) => row.RunsTotal == 0 ? SiteResources.StaffChecking
        : string.Format(SiteResources.ImportCheckProgress, row.RunsCompleted, row.RunsTotal);
    private static string RowStatus(ContestImportRow row) => row.CheckError is not null || row.StateErrors.Count != 0 ? SiteResources.ImportHasErrors
        : row.IsSaved ? SiteResources.StaffSaved : !row.HasChanges ? SiteResources.ImportUnchanged
        : row.Id.HasValue ? SiteResources.ImportUpdateProblem : SiteResources.ImportNewProblem;
    private static string RowBadgeClass(ContestImportRow row) => row.CheckError is not null || row.StateErrors.Count != 0 ? "text-bg-danger"
        : row.IsSaved ? "text-bg-success" : !row.HasChanges ? "text-bg-secondary"
        : row.Id.HasValue ? "text-bg-warning" : "text-bg-info";
    private static string ValidationStatus(ContestImportRow row) => row.IsValidating ? SiteResources.StaffChecking
        : row.ValidatorPassed is bool passed ? passed ? SiteResources.ImportValidatorPassed : SiteResources.ImportValidatorRejected
        : !row.RequiresValidatorCheck ? SiteResources.ImportValidationNotRequired
        : !row.HasValidator ? SiteResources.ImportNoValidator
        : !row.ValidatorChecked ? SiteResources.ImportValidationPending
        : row.ValidatorErrors.Count != 0 ? SiteResources.ImportHasErrors
        : row.ValidatorWarnings.Count != 0 ? SiteResources.ImportValidationWarnings
        : SiteResources.ImportValidatorPassed;
    private static IEnumerable<(string Name, string? Before, string After)> ParameterChanges(ContestImportRow row)
    {
        var old = row.Previous;
        var next = row.Proposed;
        (string Name, string? Before, string After)[] values =
        [
            (SiteResources.StaffTestNumber, old?.Number.ToString(), next.Number.ToString()),
            (SiteResources.StaffName, old?.Name, next.Name),
            (SiteResources.TimeLimit, old?.TimeLimit.ToString(), next.TimeLimit.ToString()),
            (SiteResources.ImportSlowTimeLimit, old?.SlowTimeLimit.ToString(), next.SlowTimeLimit.ToString()),
            (SiteResources.MemoryLimit, old?.MemoryLimit.ToString(), next.MemoryLimit.ToString()),
            (SiteResources.StaffChecker, old?.CheckerId.ToString(), next.CheckerId.ToString()),
            (SiteResources.StaffActive, old is null ? null : old.IsActive ? SiteResources.StaffYes : SiteResources.StaffNo,
                next.IsActive ? SiteResources.StaffYes : SiteResources.StaffNo)
        ];
        return values.Where(value => value.Before != value.After);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_contest?.Id != ContestId)
        {
            Stop(); _preview = null; _selected = null; _confirmSave = false; _status = null; _error = null; _allowExit = false;
            await using var db = await ContextFactory.CreateDbContextAsync(_lifetime.Token);
            _contest = await db.Contests.SingleOrDefaultAsync(c => c.Id == ContestId, _lifetime.Token);
            _canImport = _contest is not null && (await Authorization.AuthorizeAsync((await AuthenticationState).User, ContestId, PolicyNames.ImportProblems)).Succeeded;
            if (!_canImport) _error = SiteResources.StaffAccessDenied;
        }
        if (_preview is not null)
        {
            var next = _preview.Rows.FirstOrDefault(r => r.Folder == TaskFolder) ?? _preview.Rows.First();
            if (next != _selected)
            {
                _selected = next; _confirmSave = false; _status = null;
            }
        }
    }

    private void SelectProblem(ChangeEventArgs args)
    {
        var row = _preview?.Rows.SingleOrDefault(r => r.Folder == args.Value?.ToString());
        if (row is not null && !_busy) Navigation.NavigateTo(ProblemUrl(row));
    }
    private void LimitsChanged()
    {
        _confirmSave = false; _status = null;
        _selected?.CheckParameters();
    }
    private void SolutionsChanged()
    {
        _confirmSave = false; _status = null;
        if (_selected is not null)
        {
            _selected.CheckError = null;
            _selected.Runs.RemoveAll(run => run.ReferenceId is null
                && _selected.Solutions.Any(solution => solution.Filename == run.File && solution.CompilerId != run.CompilerId));
        }
    }
    private Task SettingsChangedAsync() => ExecuteAsync(async (service, token) =>
    {
        if (_preview is not { } preview) return;
        foreach (var row in preview.Rows)
            await service.PrepareValidationAsync((await AuthenticationState).User, preview, row, token);
    });

    private async Task ValidateAllAsync()
    {
        if (_preview is not { } preview || _busy || AnyChecking || _disposed) return;
        using var operation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _batchOperation = operation;
        _validatingAll = true;
        _validatedCount = 0;
        try
        {
            foreach (var row in preview.Rows)
            {
                if (operation.IsCancellationRequested) break;
                await CheckRowAsync(row, validate: true);
                _validatedCount++;
                await NotifyCheckAsync();
            }
        }
        finally
        {
            _validatingAll = false;
            _batchOperation = null;
        }
    }
    private static int SelectedSolutionCount(ContestImportRow row) => row.Solutions.Count(s => !s.AlreadySaved && (s.Selected || s.Save)) + row.ReferencesToCheck.Count();
    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        if (args.FileCount == 0 || AnyChecking) return;
        await ExecuteAsync(async (service, token) =>
        {
            using var input = args.File.OpenReadStream(ImportOptions.Value.MaxZipBytes, token);
            var preview = await service.PrepareAsync((await AuthenticationState).User, ContestId, input, token);
            await using var db = await ContextFactory.CreateDbContextAsync(token);
            _validatorCompilers = await db.Compilators.AsNoTracking().Where(compiler => compiler.IsActive && compiler.Language == "C++")
                .OrderBy(compiler => compiler.Id).ToListAsync(token);
            foreach (var row in preview.Rows)
            {
                foreach (var solution in row.Solutions) solution.Save = true;
                if (row.Validator is { } validator) validator.Save = true;
            }
            var storedCompilers = preview.Rows.Where(row => row.Validator is { AlreadySaved: true })
                .Select(row => row.Validator!.CompilerId).Distinct().ToArray();
            preview.ValidatorCompilerId = storedCompilers.Length == 1 ? storedCompilers[0] : _validatorCompilers.FirstOrDefault()?.Id;
            foreach (var row in preview.Rows)
                await service.PrepareValidationAsync((await AuthenticationState).User, preview, row, token);
            _preview = preview;
            _selected = preview.Rows.First();
        }, updateSelection: true);
    }
    private Task CheckValidatorAsync() => _selected is { } row ? CheckRowAsync(row, validate: true) : Task.CompletedTask;

    private async Task CheckRowAsync(ContestImportRow row, bool force = false, bool validate = false)
    {
        if (_preview is not { } preview || _busy || _disposed || row.IsChecking) return;
        using var operation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token, _batchOperation?.Token ?? CancellationToken.None);
        _checks.Add(row, operation);
        row.IsChecking = true;
        row.IsValidating = validate;
        row.RunsCompleted = row.RunsTotal = 0;
        row.CheckError = null;
        if (_selected == row) _confirmSave = false;
        await NotifyCheckAsync();
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var service = scope.ServiceProvider.GetRequiredService<ContestImportService>();
            var actor = (await AuthenticationState).User;
            if (validate) await service.EnsureValidatorAsync(actor, preview, row, operation.Token);
            else await service.RunSolutionsAsync(actor, preview, row, NotifyCheckAsync, force, operation.Token);
        }
        catch (OperationCanceledException) when (operation.IsCancellationRequested) { }
        catch (Exception ex) when (ex is OperationValidationException or InvalidDataException or IOException)
        {
            row.CheckError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Contest problem checks failed for {Folder}", row.Folder);
            row.CheckError = SiteResources.ImportFailed;
        }
        finally
        {
            row.IsChecking = false;
            row.IsValidating = false;
            _checks.Remove(row);
            await NotifyCheckAsync();
        }
    }

    private Task NotifyCheckAsync() => _disposed ? Task.CompletedTask : InvokeAsync(StateHasChanged);

    private async Task RefreshAsync()
    {
        if (_preview is not { } preview || _selected is not { } row || row.IsChecking) return;
        await ExecuteAsync(async (service, token) => await service.RefreshAsync((await AuthenticationState).User, preview, row, token));
        await SettingsChangedAsync();
    }
    private Task RunSolutionsAsync() => _selected is { } row ? CheckRowAsync(row) : Task.CompletedTask;
    private Task RerunSolutionsAsync() => _selected is { } row ? CheckRowAsync(row, true) : Task.CompletedTask;
    private Task ConfirmSaveAsync() => ExecuteAsync(async (service, token) =>
    {
        if (_preview is null || _selected is null || _selected.IsChecking) return;
        await service.PrepareValidationAsync((await AuthenticationState).User, _preview, _selected, token);
        ContestImportService.ValidateReferenceSelection(_selected);
        if (!_selected.ReferencesChecked || !_selected.ReferenceValidatorChecked)
            throw new OperationValidationException(SiteResources.ImportReferenceChecksRequired);
        _confirmSave = _selected.Errors.Count == 0;
    });
    private Task SaveAsync() => ExecuteAsync(async (service, token) =>
    {
        if (_preview is null || _selected is null || _selected.IsChecking || !_confirmSave) return;
        _saving = true;
        if (_validatorOnlyCheck is { } check)
        {
            await service.SaveValidatorOnlyAsync((await AuthenticationState).User, check, token);
            _selected.ValidatorKey = null;
            await service.RefreshAsync((await AuthenticationState).User, _preview, _selected, token);
            _confirmSave = false; _validatorOnlyCheck = null;
            _status = SiteResources.ImportValidatorOnlySaved;
            return;
        }
        await service.SaveAsync((await AuthenticationState).User, _preview, _selected, token);
        _confirmSave = false;
        _status = string.Format(SiteResources.ImportProblemSaved, _selected.Label);
    }, keepConfirmation: true);

    private Task ConfirmValidatorOnlyAsync() => ExecuteAsync(async (service, token) =>
    {
        if (_preview is null || _selected is null || _selected.IsChecking) return;
        _validatorOnlyCheck = await service.CheckValidatorOnlyAsync((await AuthenticationState).User, _preview, _selected, token);
        _confirmSave = true;
    });

    private async Task ExecuteAsync(Func<ContestImportService, CancellationToken, Task> action, bool updateSelection = false, bool keepConfirmation = false)
    {
        if (_busy || _disposed) return;
        _busy = true; _error = null; _status = null;
        if (!keepConfirmation) { _confirmSave = false; _validatorOnlyCheck = null; }
        using var operation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _operation = operation;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await action(scope.ServiceProvider.GetRequiredService<ContestImportService>(), operation.Token);
        }
        catch (OperationCanceledException) { _confirmSave = false; }
        catch (Exception ex) when (ex is OperationValidationException or InvalidDataException or System.Text.Json.JsonException or IOException)
        {
            _confirmSave = false; _error = ex.Message;
        }
        catch (Exception ex) { _confirmSave = false; Logger.LogError(ex, "Contest problem import failed"); _error = SiteResources.ImportFailed; }
        finally { _busy = false; _saving = false; _operation = null; }
        if (updateSelection && _selected is not null && !_disposed)
            Navigation.NavigateTo(ProblemUrl(_selected), replace: true);
    }

    private void BeforeNavigation(LocationChangingContext context)
    {
        bool samePage = Navigation.ToAbsoluteUri(context.TargetLocation).AbsolutePath.Equals($"/jury/contests/{ContestId}/import", StringComparison.OrdinalIgnoreCase);
        if (_allowExit) return;
        if (samePage) { if (_busy) context.PreventNavigation(); return; }
        if (HasPending || _busy || AnyChecking) { context.PreventNavigation(); _exitTarget = context.TargetLocation; }
    }
    private void Finish()
    {
        if (HasPending || _busy || AnyChecking) _exitTarget = $"jury/contests/{ContestId}/problems";
        else { _allowExit = true; Navigation.NavigateTo($"jury/contests/{ContestId}/problems"); }
    }
    private void Leave()
    {
        Stop(); _allowExit = true;
        Navigation.NavigateTo(_exitTarget ?? $"jury/contests/{ContestId}/problems");
    }
    private void StopChecking(ContestImportRow row)
    {
        if (_checks.TryGetValue(row, out var operation)) operation.Cancel();
    }
    private void Stop()
    {
        _operation?.Cancel();
        _batchOperation?.Cancel();
        foreach (var operation in _checks.Values.ToArray()) operation.Cancel();
    }
    public ValueTask DisposeAsync() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); return ValueTask.CompletedTask; }
}
