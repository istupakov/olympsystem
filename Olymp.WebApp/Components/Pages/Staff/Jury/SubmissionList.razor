@page "/jury/submissions"
@page "/jury/contests/{ContestId:int}/submissions"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using Olymp.WebApp.Components.Submissions
@using Olymp.WebApp.Services.Checker
@inject IDbContextFactory<OlympContext> ContextFactory
@inject NavigationManager Navigation
@inject ICheckerManager Checkers
@inject StaffGridState GridState

<PageTitle>@SiteResources.Submissions</PageTitle>
@if (!_loaded || (ContestId is not null && _contest is null))
{
    <p role="status">@(_loaded ? SiteResources.PageNotFoundMessage : SiteResources.StaffLoading)</p>
}
else
{
    @if (ContestId is not null && _contest is not null)
    {
        <StaffContestNavigation ContestId="_contest.Id" ContestName="@_contest.Name" IsHidden="_contest.IsHidden" />
    }
    <h1 class="h3">@SiteResources.Submissions</h1>
    <EditForm Model="_filters" OnValidSubmit="ApplyFilters" class="row g-3 mb-4">
        @if (ContestId is null)
        {
            <div class="col-12">
                <label for="contest-filter" class="form-label">@SiteResources.StaffContest</label>
                <InputSelect @key="_contests" id="contest-filter" class="form-select" @bind-Value="_filters.Contest" @bind-Value:after="SelectContestAsync">
                    <option value="">@SiteResources.StaffAll</option>
                    @if (Contest is int missingContest && !_contests.Any(item => item.Id == missingContest)) { <option value="@missingContest">@StaffEntityLabel.Format(missingContest, null)</option> }
                    @foreach (var contest in _contests)
                    {
                        <option value="@contest.Id">@StaffEntityLabel.Format(contest.Id, contest.Name)</option>
                    }
                </InputSelect>
            </div>
        }
        <div class="col-md-6 col-xl-3">
            <label for="author" class="form-label">@SiteResources.SubmissionAuthor</label>
            @if (AuthorId is int authorId)
            {
                <input id="author" class="form-control" readonly value="@_authorName" />
            }
            else { <InputText id="author" class="form-control" @bind-Value="_filters.Author" /> }
        </div>
        <div class="col-md-6 col-xl-3">
            <label for="problem" class="form-label">@SiteResources.Problem</label>
            @if (FormContest is null)
            {
                @if (_filters.Problem is not null) { <input id="problem" class="form-control" readonly value="@_problemName" /> }
                else { <InputText id="problem" class="form-control" @bind-Value="_filters.ProblemSearch" placeholder="@SiteResources.StaffProblemSearch" /> }
            }
            else
            {
                <InputSelect @key="_problems" id="problem" class="form-select" @bind-Value="_filters.Problem">
                <option value="">@SiteResources.StaffAll</option>
                @if (_filters.Problem is int missingProblem && !_problems.Any(item => item.Id == missingProblem)) { <option value="@missingProblem">@_problemName</option> }
                @foreach (var problem in _problems) { <option value="@problem.Id">@StaffEntityLabel.Format(problem.Id, problem.NameWithNumber)</option> }
                </InputSelect>
            }
        </div>
        <div class="col-md-6 col-xl-3">
            <label for="language" class="form-label">@SiteResources.StaffLanguage</label>
            <InputSelect id="language" class="form-select" @bind-Value="_filters.Language">
                <option value="">@SiteResources.StaffAll</option>
                @foreach (var language in _languages) { <option value="@language">@language</option> }
            </InputSelect>
        </div>
        <div class="col-md-6 col-xl-3">
            <label for="status" class="form-label">@SiteResources.SubmissionStatus</label>
            <InputSelect id="status" class="form-select" @bind-Value="_filters.Status">
                <option value="">@SiteResources.StaffAll</option>
                <option value="accepted">@SiteResources.StaffVerdictAccepted</option>
                <option value="rejected">@SiteResources.StaffAnyError</option>
                <option value="compilation">@SiteResources.StaffVerdictCompilation</option>
                <option value="wrong-answer">@SiteResources.StaffVerdictWrongAnswer</option>
                <option value="time-limit">@SiteResources.StaffVerdictTimeLimit</option>
                <option value="runtime-error">@SiteResources.StaffVerdictRuntimeError</option>
                <option value="presentation-error">@SiteResources.StaffVerdictPresentationError</option>
                <option value="idleness-limit">@SiteResources.StaffVerdictIdlenessLimit</option>
                <option value="memory-limit">@SiteResources.StaffVerdictMemoryLimit</option>
                <option value="internal-error">@CheckStatusCodes.Template(-10)</option>
                <option value="queued">@CheckStatusCodes.Template(0)</option>
                <option value="checking">@CheckStatusCodes.Template(1)</option>
            </InputSelect>
        </div>
        <div class="col-md-6">
            <label for="from" class="form-label">@SiteResources.StaffDateFrom</label>
            <InputDate id="from" Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_filters.From" ParsingErrorMessage="@SiteResources.InvalidDate" />
        </div>
        <div class="col-md-6">
            <label for="to" class="form-label">@SiteResources.StaffDateTo</label>
            <InputDate id="to" Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_filters.To" ParsingErrorMessage="@SiteResources.InvalidDate" />
        </div>
        <div class="col-md-6">
            <label for="submission-authors" class="form-label">@SiteResources.StaffSubmissionAuthors</label>
            <InputSelect id="submission-authors" class="form-select" @bind-Value="_filters.Scope">
                <option value="all">@SiteResources.StaffAll</option>
                <option value="own">@SiteResources.OwnSubmissions</option>
                <option value="participants">@SiteResources.ContestParticipants</option>
                <option value="hidden">@SiteResources.StaffJuryAuthors</option>
            </InputSelect>
        </div>
        <div class="col-12 d-flex flex-wrap gap-2">
            <button class="btn btn-primary">@SiteResources.StaffFind</button>
            <a class="btn btn-outline-secondary" href="@BaseUrl">@SiteResources.StaffReset</a>
            <button type="button" class="btn btn-outline-secondary" @onclick="RefreshGrid">@SiteResources.Refresh</button>
            <a class="btn btn-outline-secondary" href="@($"jury/anticheat?Selection={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}")">@SiteResources.StaffAnalyzeSelection</a>
        </div>
    </EditForm>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <ActiveFilter Name="AuthorId" Label="@SiteResources.SubmissionAuthor" Value="@_authorName" Clear="@(new[] { nameof(Author) })" />
        <ActiveFilter Name="Author" Label="@SiteResources.SubmissionAuthor" Value="@(AuthorId is null ? Author : null)" />
        <ActiveFilter Name="Problem" Label="@SiteResources.Problem" Value="@_problemName" Clear="@(new[] { nameof(ProblemSearch) })" />
        <ActiveFilter Name="ProblemSearch" Label="@SiteResources.Problem" Value="@(Problem is null ? ProblemSearch : null)" />
        <ActiveFilter Name="Compiler" Label="@SiteResources.Compiler" Value="@_compilerName" />
        <ActiveFilter Name="Language" Label="@SiteResources.StaffLanguage" Value="@Language" />
        <ActiveFilter Name="IpAddress" Label="@SiteResources.IpAddress" Value="@IpAddress" />
        <ActiveFilter Name="Contest" Label="@SiteResources.StaffContest" Value="@(ContestId is null && Contest is int selectedContestFilter ? StaffEntityLabel.Format(selectedContestFilter, _contest?.Name) : null)" Clear="@(new[] { nameof(Problem), nameof(ProblemSearch) })" />
        <ActiveFilter Name="Scope" Label="@SiteResources.StaffSubmissionAuthors" Value="@(EffectiveScope == "own" ? SiteResources.OwnSubmissions : EffectiveScope == "participants" ? SiteResources.ContestParticipants : EffectiveScope == "hidden" ? SiteResources.StaffJuryAuthors : null)" Clear="@(new[] { nameof(OnlyParticipants) })" />
        <ActiveFilter Name="Status" Label="@SiteResources.SubmissionStatus" Value="@(Status is not null ? _statusLabel : null)" />
        <ActiveFilter Name="StatusCode" Label="@SiteResources.SubmissionStatus" Value="@(StatusCode is int exactStatus ? CheckStatusCodes.Description(exactStatus) : null)" />
        <ActiveFilter Name="From" Label="@SiteResources.StaffDateFrom" Value="@From?.ToString("g")" />
        <ActiveFilter Name="To" Label="@SiteResources.StaffDateTo" Value="@To?.ToString("g")" />
    </div>
    <p class="small text-body-secondary">@SiteResources.ServerTimeZone: @TimeZoneInfo.Local.Id</p>
    @if (_error is not null) { <p class="alert alert-danger" role="alert">@_error</p> }
    @if (_canRetest && Retest)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button class="btn btn-outline-warning" disabled="@(_busy || _error is not null)" @onclick="PrepareRetestAsync">@SiteResources.StaffRetestFiltered</button>
            <a class="btn btn-outline-secondary" href="@StaffFilterUrl.Set(Navigation.Uri, nameof(Retest), null)">@SiteResources.StaffHideRetest</a>
        </div>
        @if (_retestTotal is int total)
        {
            <section class="card mb-3" aria-label="@SiteResources.StaffRetestFiltered">
                <div class="card-body">
                    <p>@string.Format(SiteResources.StaffRetestConfirm, total)</p>
                    @if (_retestAccepted > 0)
                    {
                        <div class="alert alert-warning" role="alert">@string.Format(SiteResources.StaffRetestAcceptedWarning, _retestAccepted)</div>
                    }
                    <button class="btn btn-warning" disabled="@(_busy || total == 0)" @onclick="RetestAsync">@SiteResources.StaffConfirm</button>
                    <button class="btn btn-outline-secondary ms-2" disabled="@_busy" @onclick="() => _retestTotal = null">@SiteResources.StaffCancel</button>
                </div>
            </section>
        }
    }
    @if (_notice is not null)
    {
        <p class="alert alert-info" role="status">@_notice</p>
    }
    @if (_error is null)
    {
        <StaffGrid @key="_gridVersion" TGridItem="StaffSubmissionListItem" Query="Query" ItemKey="@(item => item.Id)" OrderKey="@(item => item.Id)" EmptyText="@SiteResources.NoSubmissions">
            <TemplateColumn Title="ID" SortBy="_idSort" Sortable="true" Context="item">
                <a href="@DetailsUrl(item.Id)">@item.Id</a>
            </TemplateColumn>
            <TemplateColumn Title="@SiteResources.SubmissionTime" SortBy="_dateSort" Sortable="true" Context="item">@item.CommitTime.ToLocalTime().ToString("g")</TemplateColumn>
            <TemplateColumn Title="@SiteResources.SubmissionAuthor" SortBy="_authorSort" Sortable="true" Context="item">
                <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(AuthorId), item.AuthorId, nameof(Author))" Label="@SiteResources.SubmissionAuthor" Value="@item.Author">
                    @if (item.AuthorContestId is int authorContest) { <a href="@GridState.DetailUrl(Navigation.Uri, $"jury/contests/{authorContest}/participants/{item.AuthorId}", item.Id)">@item.Author</a> }
                    else if (_canRetest) { <a href="@GridState.DetailUrl(Navigation.Uri, $"admin/users/{item.AuthorId}/edit", item.Id)">@item.Author</a> }
                    else { @item.Author }
                </QuickFilter>
                @if (item.IsParticipant) { <span class="badge text-bg-secondary">@(item.IsTeam ? SiteResources.StaffTeam : SiteResources.Competitor)</span> }
            </TemplateColumn>
            <TemplateColumn Title="@SiteResources.Problem" SortBy="_problemSort" Sortable="true" Context="item">
                <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(Problem), item.ProblemId, nameof(ProblemSearch))" Label="@SiteResources.Problem" Value="@item.Problem"><a href="jury/contests/@item.ContestId/problems?problemId=@item.ProblemId">@item.Problem</a></QuickFilter>
                @if (ContestId is null)
                {
                    <div class="small text-body-secondary"><QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(Contest), item.ContestId, nameof(Problem), nameof(ProblemSearch))" Label="@SiteResources.StaffContest" Value="@item.Contest"><a class="link-secondary" href="jury/contests/@item.ContestId">@item.Contest</a></QuickFilter></div>
                }
            </TemplateColumn>
            <TemplateColumn Title="@SiteResources.Compiler" SortBy="_compilerSort" Sortable="true" Context="item">
                <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(Compiler), item.CompilerId)" Label="@SiteResources.Compiler" Value="@item.Compiler">
                    <a href="@GridState.DetailUrl(Navigation.Uri, $"jury/compilers/{item.CompilerId}", item.Id)">@item.Compiler</a>
                </QuickFilter>
            </TemplateColumn>
            <TemplateColumn Title="@SiteResources.SubmissionStatus" Context="item">
                @if (item.StatusCode is int code)
                {
                    <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(StatusCode), code, nameof(Status))" Label="@SiteResources.SubmissionStatus" Value="@CheckStatusCodes.Description(code)">
                        @if (code == -1) { <a href="@(DetailsUrl(item.Id) + "#compilation-errors")"><SubmissionStatus StatusCode="code" /></a> }
                        else { <SubmissionStatus StatusCode="code" /> }
                    </QuickFilter>
                }
                @if (item.IsHidden) { <div class="badge text-bg-secondary">@SiteResources.StaffHiddenSubmission</div> }
                @if (item.IsReference) { <div class="badge text-bg-info">@SiteResources.StaffReferenceSubmission</div> }
            </TemplateColumn>
            <PropertyColumn Property="@(item => item.Score)" Title="@SiteResources.Points" Sortable="true" />
            <TemplateColumn Title="@SiteResources.IpAddress" Context="item">
                @(string.IsNullOrWhiteSpace(item.IpAddress) ? "–" : item.IpAddress)
                @if (!string.IsNullOrWhiteSpace(item.IpAddress))
                {
                    <QuickFilter Url="@StaffFilterUrl.Set(Navigation.Uri, nameof(IpAddress), item.IpAddress)" Label="@SiteResources.IpAddress" Value="@item.IpAddress" />
                }
            </TemplateColumn>
        </StaffGrid>
    }
}

@code {
    [Parameter]
    public int? ContestId { get; set; }
    [SupplyParameterFromQuery]
    public int? Contest { get; set; }
    [SupplyParameterFromQuery]
    public string? Author { get; set; }
    [SupplyParameterFromQuery]
    public int? AuthorId { get; set; }
    [SupplyParameterFromQuery]
    public int? Problem { get; set; }
    [SupplyParameterFromQuery]
    public int? Compiler { get; set; }
    [SupplyParameterFromQuery] public string? Language { get; set; }
    [SupplyParameterFromQuery] public string? IpAddress { get; set; }
    [SupplyParameterFromQuery] public string? ProblemSearch { get; set; }
    [SupplyParameterFromQuery]
    public string? Status { get; set; }
    [SupplyParameterFromQuery] public int? StatusCode { get; set; }
    [SupplyParameterFromQuery] public bool Retest { get; set; }
    [SupplyParameterFromQuery]
    public DateTime? From { get; set; }
    [SupplyParameterFromQuery]
    public DateTime? To { get; set; }
    [SupplyParameterFromQuery]
    public bool OnlyParticipants { get; set; }
    [SupplyParameterFromQuery]
    public string? Scope { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private int? EffectiveContest => ContestId ?? Contest;
    private int? FormContest => ContestId ?? _filters.Contest;
    private string BaseUrl => ContestId is int id ? $"jury/contests/{id}/submissions" : "jury/submissions";
    private string EffectiveScope => Scope ?? (OnlyParticipants ? "participants" : "all");
    private Contest? _contest;
    private List<Contest> _contests = [];
    private List<Problem> _problems = [];
    private List<string> _languages = [];
    private Filters _filters = new();
    private bool _loaded;
    private int _gridVersion;
    private readonly GridSort<StaffSubmissionListItem> _idSort = GridSort<StaffSubmissionListItem>.ByAscending(item => item.Id);
    private readonly GridSort<StaffSubmissionListItem> _dateSort = GridSort<StaffSubmissionListItem>.ByAscending(item => item.CommitTime);
    private readonly GridSort<StaffSubmissionListItem> _authorSort = GridSort<StaffSubmissionListItem>.ByAscending(item => item.Author);
    private readonly GridSort<StaffSubmissionListItem> _problemSort = GridSort<StaffSubmissionListItem>.ByAscending(item => item.Problem);
    private readonly GridSort<StaffSubmissionListItem> _compilerSort = GridSort<StaffSubmissionListItem>.ByAscending(item => item.Compiler);
    internal IQueryable<StaffSubmissionListItem> Query(OlympContext db) => FilteredQuery(db)
        .AsStaffRows(db, EffectiveContest).OrderByDescending(item => item.CommitTime).ThenByDescending(item => item.Id);
    private bool _canRetest;
    private bool _busy;
    private int _userId;
    private int? _retestTotal;
    private int[] _retestAcceptedIds = [];
    private int _retestAccepted => _retestAcceptedIds.Length;
    private int _retestMaxId;
    private string? _error;
    private string? _notice;
    private string? _authorName;
    private string? _compilerName, _problemName, _statusLabel;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _error = _authorName = _notice = null;
        _retestTotal = null;
        _filters = new() { Contest = Contest, Author = Author, Problem = Problem, ProblemSearch = ProblemSearch, Language = Language, Status = Status, From = From, To = To, Scope = EffectiveScope };
        _compilerName = _problemName = null;
        _statusLabel = StaffVerdicts.Label(Status);
        var user = (await AuthenticationState).User;
        _canRetest = user.IsInRole(RoleNames.Admin);
        int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out _userId);
        await using var db = await ContextFactory.CreateDbContextAsync();
        if (AuthorId is int selectedAuthor)
            _authorName = StaffEntityLabel.Format(selectedAuthor, await db.Users.Where(item => item.Id == selectedAuthor).Select(item => item.Name).SingleOrDefaultAsync());
        if (Compiler is int selectedCompiler)
            _compilerName = StaffEntityLabel.Format(selectedCompiler, await db.Compilators.Where(item => item.Id == selectedCompiler).Select(item => item.Description ?? item.Name).SingleOrDefaultAsync());
        if (Problem is int selectedProblem)
            _problemName = StaffEntityLabel.Format(selectedProblem, await db.Problems.Where(item => item.Id == selectedProblem).Select(item => item.Number.ToString() + ". " + item.Name).SingleOrDefaultAsync());
        _contest = EffectiveContest is int selectedContest
            ? await db.Contests.AsNoTracking().SingleOrDefaultAsync(item => item.Id == selectedContest) : null;
        if (ContestId is null)
            _contests = await db.Contests.AsNoTracking().OrderByDescending(item => item.StartTime).ToListAsync();
        if (EffectiveContest is null || _contest is not null)
        {
            _problems = EffectiveContest is null ? [] : await db.Problems.AsNoTracking()
                .Where(item => item.ContestId == EffectiveContest).OrderBy(item => item.Number).ToListAsync();
            _languages = await db.Submissions.Where(item => EffectiveContest == null || item.Problem.ContestId == EffectiveContest)
                .Select(item => item.Compilator.Language).Distinct().OrderBy(item => item).ToListAsync();
            RefreshGrid();
        }
        _loaded = true;
    }

    private IQueryable<Submission> FilteredQuery(OlympContext db) => new StaffSubmissionFilter(EffectiveContest, AuthorId, Author,
        Problem, ProblemSearch, Compiler, Language, IpAddress, EffectiveScope, StatusCode, Status, From, To).Apply(db, _userId);

    private void RefreshGrid()
    {
        if (From > To) _error = SiteResources.StaffInvalidPeriod;
        _gridVersion++;
    }

    private IQueryable<Submission> RetestQuery(OlympContext db) => FilteredQuery(db)
        .Where(item => item.Id <= _retestMaxId && item.Problem.IsActive && item.StatusCode != 0 && item.StatusCode != 1);

    private async Task PrepareRetestAsync()
    {
        if (!Retest || _busy || !(await Authorization.AuthorizeAsync((await AuthenticationState).User, PolicyNames.Admin)).Succeeded)
            return;
        _busy = true;
        _notice = null;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            _retestMaxId = await FilteredQuery(db).MaxAsync(item => (int?)item.Id) ?? 0;
            _retestTotal = await RetestQuery(db).CountAsync();
            _retestAcceptedIds = await RetestQuery(db).Where(item => item.StatusCode == 2).Select(item => item.Id).ToArrayAsync();
        }
        catch (ArgumentException)
        {
            _error = SiteResources.StaffInvalidPeriod;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RetestAsync()
    {
        if (!Retest || _retestTotal is null || _busy || !(await Authorization.AuthorizeAsync((await AuthenticationState).User, PolicyNames.Admin)).Succeeded)
            return;
        _busy = true;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            int? count = await Checkers.QueueRetestAsync(RetestQuery(db), _retestAcceptedIds);
            if (count is null)
            {
                _retestTotal = await RetestQuery(db).CountAsync();
                _retestAcceptedIds = await RetestQuery(db).Where(item => item.StatusCode == 2).Select(item => item.Id).ToArrayAsync();
                _notice = SiteResources.StaffRetestChanged;
                return;
            }
            _retestTotal = null;
            _notice = string.Format(SiteResources.StaffRetestQueued, count);
            RefreshGrid();
        }
        catch (Exception exception) when (exception is System.Data.Common.DbException or DbUpdateException)
        {
            _error = SiteResources.StaffSaveFailed;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectContestAsync()
    {
        var filters = _filters;
        int? contest = FormContest;
        filters.Problem = null;
        filters.ProblemSearch = null;
        await using var db = await ContextFactory.CreateDbContextAsync();
        var problems = contest is null ? new List<Problem>() : await db.Problems.AsNoTracking()
            .Where(item => item.ContestId == contest).OrderBy(item => item.Number).ToListAsync();
        if (ReferenceEquals(filters, _filters) && contest == FormContest) _problems = problems;
    }

    private void ApplyFilters() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> {
        [nameof(Contest)] = ContestId.HasValue ? null : _filters.Contest,
        [nameof(Author)] = AuthorId is null ? _filters.Author : null,
        [nameof(Problem)] = _filters.Problem,
        [nameof(ProblemSearch)] = _filters.Problem is null && FormContest is null ? _filters.ProblemSearch : null,
        [nameof(Language)] = _filters.Language,
        [nameof(StatusCode)] = _filters.Status == Status ? StatusCode : null,
        [nameof(Status)] = _filters.Status, [nameof(OnlyParticipants)] = null, [nameof(Scope)] = _filters.Scope == "all" ? null : _filters.Scope, [nameof(From)] = _filters.From, [nameof(To)] = _filters.To, ["Page"] = null, ["row"] = null
    }));
    private string DetailsUrl(int id) => GridState.DetailUrl(Navigation.Uri, $"jury/submissions/{id}", id);

    private sealed class Filters {
        public int? Contest { get; set; }
        public string? Author { get; set; }
        public int? Problem { get; set; }
        public string? Language { get; set; }
        public string? ProblemSearch { get; set; }
        public string? Status { get; set; }
        public DateTime? From { get; set; }
        public DateTime? To { get; set; }
        public string Scope { get; set; } = "all";
    }
}
