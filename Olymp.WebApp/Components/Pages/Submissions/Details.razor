@page "/submissions/{Id:int}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@using Olymp.WebApp.Components.Submissions

@attribute [Authorize]
@inject NavigationManager Navigation
@inject IDbContextFactory<OlympContext> ContextFactory
@inject IAuthorizationService Authorization

<PageTitle>@SiteResources.SubmissionSource</PageTitle>

@if (submission is not null)
{
    <h1>@SiteResources.SubmissionSource #@submission.Id</h1>
    <dl class="row">
        <dt class="col-sm-3">@SiteResources.SubmissionAuthor</dt>
        <dd class="col-sm-9 text-break">@submission.User.Name</dd>
        <dt class="col-sm-3">@SiteResources.SubmissionContest</dt>
        <dd class="col-sm-9 text-break">@submission.Problem.Contest.Name</dd>
        <dt class="col-sm-3">@SiteResources.Problem</dt>
        <dd class="col-sm-9 text-break"><a href="contests/@submission.Problem.ContestId/problems?problemId=@submission.ProblemId#submissions">@submission.Problem.NameWithNumber</a></dd>
        <dt class="col-sm-3">@SiteResources.Compiler</dt>
        <dd class="col-sm-9 text-break">@(string.IsNullOrWhiteSpace(submission.Compilator.Description) ? submission.Compilator.Name : submission.Compilator.Description)</dd>
        <dt class="col-sm-3">@SiteResources.SubmissionTime</dt>
        <dd class="col-sm-9">@submission.CommitTime.ToLocalTime().ToString("g")</dd>
    </dl>
    <SubmissionView Submission="submission" DownloadUrl="@($"submissions/{submission.Id}/download")" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private Submission? submission;

    protected override async Task OnParametersSetAsync()
    {
        var token = HttpContext.RequestAborted;
        await using var context = await ContextFactory.CreateDbContextAsync(token);
        submission = await context.Submissions.AsNoTracking()
            .Include(item => item.Problem).ThenInclude(item => item.Contest)
            .Include(item => item.Compilator)
            .Include(item => item.User)
            .SingleOrDefaultAsync(item => item.Id == Id, token);
        if (submission is null || !(await Authorization.AuthorizeAsync(HttpContext.User, submission,
            new ViewSolutionRequirement())).Succeeded)
        {
            submission = null;
            Navigation.NotFound();
            return;
        }
    }
}
