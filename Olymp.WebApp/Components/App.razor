@using Olymp.WebApp.Components.Account
@inject IdentityFeatures Features

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    <script src="@Assets["theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/highlightjs/github.min.css"]" data-highlight-theme="light" media="not all" />
    <link rel="stylesheet" href="@Assets["lib/highlightjs/github-dark.min.css"]" data-highlight-theme="dark" media="not all" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Olymp.WebApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <HeadOutlet @rendermode="HeadRenderMode" />
</head>

<body>
    @if (IsStaffRoute)
    {
        <noscript>
            <div class="container my-4">
                <p class="alert alert-warning" role="alert">@SiteResources.StaffJavaScriptRequired</p>
            </div>
        </noscript>
    }
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @if (Features.PasskeysEnabled)
    {
        <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    }
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool IsStaffRoute =>
        HttpContext.Request.Path.StartsWithSegments("/jury", StringComparison.OrdinalIgnoreCase)
        || HttpContext.Request.Path.StartsWithSegments("/admin", StringComparison.OrdinalIgnoreCase);

    private IComponentRenderMode? HeadRenderMode =>
        IsStaffRoute ? new InteractiveServerRenderMode(prerender: false) : null;
}
