@{
    var isRussian = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru";
}

<footer class="border-top text-body-secondary py-3 small flex-shrink-0">
    <div class="container">
        <div class="row gy-3">
            <div class="col-md-5">
                <div class="mb-1">
                    &copy; 2010–@DateTimeOffset.Now.Year
                    <a class="link-body-emphasis link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" href="@(isRussian ? "https://nstu.ru" : "https://en.nstu.ru")">@(isRussian ? "НГТУ" : "NSTU")</a>
                </div>
                <a class="link-body-emphasis link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" href="https://ami.nstu.ru">@(isRussian ? "Факультет прикладной математики и информатики" : "Applied Mathematics and Computer Science")</a>
            </div>
            <div class="col-md-5 d-flex flex-column align-items-start gap-2">
                <a class="link-body-emphasis link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover d-inline-flex align-items-center gap-2" href="https://t.me/olymp_nstu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0" aria-hidden="true" focusable="false">
                        <path d="m22 2-7 20-4-9-9-4Z" />
                        <path d="M22 2 11 13" />
                    </svg>
                    <span>@(isRussian ? "Новости и обсуждения в Telegram" : "News and discussions on Telegram")</span>
                </a>
                <div class="d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0" aria-hidden="true" focusable="false">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 6 9 7 9-7" />
                    </svg>
                    <span>@(isRussian ? "Поддержка" : "Support"): <a class="link-body-emphasis link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" href="mailto:olymp@ami.nstu.ru">olymp@ami.nstu.ru</a></span>
                </div>
            </div>
            <div class="col-md-2 d-flex flex-column align-items-start align-items-md-end gap-2">
                <a class="link-body-emphasis link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover d-inline-flex align-items-center gap-2" href="contacts">
                    <span>@SiteResources.Contacts</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 text-body-secondary" aria-hidden="true" focusable="false">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <circle cx="9" cy="10" r="2" />
                        <path d="M5 17a4 4 0 0 1 8 0M16 9h2M16 13h2" />
                    </svg>
                </a>
                <a class="link-body-emphasis link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover d-inline-flex align-items-center gap-2" href="https://github.com/istupakov/olympsystem">
                    <span>GitHub</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>
