<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" class="position-absolute" aria-hidden="true" focusable="false">
    <defs>
        <symbol id="theme-light" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </symbol>
        <symbol id="theme-dark" viewBox="0 0 24 24">
            <path d="M20.5 13.5A9 9 0 0 1 10.5 3.5a9 9 0 1 0 10 10Z" />
        </symbol>
        <symbol id="theme-auto" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none" />
        </symbol>
    </defs>
</svg>
@{
    var autoLabel = string.Format(SiteResources.ThemeSwitchHint, SiteResources.SystemTheme, SiteResources.LightTheme);
    var lightLabel = string.Format(SiteResources.ThemeSwitchHint, SiteResources.LightTheme, SiteResources.DarkTheme);
    var darkLabel = string.Format(SiteResources.ThemeSwitchHint, SiteResources.DarkTheme, SiteResources.SystemTheme);
}

<button class="nav-link text-body-secondary border-0 bg-transparent p-2" type="button" data-theme-toggle
        data-label-auto="@autoLabel" data-label-light="@lightLabel" data-label-dark="@darkLabel"
        aria-label="@autoLabel" title="@autoLabel">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <use href="#theme-auto" data-theme-icon />
    </svg>
</button>
