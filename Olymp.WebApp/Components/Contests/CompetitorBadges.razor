@if (User is Competitor { IsApproved: false })
{
    <span class="badge text-bg-info">@SiteResources.PendingApproval</span>
}
else if (ShowApproved)
{
    <span class="badge text-bg-success">@SiteResources.RegistrationApproved</span>
}
@if (User is Competitor { IsOutOfCompetition: true })
{
    <span class="badge text-bg-warning">@SiteResources.OutOfCompetition</span>
}
@if (User.IsDisqualified)
{
    <span class="badge text-bg-danger">@SiteResources.Disqualified</span>
}

@code {
    [Parameter, EditorRequired]
    public User User { get; set; } = default!;

    [Parameter]
    public bool ShowApproved { get; set; } = true;
}
