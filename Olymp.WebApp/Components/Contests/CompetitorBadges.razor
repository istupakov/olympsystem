@if (User is Competitor { IsApproved: false })
{
    <span class="badge text-bg-info ms-1">@SiteResources.PendingApproval</span>
}
@if (User is Competitor { IsOutOfCompetition: true })
{
    <span class="badge text-bg-warning ms-1">@SiteResources.OutOfCompetition</span>
}
@if (User.IsDisqualified)
{
    <span class="badge text-bg-danger ms-1">@SiteResources.Disqualified</span>
}

@code {
    [Parameter, EditorRequired]
    public User User { get; set; } = default!;
}
