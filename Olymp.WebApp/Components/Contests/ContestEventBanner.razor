@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@inject IDbContextFactory<OlympContext> ContextFactory

@if (contests.Count > 0)
{
    <section class="bg-body-tertiary border-top" aria-label="@SiteResources.ContestToday">
        <div class="container-xxl py-2 d-flex flex-column gap-2">
            @foreach (var contest in contests)
            {
                bool upcoming = now < contest.StartTime;
                bool running = !upcoming && now < contest.EndTime;
                <div class="d-flex flex-wrap align-items-baseline gap-2">
                    <a class="fw-semibold text-break" href="@($"contests/{contest.Id}/{(upcoming ? "rules" : "standing")}")">@contest.Name</a>
                    <span class="badge @(upcoming ? "text-bg-primary" : running ? "text-bg-success" : "text-bg-secondary")">@(upcoming ? SiteResources.ContestUpcoming : running ? SiteResources.ContestRunning : SiteResources.ContestOver)</span>
                    <span class="small text-body-secondary">
                        <time datetime="@contest.StartTime.ToString("O", CultureInfo.InvariantCulture)">@contest.StartTime.ToString("g", CultureInfo.CurrentCulture)</time>
                        – <time datetime="@contest.EndTime.ToString("O", CultureInfo.InvariantCulture)">@contest.EndTime.ToString(contest.StartTime.Date == contest.EndTime.Date ? "t" : "g", CultureInfo.CurrentCulture)</time>
                        @if (now < contest.EndTime)
                        {
                            <text> · </text><ContestTimeRemaining Contest="contest" Now="now" />
                        }
                    </span>
                </div>
            }
        </div>
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private List<Contest> contests = [];
    private readonly DateTimeOffset now = DateTimeOffset.Now;

    protected override async Task OnParametersSetAsync()
    {
        var actor = (await AuthenticationState).User;
        int? participantContestId = int.TryParse(actor.FindFirst(ClaimNames.CompetitorContest)?.Value, out int id) ? id : null;
        await using var db = await ContextFactory.CreateDbContextAsync();
        var today = now.Date;
        var tomorrow = today.AddDays(1);
        contests = await db.Contests.AsNoTracking()
            .Where(item => !item.IsHidden)
            .Where(item => participantContestId.HasValue ? item.Id == participantContestId.Value
                : item.StartTime.Date < tomorrow && item.EndTime.Date >= today)
            .OrderBy(item => item.StartTime).ThenBy(item => item.Id).ToListAsync();
    }
}
