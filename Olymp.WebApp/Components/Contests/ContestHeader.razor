@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@inject IDbContextFactory<OlympContext> ContextFactory

@{
    var start = Contest.StartTime.ToLocalTime();
    var end = Contest.EndTime.ToLocalTime();
}

<header class="contest-header mb-4">
    <h1 class="mb-2 text-break">@Contest.Name</h1>
    <p class="text-body-secondary mb-2">
        <time datetime="@Contest.StartTime.ToString("O", CultureInfo.InvariantCulture)">@start.ToString(IsFinished ? "d" : "g", CultureInfo.CurrentCulture)</time>
        @if (!IsFinished || start.Date != end.Date)
        {
            <text> – </text><time datetime="@Contest.EndTime.ToString("O", CultureInfo.InvariantCulture)">@end.ToString(IsFinished ? "d" : start.Date == end.Date ? "t" : "g", CultureInfo.CurrentCulture)</time>
        }
        · @if (IsFinished)
        {
            @SiteResources.ContestOver
        }
        else
        {
            <span class="fw-semibold text-body text-nowrap"><ContestTimeRemaining Contest="Contest" Now="now" /></span>
        }
    </p>
    @if (!Contest.IsOpen && !string.IsNullOrWhiteSpace(Contest.Description))
    {
        <div class="mb-3 text-break overflow-auto">@((MarkupString)Contest.Description)</div>
    }
    <ContestNavigation Contest="Contest" Now="now" ActiveSection="@ActiveSection" Participant="isParticipant" StandingUrl="@standingUrl" />
    @if (isParticipant)
    {
        <JuryAnnouncements Contest="Contest" />
    }
</header>

@code {
    [Parameter, EditorRequired]
    public Contest Contest { get; set; } = default!;

    [Parameter, EditorRequired]
    public string ActiveSection { get; set; } = "";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private bool isParticipant;
    private string? standingUrl;
    private readonly DateTimeOffset now = DateTimeOffset.Now;

    private bool IsFinished => now >= Contest.EndTime;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationState;
        isParticipant = state.User.Identity?.IsAuthenticated == true
            && int.TryParse(state.User.FindFirst(ClaimNames.CompetitorContest)?.Value, out int contestId)
            && contestId == Contest.Id;
        standingUrl = null;
        if (!isParticipant)
            return;

        standingUrl = $"contests/{Contest.Id}/standing?highlight=true";
        if (!Contest.AllowShowStanding || (Contest.FinalTableId is not null && Contest.OfficialTableId is null))
            return;
        if (!int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out int userId))
            return;

        await using var db = await ContextFactory.CreateDbContextAsync();
        if (await db.Competitors.AnyAsync(item => item.Id == userId && item.ContestId == Contest.Id
            && item.IsApproved && !item.IsHidden && !item.IsOutOfCompetition && !item.IsDisqualified))
            standingUrl = $"contests/{Contest.Id}/standing?highlight=true&official=true";
    }
}
