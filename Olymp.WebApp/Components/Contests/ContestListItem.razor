<article class="list-group-item py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
        <h3 class="h5 mb-0">@Contest.Name</h3>
        <time class="text-body-secondary" datetime="@Contest.StartTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@Contest.StartTime.ToString("d", CultureInfo.CurrentCulture)</time>
    </div>
    @if (Contest.EndTime >= Now)
    {
        <p class="small text-body-secondary mb-2">@(Contest.StartTime > Now ? SiteResources.ContestUpcoming : SiteResources.ContestInProgress)</p>
    }
    <ContestNavigation Contest="Contest" Now="Now" Compact="true" />
    @if (!Contest.IsOpen && !string.IsNullOrWhiteSpace(Contest.Description))
    {
        <div class="mt-3 overflow-auto">@((MarkupString)Contest.Description)</div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public Contest Contest { get; set; } = default!;

    [Parameter]
    public DateTimeOffset Now { get; set; }
}
