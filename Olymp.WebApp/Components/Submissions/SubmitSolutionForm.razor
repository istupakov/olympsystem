@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Olymp.Domain

@inject IDbContextFactory<OlympContext> ContextFactory
@inject SubmissionService Submissions
@inject UserManager<User> Users
@inject NavigationManager Navigation

<section class="mt-4" aria-labelledby="submit-heading">
    <h2 id="submit-heading" class="h4">@SiteResources.SubmitSolution</h2>
    <p class="small"><a href="rules" target="_blank" rel="noopener">@SiteResources.SubmissionRulesLink</a></p>
    @if (error is not null)
    {
        <p class="text-danger" role="alert">@error</p>
    }
    <EditForm Model="Input" method="post" action="@Action" FormName="submit-solution" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />
        <SubmissionFields Input="Input!" Compilers="compilers" />
    </EditForm>
</section>

@code {
    [Parameter, EditorRequired]
    public Problem Problem { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Action { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "submit-solution")]
    private SubmissionInput? Input { get; set; }

    private IReadOnlyList<Compilator> compilers = [];
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        Input ??= new();
        var token = HttpContext.RequestAborted;
        await using var context = await ContextFactory.CreateDbContextAsync(token);
        compilers = await context.Compilators.AsNoTracking().Where(compiler => compiler.IsActive)
            .OrderBy(compiler => compiler.Description).ThenBy(compiler => compiler.Name).ToListAsync(token);
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            int userId = int.Parse(Users.GetUserId(HttpContext.User)!);
            Input.CompilatorId ??= await context.Submissions.AsNoTracking()
                .Where(submission => submission.Problem.ContestId == Problem.ContestId && submission.Problem.IsActive
                    && submission.Compilator.IsActive && submission.UserId == userId)
                .OrderByDescending(submission => submission.CommitTime).ThenByDescending(submission => submission.Id)
                .Select(submission => (int?)submission.CompilatorId).FirstOrDefaultAsync(token);
        }
    }

    private async Task SubmitAsync()
    {
        var token = HttpContext.RequestAborted;
        var result = await Submissions.SubmitPublicAsync(HttpContext.User, Problem.ContestId, Problem.Id, Input!,
            HttpContext.Connection.RemoteIpAddress?.ToString(), token);
        if (result.NotFound)
        {
            Navigation.NotFound();
            return;
        }
        error = result.Error;
        if (result.Id is int id)
            Navigation.NavigateTo($"contests/{Problem.ContestId}/problems?problemId={Problem.Id}#submission-{id}");
    }
}
