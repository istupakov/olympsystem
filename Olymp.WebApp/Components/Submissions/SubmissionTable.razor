<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                @if (ShowId) { <th scope="col">ID</th> }
                <th scope="col">@SiteResources.SubmissionTime</th>
                @if (ShowAuthor)
                {
                    <th scope="col">@SiteResources.SubmissionAuthor</th>
                }
                @if (ShowProblem)
                {
                    <th scope="col">@SiteResources.Problem</th>
                }
                <th scope="col">@SiteResources.Compiler</th>
                <th scope="col">@SiteResources.SubmissionStatus</th>
                @if (ShowScores)
                {
                    <th scope="col">@SiteResources.Points</th>
                }
                @if (ShowSource)
                {
                    <th scope="col">@SiteResources.SourceCode</th>
                }
                @if (ShowIpAddress)
                {
                    <th scope="col">@SiteResources.IpAddress</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var submission in Items)
            {
                <tr id="submission-@submission.Id">
                    @if (ShowId) { <td><a href="@SourceUrl(submission)">@submission.Id</a></td> }
                    <td>@submission.CommitTime.ToLocalTime().ToString("g")</td>
                    @if (ShowAuthor)
                    {
                        <td>
                            @submission.Author
                            @if (submission.IsParticipant)
                            {
                                <span class="badge text-bg-secondary ms-1">@(submission.IsTeam ? SiteResources.StaffTeam : SiteResources.Competitor)</span>
                            }
                        </td>
                    }
                    @if (ShowProblem)
                    {
                        <td class="w-25">
                            <div class="d-grid">
                                <a href="@ProblemUrl(submission)"
                                   class="text-truncate" title="@submission.Problem">@submission.Problem</a>
                                @if (ShowContest)
                                {
                                    <div class="small text-body-secondary text-truncate" title="@submission.Contest">@submission.Contest</div>
                                }
                            </div>
                        </td>
                    }
                    <td title="@(string.IsNullOrWhiteSpace(submission.CompilerDescription) ? null : submission.CompilerDescription)">@submission.Compiler</td>
                    <td>
                        @if (submission.StatusCode is int status)
                        {
                            @if (status == -1 && submission.CanViewSource)
                            {
                                <a href="@(SourceUrl(submission) + "#compilation-errors")"><SubmissionStatus StatusCode="status" /></a>
                            }
                            else
                            {
                                <SubmissionStatus StatusCode="status" />
                            }
                        }
                        else if (submission.IsAccepted is bool accepted)
                        {
                            <span class="@(accepted ? "text-success" : "text-danger")">@(accepted ? "Accepted" : "Not accepted")</span>
                        }
                        else
                        {
                            <span class="text-body-secondary">@SiteResources.SubmissionRecorded</span>
                        }
                    </td>
                    @if (ShowScores)
                    {
                        <td>@submission.Score</td>
                    }
                    @if (ShowSource)
                    {
                        <td>
                            @if (submission.CanViewSource)
                            {
                                <a href="@SourceUrl(submission)">@SiteResources.ViewSource</a>
                                <a href="@DownloadUrl(submission)" class="ms-2" data-enhance-nav="false">@SiteResources.DownloadSource</a>
                            }
                        </td>
                    }
                    @if (ShowIpAddress)
                    {
                        <td class="text-nowrap">@(string.IsNullOrWhiteSpace(submission.IpAddress) ? "–" : submission.IpAddress)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SubmissionListItem> Items { get; set; } = [];

    [Parameter]
    public bool ShowId { get; set; }

    [Parameter]
    public bool ShowAuthor { get; set; } = true;

    [Parameter]
    public bool ShowProblem { get; set; } = true;

    [Parameter]
    public bool ShowContest { get; set; }

    [Parameter]
    public bool ShowScores { get; set; } = true;

    [Parameter]
    public bool ShowSource { get; set; } = true;

    [Parameter]
    public bool ShowIpAddress { get; set; }

    [Parameter]
    public Func<SubmissionListItem, string> SourceUrl { get; set; } = item => $"submissions/{item.Id}";

    [Parameter]
    public Func<SubmissionListItem, string> DownloadUrl { get; set; } = item => $"submissions/{item.Id}/download";

    [Parameter]
    public Func<SubmissionListItem, string> ProblemUrl { get; set; } = item => $"contests/{item.ContestId}/problems?problemId={item.ProblemId}";
}
