<div class="table-responsive">
    <table class="table table-striped table-hover text-nowrap align-middle">
        <thead>
            <tr>
                <th scope="col">@SiteResources.SubmissionTime</th>
                @if (ShowAuthor)
                {
                    <th scope="col">@SiteResources.SubmissionAuthor</th>
                }
                @if (ShowProblem)
                {
                    <th scope="col">@SiteResources.Problem</th>
                }
                <th scope="col">@SiteResources.Compiler</th>
                <th scope="col">@SiteResources.SubmissionStatus</th>
                @if (ShowScores)
                {
                    <th scope="col" class="text-center">@SiteResources.Points</th>
                }
                @if (ShowSource)
                {
                    <th scope="col">@SiteResources.SourceCode</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var submission in Items)
            {
                <tr id="submission-@submission.Id">
                    <td>
                        <div>@submission.CommitTime.ToLocalTime().ToString("d")</div>
                        <div class="small text-body-secondary">@submission.CommitTime.ToLocalTime().ToString("t")</div>
                    </td>
                    @if (ShowAuthor)
                    {
                        <td>
                            <span title="@submission.Author">@Shorten(submission.Author, 25)</span>
                            @if (submission.IsParticipant)
                            {
                                <div><span class="badge text-bg-secondary">@SiteResources.Competitor</span></div>
                            }
                        </td>
                    }
                    @if (ShowProblem)
                    {
                        <td>
                            <div>
                                <a href="@ProblemUrl(submission)" title="@submission.Problem">@Shorten(submission.Problem, 25)</a>
                                @if (ShowContest)
                                {
                                    <div class="small text-body-secondary" title="@submission.Contest">@Shorten(submission.Contest, 25)</div>
                                }
                            </div>
                        </td>
                    }
                    <td title="@(string.IsNullOrWhiteSpace(submission.CompilerDescription) ? null : submission.CompilerDescription)">
                        @submission.Compiler
                    </td>
                    <td>
                        @if (submission.StatusCode is int status)
                        {
                            @if (status == -1 && submission.CanViewSource)
                            {
                                <a href="@(SourceUrl(submission) + "#compilation-errors")"><SubmissionStatus StatusCode="status" /></a>
                            }
                            else
                            {
                                <SubmissionStatus StatusCode="status" />
                            }
                        }
                        else if (submission.IsAccepted is bool accepted)
                        {
                            <span class="@(accepted ? "text-success" : "text-danger")">@(accepted ? "Accepted" : "Not accepted")</span>
                        }
                        else
                        {
                            <span class="text-body-secondary">@SiteResources.SubmissionRecorded</span>
                        }
                    </td>
                    @if (ShowScores)
                    {
                        <td class="text-center">@submission.Score</td>
                    }
                    @if (ShowSource)
                    {
                        <td>
                            @if (submission.CanViewSource)
                            {
                                <div><a href="@SourceUrl(submission)">@SiteResources.ViewSource</a></div>
                                <div><a href="@DownloadUrl(submission)" data-enhance-nav="false">@SiteResources.DownloadSource</a></div>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private static string Shorten(string text, int maxLength)
    {
        if (text.Length <= maxLength) return text;

        var characters = StringInfo.ParseCombiningCharacters(text);
        return characters.Length <= maxLength ? text : text[..characters[maxLength - 1]] + "…";
    }

    [Parameter, EditorRequired]
    public IReadOnlyList<SubmissionListItem> Items { get; set; } = [];

    [Parameter]
    public bool ShowAuthor { get; set; } = true;

    [Parameter]
    public bool ShowProblem { get; set; } = true;

    [Parameter]
    public bool ShowContest { get; set; }

    [Parameter]
    public bool ShowScores { get; set; } = true;

    [Parameter]
    public bool ShowSource { get; set; } = true;

    [Parameter]
    public Func<SubmissionListItem, string> SourceUrl { get; set; } = item => $"submissions/{item.Id}";

    [Parameter]
    public Func<SubmissionListItem, string> DownloadUrl { get; set; } = item => $"submissions/{item.Id}/download";

    [Parameter]
    public Func<SubmissionListItem, string> ProblemUrl { get; set; } = item => $"contests/{item.ContestId}/problems?problemId={item.ProblemId}";
}
