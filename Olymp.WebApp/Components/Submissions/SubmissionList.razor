@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@inject IDbContextFactory<OlympContext> ContextFactory
@inject UserManager<User> Users
@inject NavigationManager Navigation

@if (loaded)
{
    <section id="submissions" class="mt-4" aria-labelledby="@(ShowHeading ? "submissions-heading" : null)" aria-label="@(!ShowHeading ? SiteResources.Submissions : null)">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            @if (ShowHeading)
            {
                <h2 id="submissions-heading" class="h4 mb-0">@SiteResources.Submissions</h2>
            }
            <a href="@ListUrl(selectedScope, Page)" class="btn btn-sm btn-outline-secondary">@SiteResources.Refresh</a>
        </div>
        @if (!isParticipant)
        {
            <nav aria-label="@SiteResources.SubmissionScope" class="mb-3">
                <ul class="nav nav-underline">
                    @foreach (var scope in AvailableScopes)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(selectedScope == scope ? "active" : null)" href="@(ListUrl(scope, 1) + "#submissions")"
                               aria-current="@(selectedScope == scope ? "page" : null)">@ScopeName(scope)</a>
                        </li>
                    }
                </ul>
            </nav>
        }
        @if (submissions.Count == 0)
        {
            <p class="text-body-secondary">@SiteResources.NoSubmissions</p>
        }
        else
        {
            <SubmissionTable Items="submissions" ShowAuthor="@(!isParticipant)" ShowProblem="@(!ProblemId.HasValue)"
                             ShowContest="@(!ContestId.HasValue)" ShowScores="ShowScores" ShowSource="ShowSource" />
        }
        <Pagination Page="Page" HasNextPage="hasNextPage" PageUrl="@(number => ListUrl(selectedScope, number) + "#submissions")" Label="@SiteResources.SubmissionPages" />
    </section>
}

@code {
    private const int PageSize = 20;
    private const int AllPageLimit = 10;

    [Parameter]
    public int? ContestId { get; set; }

    [Parameter]
    public int? ProblemId { get; set; }

    [Parameter]
    public string? Scope { get; set; }

    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public bool ShowHeading { get; set; } = true;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private List<SubmissionListItem> submissions = [];
    private SubmissionScope selectedScope;
    private bool loaded;
    private bool isParticipant;
    private bool hasParticipantSubmissions;
    private bool hasCoachedSubmissions;
    private bool hasNextPage;

    private bool ShowScores => submissions.Any(item => item.IsSchool);
    private bool ShowSource => submissions.Any(item => item.CanViewSource);

    private IEnumerable<SubmissionScope> AvailableScopes
    {
        get
        {
            yield return SubmissionScope.Own;
            if (hasParticipantSubmissions)
                yield return SubmissionScope.Participant;
            if (hasCoachedSubmissions)
                yield return SubmissionScope.Coached;
            yield return SubmissionScope.All;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if ((!string.IsNullOrEmpty(Scope) && (!Enum.TryParse(Scope, ignoreCase: true, out selectedScope) || !Enum.IsDefined(selectedScope)))
            || Page < 1 || Page > int.MaxValue / PageSize
            || (selectedScope == SubmissionScope.All && Page > AllPageLimit))
        {
            Navigation.NotFound();
            return;
        }

        var user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NotFound();
            return;
        }
        int userId = user.Id;
        isParticipant = user is Competitor;
        if (isParticipant && selectedScope != SubmissionScope.Own)
        {
            Navigation.NotFound();
            return;
        }

        var token = HttpContext.RequestAborted;
        var now = DateTimeOffset.UtcNow;
        await using var context = await ContextFactory.CreateDbContextAsync(token);
        var query = context.Submissions.AsNoTracking()
            .Where(item => item.Problem.IsActive && !item.Problem.Contest.IsHidden && item.Problem.Contest.StartTime <= now)
            .Where(item => !ContestId.HasValue || item.Problem.ContestId == ContestId)
            .Where(item => !ProblemId.HasValue || item.ProblemId == ProblemId);
        var participantQuery = query.Where(item => context.Competitors.Any(team => team.Id == item.UserId
            && team.ContestId == item.Problem.ContestId && team.Members.Any(member => member.Id == userId)));
        var coachedQuery = query.Where(item => item.User.CoachId == userId);
        if (!isParticipant)
        {
            hasParticipantSubmissions = await participantQuery.AnyAsync(token);
            hasCoachedSubmissions = await coachedQuery.AnyAsync(token);
        }

        query = selectedScope switch
        {
            SubmissionScope.Own => query.Where(item => item.UserId == userId),
            SubmissionScope.Participant => participantQuery,
            SubmissionScope.Coached => coachedQuery,
            _ => query.Where(item => !item.User.IsHidden || item.UserId == userId)
        };

        bool lastAllPage = selectedScope == SubmissionScope.All && Page == AllPageLimit;
        submissions = await (from item in query
                             let own = item.UserId == userId
                             let related = item.User.CoachId == userId || context.Competitors.Any(team => team.Id == item.UserId
                                 && team.ContestId == item.Problem.ContestId && team.Members.Any(member => member.Id == userId))
                             let frozen = !item.Problem.Contest.IsOpen
                                 && item.Problem.Contest.FreezeTime != null && item.Problem.Contest.FreezeTime < now
                                 && item.CommitTime >= item.Problem.Contest.FreezeTime
                             let full = own || (related && !frozen)
                             let school = item.Problem.Contest.Abbr.StartsWith("school")
                             orderby item.CommitTime descending, item.Id descending
                             select new SubmissionListItem(item.Id, item.CommitTime, item.User.Name, item.User is Competitor,
                                 item.Compilator.Description ?? item.Compilator.Name, item.Problem.ContestId, item.Problem.Contest.Name,
                                 item.ProblemId, item.Problem.Number.ToString() + ". " + item.Problem.Name, school,
                                 full ? item.StatusCode : null, !full && !frozen ? item.StatusCode == 2 : null,
                                 full && school ? item.Score : null, own || (related && item.Problem.Contest.IsOpen)))
            .Skip((Page - 1) * PageSize).Take(PageSize + (lastAllPage ? 0 : 1)).ToListAsync(token);

        hasNextPage = submissions.Count > PageSize;
        if (hasNextPage)
            submissions.RemoveAt(PageSize);
        if (Page > 1 && submissions.Count == 0)
        {
            Navigation.NotFound();
            return;
        }
        loaded = true;
    }

    private string ListUrl(SubmissionScope scope, int page) => Navigation.GetUriWithQueryParameters(
        Navigation.Uri.Split('#')[0], new Dictionary<string, object?>
        {
            ["scope"] = scope == SubmissionScope.Own ? null : scope.ToString().ToLowerInvariant(),
            ["page"] = page == 1 ? null : page
        });

    private static string ScopeName(SubmissionScope scope) => scope switch
    {
        SubmissionScope.Own => SiteResources.OwnSubmissions,
        SubmissionScope.Participant => SiteResources.ParticipantSubmissions,
        SubmissionScope.Coached => SiteResources.CoachedSubmissions,
        _ => SiteResources.AllSubmissions
    };
}
