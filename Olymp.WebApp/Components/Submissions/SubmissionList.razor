@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Olymp.Domain
@inject IDbContextFactory<OlympContext> ContextFactory
@inject UserManager<User> Users
@inject NavigationManager Navigation

@if (loaded)
{
    <section id="submissions" class="mt-4" aria-labelledby="@(ShowHeading ? "submissions-heading" : null)" aria-label="@(!ShowHeading ? SiteResources.Submissions : null)">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            @if (ShowHeading)
            {
                <h2 id="submissions-heading" class="h4 mb-0">@SiteResources.Submissions</h2>
            }
            @if (!isTemporary && AvailableScopes.Length > 1)
            {
                <nav class="btn-group btn-group-sm" aria-label="@SiteResources.SubmissionScope">
                    @foreach (var scope in AvailableScopes)
                    {
                        <a class="btn btn-outline-secondary @(selectedScope == scope ? "active" : null)" href="@(ScopeUrl(scope) + "#submissions")"
                           aria-current="@(selectedScope == scope ? "page" : null)">@ScopeName(scope)</a>
                    }
                </nav>
            }
            @if (!isTemporary && AvailableKinds.Length > 1)
            {
                <nav class="btn-group btn-group-sm" aria-label="@SiteResources.SubmissionKind">
                    @foreach (var kind in AvailableKinds)
                    {
                        <a class="btn btn-outline-secondary @(selectedKind == kind ? "active" : null)" href="@(KindUrl(kind) + "#submissions")"
                           aria-current="@(selectedKind == kind ? "page" : null)">@(kind == SubmissionKind.Contest ? SiteResources.SubmissionContest : SiteResources.Training)</a>
                    }
                </nav>
            }
            <a href="@ListUrl(selectedScope, selectedKind, Page)" class="btn btn-sm btn-outline-secondary ms-auto">@SiteResources.Refresh</a>
        </div>
        @if (submissions.Count == 0)
        {
            <p class="text-body-secondary">@SiteResources.NoSubmissions</p>
        }
        else
        {
            <SubmissionTable Items="submissions" ShowAuthor="@(!isTemporary || selectedScope != SubmissionScope.Own)" ShowProblem="@(!ProblemId.HasValue)"
                             ShowContest="@(!ContestId.HasValue)" ShowScores="ShowScores" ShowSource="ShowSource" />
        }
        <Pagination Page="Page" HasNextPage="hasNextPage" PageUrl="@(number => ListUrl(selectedScope, selectedKind, number) + "#submissions")" Label="@SiteResources.SubmissionPages" />
    </section>
}

@code {
    private const int PageSize = 20;
    private const int AllPageLimit = 10;

    [Parameter]
    public int? ContestId { get; set; }

    [Parameter]
    public int? ProblemId { get; set; }

    [Parameter]
    public string? Scope { get; set; }

    [Parameter]
    public string? Kind { get; set; }

    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public bool ShowHeading { get; set; } = true;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private List<SubmissionListItem> submissions = [];
    private SubmissionScope selectedScope;
    private SubmissionKind selectedKind;
    private bool loaded;
    private bool isTemporary;
    private readonly HashSet<(SubmissionScope Scope, SubmissionKind Kind)> available = [];
    private bool hasNextPage;

    private bool ShowScores => selectedScope != SubmissionScope.All && submissions.Any(item => item.IsSchool);
    private bool ShowSource => submissions.Any(item => item.CanViewSource);

    private SubmissionScope[] AvailableScopes => Enum.GetValues<SubmissionScope>().Where(scope => available.Any(pair => pair.Scope == scope)).ToArray();
    private SubmissionKind[] AvailableKinds => Enum.GetValues<SubmissionKind>().Where(kind => available.Any(pair => pair.Kind == kind)).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        if (Page < 1 || Page > int.MaxValue / PageSize)
        {
            Navigation.NotFound();
            return;
        }

        var user = await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NotFound();
            return;
        }
        int userId = user.Id;
        isTemporary = user is Competitor;
        bool isForeignParticipant = user is Competitor participant && ContestId.HasValue && ContestId != participant.ContestId;
        selectedScope = isForeignParticipant ? SubmissionScope.All : SubmissionScope.Own;
        bool legacyParticipant = string.Equals(Scope, "participant", StringComparison.OrdinalIgnoreCase);
        selectedKind = SubmissionKind.Contest;
        if (!isTemporary && ((!string.IsNullOrEmpty(Scope) && !legacyParticipant
                && (!Enum.TryParse(Scope, ignoreCase: true, out selectedScope) || !Enum.IsDefined(selectedScope)))
            || (!string.IsNullOrEmpty(Kind)
                && (!Enum.TryParse(Kind, ignoreCase: true, out selectedKind) || !Enum.IsDefined(selectedKind)))))
        {
            Navigation.NotFound();
            return;
        }

        var token = HttpContext.RequestAborted;
        var now = DateTimeOffset.UtcNow;
        await using var context = await ContextFactory.CreateDbContextAsync(token);
        var query = context.Submissions.AsNoTracking()
            .Where(item => item.Problem.IsActive && !item.Problem.Contest.IsHidden && item.Problem.Contest.StartTime <= now)
            .Where(item => !ContestId.HasValue || item.Problem.ContestId == ContestId)
            .Where(item => !ProblemId.HasValue || item.ProblemId == ProblemId);
        var ownQuery = query.Where(item => item.UserId == userId || context.Competitors.Any(team => team.Id == item.UserId
            && team.ContestId == item.Problem.ContestId && team.Members.Any(member => member.Id == userId)));
        var coachedQuery = query.Where(item => item.User.CoachId == userId);
        var publicQuery = query.Where(item => !item.User.IsHidden && !item.IsHidden
            && (item.StatusCode != -1 || (!item.Problem.Contest.IsOpen
                && item.Problem.Contest.FreezeTime != null && item.Problem.Contest.FreezeTime < now
                && item.CommitTime >= item.Problem.Contest.FreezeTime)));
        available.Clear();
        if (!isTemporary)
        {
            foreach (var (scope, scopedQuery) in new[] { (SubmissionScope.Own, ownQuery), (SubmissionScope.Coached, coachedQuery), (SubmissionScope.All, publicQuery) })
                foreach (bool isParticipant in await scopedQuery.Select(item => item.User is Competitor).Distinct().ToListAsync(token))
                    available.Add((scope, isParticipant ? SubmissionKind.Contest : SubmissionKind.Training));
            if (string.IsNullOrEmpty(Scope))
                selectedScope = AvailableScopes.FirstOrDefault(SubmissionScope.All);
            if (string.IsNullOrEmpty(Kind) && !legacyParticipant)
                selectedKind = available.Contains((selectedScope, SubmissionKind.Contest)) ? SubmissionKind.Contest : SubmissionKind.Training;
        }

        if (selectedScope == SubmissionScope.All && Page > AllPageLimit)
        {
            Navigation.NotFound();
            return;
        }

        query = isTemporary ? (isForeignParticipant ? publicQuery : query.Where(item => item.UserId == userId)) : selectedScope switch
        {
            SubmissionScope.Own => ownQuery,
            SubmissionScope.Coached => coachedQuery,
            _ => publicQuery
        };
        if (!isTemporary)
            query = query.Where(item => (item.User is Competitor) == (selectedKind == SubmissionKind.Contest));

        bool lastAllPage = selectedScope == SubmissionScope.All && Page == AllPageLimit;
        submissions = await (from item in query
                             let own = item.UserId == userId
                             let related = item.User.CoachId == userId || context.Competitors.Any(team => team.Id == item.UserId
                                 && team.ContestId == item.Problem.ContestId && team.Members.Any(member => member.Id == userId))
                             let frozen = !item.Problem.Contest.IsOpen
                                 && item.Problem.Contest.FreezeTime != null && item.Problem.Contest.FreezeTime < now
                                 && item.CommitTime >= item.Problem.Contest.FreezeTime
                             let full = selectedScope != SubmissionScope.All && (own || (related && !frozen))
                             let school = item.Problem.Contest.Abbr.StartsWith("school")
                             orderby item.CommitTime descending, item.Id descending
                             select new SubmissionListItem(
                                 Id: item.Id,
                                 CommitTime: item.CommitTime,
                                 Author: item.User.Name,
                                 Compiler: item.Compilator.Name,
                                 ContestId: item.Problem.ContestId,
                                 Contest: item.Problem.Contest.Name,
                                 ProblemId: item.ProblemId,
                                 Problem: item.Problem.Number.ToString() + ". " + item.Problem.Name,
                                 IsSchool: school,
                                 StatusCode: full ? item.StatusCode : null,
                                 IsAccepted: !full && !frozen && item.StatusCode != 0 && item.StatusCode != 1 ? item.StatusCode == 2 : null,
                                 Score: full && school ? item.Score : null,
                                 CanViewSource: selectedScope != SubmissionScope.All && (own || (related && item.Problem.Contest.IsOpen)))
                             {
                                 CompilerDescription = item.Compilator.Description
                             })
            .Skip((Page - 1) * PageSize).Take(PageSize + (lastAllPage ? 0 : 1)).ToListAsync(token);

        hasNextPage = submissions.Count > PageSize;
        if (hasNextPage)
            submissions.RemoveAt(PageSize);
        if (Page > 1 && submissions.Count == 0)
        {
            Navigation.NotFound();
            return;
        }
        loaded = true;
    }

    private string ScopeUrl(SubmissionScope scope) => ListUrl(scope, selectedKind, 1);

    private string KindUrl(SubmissionKind kind) => ListUrl(selectedScope, kind, 1);

    private string ListUrl(SubmissionScope scope, SubmissionKind kind, int page) => Navigation.GetUriWithQueryParameters(
        Navigation.Uri.Split('#')[0], new Dictionary<string, object?>
        {
            ["scope"] = isTemporary ? null : scope.ToString().ToLowerInvariant(),
            ["kind"] = isTemporary ? null : kind.ToString().ToLowerInvariant(),
            ["page"] = page == 1 ? null : page
        });

    private static string ScopeName(SubmissionScope scope) => scope switch
    {
        SubmissionScope.Own => SiteResources.SubmissionMine,
        SubmissionScope.Coached => SiteResources.CoachedSubmissions,
        _ => SiteResources.AllSubmissions
    };
}
