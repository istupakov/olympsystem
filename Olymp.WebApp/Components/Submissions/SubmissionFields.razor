@if (Compilers.Count == 0)
{
    <p class="text-body-secondary">@SiteResources.NoActiveCompilers</p>
}
<fieldset disabled="@(Disabled || Compilers.Count == 0)">
    <div class="mb-3">
        <label for="submission-compiler" class="form-label"><DisplayName For="() => Input.CompilatorId" /></label>
        <InputSelect @bind-Value="Input.CompilatorId" id="submission-compiler" class="form-select">
            <option value="">@SiteResources.SelectCompiler</option>
            @foreach (var compiler in Compilers)
            {
                <option value="@compiler.Id">@(compiler.Description ?? compiler.Name)</option>
            }
        </InputSelect>
        <ValidationMessage For="() => Input.CompilatorId" class="text-danger" />
    </div>
    <div class="mb-3">
        <label for="submission-code" class="form-label"><DisplayName For="() => Input.Code" /></label>
        <InputTextArea @bind-Value="Input.Code" id="submission-code" class="form-control font-monospace" rows="14" spellcheck="false" />
        <ValidationMessage For="() => Input.Code" class="text-danger" />
    </div>
    <button type="submit" class="btn btn-primary">@SiteResources.SubmitSolution</button>
</fieldset>

@code {
    [Parameter, EditorRequired]
    public SubmissionInput Input { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<Compilator> Compilers { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }
}
