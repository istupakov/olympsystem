@using System.Text
@using Olymp.Domain.Models
@using Olymp.WebApp.Components.Contests

<div class="problem-statement text-break">
    <ul class="list-unstyled text-body-secondary">
        <li>@SiteResources.TimeLimit: @Problem.TimeLimit @SiteResources.Seconds</li>
        <li>@SiteResources.MemoryLimit: @Problem.MemoryLimit @SiteResources.Megabytes</li>
    </ul>

    @if (!string.IsNullOrWhiteSpace(Problem.Text))
    {
        <div class="statement-html overflow-x-auto">@((MarkupString)Problem.Text)</div>
    }
    else if (ShowPdfLink && Problem.Contest.ProblemPdfId.HasValue)
    {
        <p><a href="contests/@Problem.ContestId/downloadproblems">@SiteResources.DownloadStatements</a></p>
    }
    else
    {
        <p class="text-body-secondary">@SiteResources.StatementUnavailable</p>
    }

    @if (Examples.Count > 0)
    {
        <section class="mt-4" aria-label="@SiteResources.Examples">
            <h3 class="h5">@SiteResources.Examples</h3>
            <div class="table-responsive">
                <table class="table table-sm table-bordered problem-examples">
                    <thead>
                        <tr>
                            <th scope="col" class="w-50">@SiteResources.StandardInput</th>
                            <th scope="col" class="w-50">@SiteResources.StandardOutput</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var example in Examples)
                        {
                            <tr>
                                <td><pre class="mb-0"><samp>@Encoding.Default.GetString(example.Input)</samp></pre></td>
                                <td><pre class="mb-0"><samp>@Encoding.Default.GetString(example.Output)</samp></pre></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    <JuryMessageList Messages="Clarifications" Title="@SiteResources.ProblemClarifications" />
</div>

@code {
    [Parameter, EditorRequired]
    public Problem Problem { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<Test> Examples { get; set; } = [];

    [Parameter]
    public IReadOnlyList<Message> Clarifications { get; set; } = [];

    [Parameter]
    public bool ShowPdfLink { get; set; } = true;
}
