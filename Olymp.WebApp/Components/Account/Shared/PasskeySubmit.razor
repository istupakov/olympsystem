<button type="submit" name="__passkeySubmit" @attributes="AdditionalAttributes" formnovalidate>@ChildContent</button>
<passkey-submit
    operation="@Operation"
    name="@Name"
    email-name="@EmailName"
    server-error-message="@AccountResources.PasskeyServerError"
    unsupported-browser-message="@AccountResources.PasskeyBrowserUnsupported"
    unknown-operation-message="@AccountResources.UnknownPasskeyOperation"
    no-passkey-message="@AccountResources.NoPasskeyProvided">
</passkey-submit>

@code {
    [Parameter]
    [EditorRequired]
    public PasskeyOperation Operation { get; set; }

    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = default!;

    [Parameter]
    public string? EmailName { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
