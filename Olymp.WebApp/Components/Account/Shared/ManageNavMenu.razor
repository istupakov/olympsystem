        <NavLink class="nav-link" href="account/manage" Match="NavLinkMatch.All">@AccountResources.Profile</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="account/manage/email">@AccountResources.Email</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="account/manage/changepassword">@AccountResources.Password</NavLink>
    </li>
    @if (Features.PasskeysEnabled)
    {
        <li class="nav-item">
            <NavLink class="nav-link" href="account/manage/passkeys">@AccountResources.Passkeys</NavLink>
