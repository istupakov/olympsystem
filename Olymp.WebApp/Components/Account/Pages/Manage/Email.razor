@page "/Account/Manage/Email"

@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject IEmailSender<User> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@AccountResources.ManageEmail</PageTitle>

<h3>@AccountResources.ManageEmail</h3>

<StatusMessage Message="@message" IsError="@isError" />
@if (needsMigration)
{
    <div class="alert alert-warning" role="alert">
        <p>@AccountResources.EmailLoginRequired</p>
        <p>@AccountResources.CurrentUserName <strong>@user?.UserName</strong>. @AccountResources.EmailLoginPasswordHint</p>
        @if (isEmailConfirmed && !string.IsNullOrWhiteSpace(email))
        {
            <form @onsubmit="OnUseEmailAsLoginAsync" @formname="use-email-login" method="post">
                <button type="submit" class="btn btn-primary">@string.Format(CultureInfo.CurrentCulture, AccountResources.UseEmailForSignIn, email)</button>
            </form>
        }
        <p class="mb-0">@AccountResources.OutdatedEmailHint</p>
    </div>
}
<div class="row">
    <div class="col-xl-6">
        <form @onsubmit="OnSendEmailVerificationAsync" @formname="send-verification" id="send-verification-form" method="post">
        </form>
        <EditForm Model="Input" FormName="change-email" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <div role="alert" aria-atomic="true">
                <ValidationSummary class="text-danger" />
            </div>
            @if (isEmailConfirmed)
            {
                <div class="form-floating mb-3 input-group">
                    <input type="text" value="@email" id="email" class="form-control" placeholder="@AccountResources.EnterEmail" disabled />
                    <div class="input-group-append">
                        <span class="h-100 input-group-text text-success font-weight-bold">✓</span>
                    </div>
                    <label for="email" class="form-label">@AccountResources.Email</label>
                </div>
            }
            else
            {
                <div class="form-floating mb-3">
                    <input type="text" value="@email" id="email" class="form-control" placeholder="@AccountResources.EnterEmail" disabled />
                    <label for="email" class="form-label">@AccountResources.Email</label>
                    <button type="submit" class="btn btn-link" form="send-verification-form">@AccountResources.SendVerificationEmail</button>
                </div>
            }
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.NewEmail" id="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="@AccountResources.EnterNewEmail" />
                <label for="Input.NewEmail" class="form-label">
                    <DisplayName For="() => Input.NewEmail" />
                </label>
                <ValidationMessage For="() => Input.NewEmail" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@AccountResources.ChangeEmail</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private bool isError;
    private User? user;
    private string? email;
    private bool isEmailConfirmed;
    private bool needsMigration;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageKey)]
    private string? IdentityStatusMessage { get; set; }

    [SupplyParameterFromForm(FormName = "change-email")]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        message = IdentityStatusMessage;
        IdentityStatusMessage = null;
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        email = await UserManager.GetEmailAsync(user);
        isEmailConfirmed = await UserManager.IsEmailConfirmedAsync(user);
        needsMigration = EmailAsLoginRequirement.NeedsMigration(user);

        Input.NewEmail ??= email;
    }

    private async Task OnUseEmailAsLoginAsync()
    {
        if (user is null || !needsMigration || !isEmailConfirmed || string.IsNullOrWhiteSpace(email))
            return;

        var result = await UserManager.SetUserNameAsync(user, email);
        if (!result.Succeeded)
        {
            message = string.Join(", ", result.Errors.Select(error => error.Description));
            isError = true;
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        IdentityStatusMessage = AccountResources.EmailIsNowUserName;
        RedirectManager.RedirectTo(ReturnUrl ?? "Account/Manage/Email");
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input.NewEmail is null || Input.NewEmail == email)
        {
            message = AccountResources.EmailUnchanged;
            return;
        }

        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateChangeEmailTokenAsync(user, Input.NewEmail);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmailChange").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["email"] = Input.NewEmail, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, Input.NewEmail, HtmlEncoder.Default.Encode(callbackUrl));

        message = AccountResources.EmailChangeConfirmationSent;
    }

    private async Task OnSendEmailVerificationAsync()
    {
        if (email is null)
        {
            return;
        }

        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

        await EmailSender.SendConfirmationLinkAsync(user, email, HtmlEncoder.Default.Encode(callbackUrl));

        message = AccountResources.VerificationEmailSent;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceName = nameof(AccountResources.FieldRequired), ErrorMessageResourceType = typeof(AccountResources))]
        [EmailAddress(ErrorMessageResourceName = nameof(AccountResources.InvalidEmailAddress), ErrorMessageResourceType = typeof(AccountResources))]
        [Display(Name = nameof(AccountResources.NewEmail), ResourceType = typeof(AccountResources))]
        public string? NewEmail { get; set; }
    }
}
