@page "/Account/Manage/RenamePasskey/{Id}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = IdentityFeatures.PasskeysPolicy)]

@using System.Buffers.Text

@inject UserManager<User> UserManager
@inject IdentityRedirectManager RedirectManager

<EditForm Model="Input" OnValidSubmit="Rename" FormName="rename-passkey" method="post">
    <DataAnnotationsValidator />
    @if (passkey?.Name is { } name)
    {
        <h4>@string.Format(CultureInfo.CurrentCulture, AccountResources.RenamePasskeyPrompt, name)</h4>
    }
    else
    {
        <h4>@AccountResources.NamePasskeyPrompt</h4>
    }
    <hr />
    <div role="alert" aria-atomic="true">
        <ValidationSummary class="text-danger" />
    </div>
    <div class="form-floating mb-3">
        <InputText @bind-Value="Input.Name" id="Input.Name" class="form-control" aria-required="true" placeholder="@AccountResources.MyPasskey" />
        <label for="Input.Name" class="form-label">@AccountResources.PasskeyName</label>
        <ValidationMessage For="() => Input.Name" class="text-danger" />
    </div>
    <div>
        <button type="submit" class="w-100 btn btn-lg btn-primary">@AccountResources.Continue</button>
    </div>
</EditForm>

@code {
    private User? user;
    private UserPasskeyInfo? passkey;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageKey)]
    private string? IdentityStatusMessage { get; set; }

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageIsErrorKey)]
    private bool? IdentityStatusIsError { get; set; }

    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        IdentityStatusMessage = null;
        IdentityStatusIsError = null;
        Input ??= new();

        user = (await UserManager.GetUserAsync(HttpContext.User))!;
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        byte[] credentialId;
        try
        {
            credentialId = Base64Url.DecodeFromChars(Id);
        }
        catch (FormatException)
        {
            RedirectWithMessage(AccountResources.InvalidPasskeyId);
            return;
        }

        passkey = await UserManager.GetPasskeyAsync(user, credentialId);
        if (passkey is null)
        {
            RedirectWithMessage(AccountResources.PasskeyNotFound);
            return;
        }
    }

    private async Task Rename()
    {
        passkey!.Name = Input.Name;
        var result = await UserManager.AddOrUpdatePasskeyAsync(user!, passkey);
        if (!result.Succeeded)
        {
            RedirectWithMessage(AccountResources.PasskeyUpdateFailed);
            return;
        }

        RedirectWithMessage(AccountResources.PasskeyUpdated, isError: false);
    }

    private void RedirectWithMessage(string message, bool isError = true)
    {
        IdentityStatusMessage = message;
        IdentityStatusIsError = isError;
        RedirectManager.RedirectTo("Account/Manage/Passkeys");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceName = nameof(AccountResources.PasskeyNameRequired), ErrorMessageResourceType = typeof(AccountResources))]
        [StringLength(200, ErrorMessageResourceName = nameof(AccountResources.PasskeyNameTooLong), ErrorMessageResourceType = typeof(AccountResources))]
        public string Name { get; set; } = "";
    }
}
