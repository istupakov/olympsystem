@page "/Account/Manage/Passkeys"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = IdentityFeatures.PasskeysPolicy)]

@using System.Buffers.Text

@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@AccountResources.ManagePasskeys</PageTitle>

<h3>@AccountResources.ManagePasskeys</h3>

<StatusMessage Message="@message" IsError="@isError" />

@if (currentPasskeys is { Count: > 0 })
{
    <table class="table">
        <tbody>
            @foreach (var passkey in currentPasskeys)
            {
                <tr>
                    <td>
                        <div>@PasskeyAuthenticators.GetDisplayName(passkey)</div>
                        <small class="text-muted">@string.Format(CultureInfo.CurrentCulture, AccountResources.PasskeyCreated, passkey.CreatedAt.UtcDateTime)</small>
                    </td>
                    <td>
                        @{
                            var credentialId = Base64Url.EncodeToString(passkey.CredentialId);
                        }
                        <form @formname="@($"update-passkey-{credentialId}")" @onsubmit="UpdatePasskey" method="post">
                            <div>
                                <input type="hidden" name="CredentialId" value="@credentialId" />
                                <button type="submit" name="Action" value="rename" class="btn btn-primary" title="@AccountResources.RenamePasskeyHint">@AccountResources.Rename</button>
                                <button type="submit" name="Action" value="delete" class="btn btn-danger" title="@AccountResources.RemovePasskeyHint">@AccountResources.Delete</button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>@AccountResources.NoPasskeys</p>
}

<form @formname="add-passkey" @onsubmit="AddPasskey" method="post">
    @if (currentPasskeys is { Count: >= MaxPasskeyCount })
    {
        <p class="text-danger">@AccountResources.PasskeyLimitHint</p>
    }
    else
    {
        <PasskeySubmit Operation="PasskeyOperation.Create" Name="Input" class="btn btn-primary">@AccountResources.AddPasskey</PasskeySubmit>
    }

</form>

@code {
    private const int MaxPasskeyCount = 100;

    private string? message;
    private bool isError;
    private User? user;
    private IList<UserPasskeyInfo>? currentPasskeys;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageKey)]
    private string? IdentityStatusMessage { get; set; }

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageIsErrorKey)]
    private bool? IdentityStatusIsError { get; set; }

    [SupplyParameterFromForm]
    private string? Action { get; set; }

    [SupplyParameterFromForm]
    private string? CredentialId { get; set; }

    [SupplyParameterFromForm(FormName = "add-passkey")]
    private PasskeyInputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        message = IdentityStatusMessage;
        isError = IdentityStatusIsError ?? false;
        IdentityStatusMessage = null;
        IdentityStatusIsError = null;
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }
        currentPasskeys = await UserManager.GetPasskeysAsync(user);
    }

    private async Task AddPasskey()
    {
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        if (!string.IsNullOrEmpty(Input.Error))
        {
            RedirectWithMessage(Input.Error);
            return;
        }

        if (string.IsNullOrEmpty(Input.CredentialJson))
        {
            RedirectWithMessage(AccountResources.BrowserDidNotProvidePasskey);
            return;
        }

        if (currentPasskeys!.Count >= MaxPasskeyCount)
        {
            RedirectWithMessage(AccountResources.PasskeyLimitReached);
            return;
        }

        var attestationResult = await SignInManager.PerformPasskeyAttestationAsync(Input.CredentialJson);
        if (!attestationResult.Succeeded)
        {
            RedirectWithMessage(string.Format(CultureInfo.CurrentCulture, AccountResources.PasskeyAttestationFailed, attestationResult.Failure.Message));
            return;
        }

        // If the authenticator is known, assign the inferred name
        if (PasskeyAuthenticators.TryGetDefaultDisplayName(attestationResult.Passkey, out var defaultName))
        {
            attestationResult.Passkey.Name = defaultName;
        }

        var addPasskeyResult = await UserManager.AddOrUpdatePasskeyAsync(user, attestationResult.Passkey);
        if (!addPasskeyResult.Succeeded)
        {
            RedirectWithMessage(AccountResources.PasskeyAddFailed);
            return;
        }

        // If a name was inferred, go back to the passkeys list
        if (!string.IsNullOrEmpty(attestationResult.Passkey.Name))
        {
            RedirectWithMessage(AccountResources.PasskeyAdded, isError: false);
            return;
        }

        // For unknown authenticators, prompt the user to enter a name
        var credentialIdBase64Url = Base64Url.EncodeToString(attestationResult.Passkey.CredentialId);
        RedirectManager.RedirectTo($"Account/Manage/RenamePasskey/{credentialIdBase64Url}");
    }

    private async Task UpdatePasskey()
    {
        switch (Action)
        {
            case "rename":
                RedirectManager.RedirectTo($"Account/Manage/RenamePasskey/{CredentialId}");
                break;
            case "delete":
                await DeletePasskey();
                break;
            default:
                RedirectWithMessage(string.Format(CultureInfo.CurrentCulture, AccountResources.UnknownPasskeyAction, Action));
                break;
        }
    }

    private void RedirectWithMessage(string statusMessage, bool isError = true)
    {
        IdentityStatusMessage = statusMessage;
        IdentityStatusIsError = isError;
        RedirectManager.RedirectToCurrentPage();
    }

    private async Task DeletePasskey()
    {
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        byte[] credentialId;
        try
        {
            credentialId = Base64Url.DecodeFromChars(CredentialId);
        }
        catch (FormatException)
        {
            RedirectWithMessage(AccountResources.InvalidPasskeyId);
            return;
        }

        var result = await UserManager.RemovePasskeyAsync(user, credentialId);
        if (!result.Succeeded)
        {
            RedirectWithMessage(AccountResources.PasskeyDeleteFailed);
            return;
        }

        RedirectWithMessage(AccountResources.PasskeyDeleted, isError: false);
    }
}
