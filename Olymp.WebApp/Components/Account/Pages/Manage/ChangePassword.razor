@page "/Account/Manage/ChangePassword"


@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>@AccountResources.ChangePassword</PageTitle>

<h3>@AccountResources.ChangePassword</h3>
<StatusMessage Message="@message" IsError="@isError" />
<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <div role="alert" aria-atomic="true">
                <ValidationSummary class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@AccountResources.EnterOldPassword" />
                <label for="Input.OldPassword" class="form-label">
                    <DisplayName For="() => Input.OldPassword" />
                </label>
                <ValidationMessage For="() => Input.OldPassword" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@AccountResources.EnterNewPassword" />
                <label for="Input.NewPassword" class="form-label">
                    <DisplayName For="() => Input.NewPassword" />
                </label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@AccountResources.EnterNewPassword" />
                <label for="Input.ConfirmPassword" class="form-label">
                    <DisplayName For="() => Input.ConfirmPassword" />
                </label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@AccountResources.UpdatePassword</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private bool isError;
    private User? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageKey)]
    private string? IdentityStatusMessage { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        message = IdentityStatusMessage;
        IdentityStatusMessage = null;
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = string.Join(",", changePasswordResult.Errors.Select(error => error.Description));
            isError = true;
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        IdentityStatusMessage = AccountResources.PasswordChanged;
        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceName = nameof(AccountResources.FieldRequired), ErrorMessageResourceType = typeof(AccountResources))]
        [DataType(DataType.Password)]
        [Display(Name = nameof(AccountResources.CurrentPassword), ResourceType = typeof(AccountResources))]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessageResourceName = nameof(AccountResources.FieldRequired), ErrorMessageResourceType = typeof(AccountResources))]
        [StringLength(100, MinimumLength = 8, ErrorMessageResourceName = nameof(AccountResources.FieldLengthRange), ErrorMessageResourceType = typeof(AccountResources))]
        [DataType(DataType.Password)]
        [Display(Name = nameof(AccountResources.NewPassword), ResourceType = typeof(AccountResources))]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = nameof(AccountResources.ConfirmNewPassword), ResourceType = typeof(AccountResources))]
        [Compare("NewPassword", ErrorMessageResourceName = nameof(AccountResources.NewPasswordMismatch), ErrorMessageResourceType = typeof(AccountResources))]
        public string ConfirmPassword { get; set; } = "";
    }
}
