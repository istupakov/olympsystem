@page "/Account/Manage"

@using Microsoft.EntityFrameworkCore
@using Olymp.Domain

@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject OlympContext DbContext

<PageTitle>@AccountResources.Profile</PageTitle>

<h3>@AccountResources.Profile</h3>
<StatusMessage Message="@message" IsError="@isError" />

<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <div role="alert" aria-atomic="true">
                <ValidationSummary class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <input type="text" value="@username" id="username" class="form-control" placeholder="@AccountResources.UserName" disabled />
                <label for="username" class="form-label">@AccountResources.UserName</label>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.PublicName" id="Input.PublicName" class="form-control" autocomplete="nickname" aria-required="true" placeholder="@AccountResources.PublicName" />
                <label for="Input.PublicName" class="form-label">
                    <DisplayName For="() => Input.PublicName" />
                </label>
                <ValidationMessage For="() => Input.PublicName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.LastName" id="Input.LastName" class="form-control" autocomplete="family-name" placeholder="@AccountResources.LastName" />
                <label for="Input.LastName" class="form-label">
                    <DisplayName For="() => Input.LastName" />
                </label>
                <ValidationMessage For="() => Input.LastName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.FirstName" id="Input.FirstName" class="form-control" autocomplete="given-name" placeholder="@AccountResources.FirstName" />
                <label for="Input.FirstName" class="form-label">
                    <DisplayName For="() => Input.FirstName" />
                </label>
                <ValidationMessage For="() => Input.FirstName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Patronymic" id="Input.Patronymic" class="form-control" autocomplete="additional-name" placeholder="@AccountResources.Patronymic" />
                <label for="Input.Patronymic" class="form-label">
                    <DisplayName For="() => Input.Patronymic" />
                </label>
                <ValidationMessage For="() => Input.Patronymic" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputSelect @bind-Value="Input.OrganizationId" id="Input.OrganizationId" class="form-select">
                    <option value=""></option>
                    @foreach (var organization in organizations)
                    {
                        <option value="@organization.Id">@organization.Name</option>
                    }
                </InputSelect>
                <label for="Input.OrganizationId" class="form-label">
                    <DisplayName For="() => Input.OrganizationId" />
                </label>
                <ValidationMessage For="() => Input.OrganizationId" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Group" id="Input.Group" class="form-control" placeholder="@AccountResources.Group" />
                <label for="Input.Group" class="form-label">
                    <DisplayName For="() => Input.Group" />
                </label>
                <ValidationMessage For="() => Input.Group" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@AccountResources.Save</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private bool isError;
    private OlympUser? user;
    private string? username;
    private List<Organization> organizations = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageKey)]
    private string? IdentityStatusMessage { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        message = IdentityStatusMessage;
        IdentityStatusMessage = null;
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User) as OlympUser;
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        username = await UserManager.GetUserNameAsync(user);
        organizations = await DbContext.Organizations.AsNoTracking().OrderBy(x => x.Name).ToListAsync();

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Input = new()
            {
                PublicName = user.Name,
                FirstName = user.FirstName,
                LastName = user.LastName,
                Patronymic = user.Patronymic,
                OrganizationId = user.OrganizationId,
                Group = user.Details
            };
        }
    }

    private async Task OnValidSubmitAsync(EditContext editContext)
    {
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/InvalidUser");
            return;
        }

        if (Input.OrganizationId is int organizationId && !await DbContext.Organizations.AnyAsync(x => x.Id == organizationId))
        {
            var validationMessages = new ValidationMessageStore(editContext);
            validationMessages.Add(() => Input.OrganizationId, AccountResources.InvalidValue);
            editContext.NotifyValidationStateChanged();
            return;
        }

        user.Name = Input.PublicName;
        user.FirstName = string.IsNullOrEmpty(Input.FirstName) ? null : Input.FirstName;
        user.LastName = string.IsNullOrEmpty(Input.LastName) ? null : Input.LastName;
        user.Patronymic = string.IsNullOrEmpty(Input.Patronymic) ? null : Input.Patronymic;
        user.OrganizationId = Input.OrganizationId;
        user.Details = string.IsNullOrEmpty(Input.Group) ? null : Input.Group;

        var updateResult = await UserManager.UpdateAsync(user);
        if (!updateResult.Succeeded)
        {
            message = AccountResources.ProfileUpdateFailed;
            isError = true;
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        IdentityStatusMessage = AccountResources.ProfileUpdated;
        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [StringLength(32, ErrorMessageResourceName = nameof(AccountResources.FieldMaximumLength), ErrorMessageResourceType = typeof(AccountResources))]
        [Required(ErrorMessageResourceName = nameof(AccountResources.FieldRequired), ErrorMessageResourceType = typeof(AccountResources))]
        [RegularExpression(OlympUser.PublicNameRegex, ErrorMessageResourceName = nameof(AccountResources.PublicNameInvalidCharacters), ErrorMessageResourceType = typeof(AccountResources))]
        [Display(Name = nameof(AccountResources.PublicName), ResourceType = typeof(AccountResources))]
        public string PublicName { get; set; } = "";

        [StringLength(64, ErrorMessageResourceName = nameof(AccountResources.FieldMaximumLength), ErrorMessageResourceType = typeof(AccountResources))]
        [RegularExpression(OlympUser.NameRegex, ErrorMessageResourceName = nameof(AccountResources.NameInvalidCharacters), ErrorMessageResourceType = typeof(AccountResources))]
        [Display(Name = nameof(AccountResources.FirstName), ResourceType = typeof(AccountResources))]
        public string? FirstName { get; set; }

        [StringLength(64, ErrorMessageResourceName = nameof(AccountResources.FieldMaximumLength), ErrorMessageResourceType = typeof(AccountResources))]
        [RegularExpression(OlympUser.NameRegex, ErrorMessageResourceName = nameof(AccountResources.NameInvalidCharacters), ErrorMessageResourceType = typeof(AccountResources))]
        [Display(Name = nameof(AccountResources.LastName), ResourceType = typeof(AccountResources))]
        public string? LastName { get; set; }

        [StringLength(64, ErrorMessageResourceName = nameof(AccountResources.FieldMaximumLength), ErrorMessageResourceType = typeof(AccountResources))]
        [RegularExpression(OlympUser.NameRegex, ErrorMessageResourceName = nameof(AccountResources.NameInvalidCharacters), ErrorMessageResourceType = typeof(AccountResources))]
        [Display(Name = nameof(AccountResources.Patronymic), ResourceType = typeof(AccountResources))]
        public string? Patronymic { get; set; }

        [Display(Name = nameof(AccountResources.University), ResourceType = typeof(AccountResources))]
        public int? OrganizationId { get; set; }

        [StringLength(16, ErrorMessageResourceName = nameof(AccountResources.FieldMaximumLength), ErrorMessageResourceType = typeof(AccountResources))]
        [RegularExpression(OlympUser.GroupRegex, ErrorMessageResourceName = nameof(AccountResources.GroupInvalidCharacters), ErrorMessageResourceType = typeof(AccountResources))]
        [Display(Name = nameof(AccountResources.Group), ResourceType = typeof(AccountResources))]
        public string? Group { get; set; }
    }
}
