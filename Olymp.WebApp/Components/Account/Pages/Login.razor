@page "/Account/Login"


@inject SignInManager<User> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IdentityFeatures Features

<PageTitle>@AccountResources.LogIn</PageTitle>

<h1>@AccountResources.LogIn</h1>
<div class="row">
    <div class="col-lg-6">
        <section>
            <StatusMessage Message="@errorMessage" IsError="true" />
            <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <h2>@AccountResources.LoginPrompt</h2>
                <hr />
                <div role="alert" aria-atomic="true">
                    <ValidationSummary class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Login" id="Input.Login" class="form-control" autocomplete="@(Features.PasskeysEnabled ? "username webauthn" : "username")" aria-required="true" placeholder="@AccountResources.EmailOrUserName" />
                    <label for="Input.Login" class="form-label">
                        <DisplayName For="() => Input.Login" />
                    </label>
                    <ValidationMessage For="() => Input.Login" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@AccountResources.PasswordPlaceholder" />
                <label for="Input.Password" class="form-label">
                    <DisplayName For="() => Input.Password" />
                </label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" />
                        <DisplayName For="() => Input.RememberMe" />
                    </label>
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">@AccountResources.LogIn</button>
                </div>
                @if (Features.PasskeysEnabled)
                {
                    <hr />
                    <div class="d-flex flex-column">
                        <span class="text-secondary mx-auto mt-2">@AccountResources.Or</span>
                        <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Login" class="btn btn-link mx-auto">@AccountResources.LogInWithPasskey</PasskeySubmit>
                    </div>
                }
                <hr />
                <div>
                    <p>
                        <a href="account/forgotpassword">@AccountResources.ForgotPassword</a>
                    </p>
                    <p>
                        <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">@AccountResources.RegisterNewUser</a>
                    </p>
                    <p>
                        <a href="account/resendemailconfirmation">@AccountResources.ResendEmailConfirmation</a>
                    </p>
                </div>
            </EditForm>
        </section>
    </div>
</div>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageKey)]
    private string? IdentityStatusMessage { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        errorMessage = IdentityStatusMessage;
        IdentityStatusMessage = null;
        Input ??= new();

        editContext = new EditContext(Input);
    }

    public async Task LoginUser()
    {
        if (!Features.PasskeysEnabled && Input.Passkey is not null)
        {
            errorMessage = AccountResources.PasskeySignInDisabled;
            return;
        }

        if (!string.IsNullOrEmpty(Input.Passkey?.Error))
        {
            errorMessage = Input.Passkey.Error;
            return;
        }

        SignInResult result;
        if (!string.IsNullOrEmpty(Input.Passkey?.CredentialJson))
        {
            // When performing passkey sign-in, don't perform form validation.
            result = await SignInManager.PasskeySignInAsync(Input.Passkey.CredentialJson);
        }
        else
        {
            // If doing a password sign-in, validate the form.
            if (!await editContext.ValidateAsync())
            {
                return;
            }

            var user = await SignInManager.UserManager.FindByNameAsync(Input.Login)
                ?? await SignInManager.UserManager.FindByEmailAsync(Input.Login);
            result = user is null ? SignInResult.Failed
                : await SignInManager.PasswordSignInAsync(user, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        }

        if (result.Succeeded)
        {
            Logger.LogInformation("User logged in.");
            var user = await SignInManager.UserManager.GetUserAsync(SignInManager.Context.User);
            if (user is not null && EmailAsLoginRequirement.NeedsMigration(user))
                RedirectManager.RedirectTo("Account/Manage/Email", new() { ["returnUrl"] = ReturnUrl });
            else
            {
                string? returnUrl = ReturnUrl;
                if (user is Competitor participant && (string.IsNullOrEmpty(returnUrl) || returnUrl == "/"))
                    returnUrl = $"contests/{participant.ContestId}/rules";
                RedirectManager.RedirectTo(returnUrl);
            }
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            errorMessage = AccountResources.InvalidLoginAttempt;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceName = nameof(AccountResources.FieldRequired), ErrorMessageResourceType = typeof(AccountResources))]
        [Display(Name = nameof(AccountResources.EmailOrUserName), ResourceType = typeof(AccountResources))]
        public string Login { get; set; } = "";

        [Required(ErrorMessageResourceName = nameof(AccountResources.FieldRequired), ErrorMessageResourceType = typeof(AccountResources))]
        [DataType(DataType.Password)]
        [Display(Name = nameof(AccountResources.Password), ResourceType = typeof(AccountResources))]
        public string Password { get; set; } = "";

        [Display(Name = nameof(AccountResources.RememberMe), ResourceType = typeof(AccountResources))]
        public bool RememberMe { get; set; }

        public PasskeyInputModel? Passkey { get; set; }
    }
}
