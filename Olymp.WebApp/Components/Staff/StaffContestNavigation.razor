<nav aria-label="@SiteResources.StaffContestSections" class="mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <p class="h4 mb-0 text-break">@ContestName</p>
        @if (IsHidden)
        {
            <span class="small text-body-secondary">@SiteResources.StaffPublicPagesHidden</span>
        }
        else
        {
            <a href="contests/@ContestId/rules">@SiteResources.StaffPublicPages</a>
        }
    </div>
    <ul class="nav nav-underline">
        <li class="nav-item"><NavLink class="nav-link" Match="NavLinkMatch.All" href="@($"jury/contests/{ContestId}")">@SiteResources.StaffContestDetails</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="@($"jury/contests/{ContestId}/edit")">@SiteResources.StaffSettings</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="@($"jury/contests/{ContestId}/problems")">@SiteResources.Problems</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="@($"jury/contests/{ContestId}/participants")">@SiteResources.ContestParticipants</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="@($"jury/contests/{ContestId}/submissions")">@SiteResources.Submissions</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="@($"jury/contests/{ContestId}/standing")">@SiteResources.ContestStandings</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="@($"jury/contests/{ContestId}/messages")">@SiteResources.StaffMessages</NavLink></li>
        <li class="nav-item"><NavLink class="nav-link" href="@($"jury/contests/{ContestId}/anticheat")">@SiteResources.StaffAntiCheat</NavLink></li>
    </ul>
</nav>

@code {
    [Parameter, EditorRequired]
    public int ContestId { get; set; }

    [Parameter, EditorRequired]
    public string ContestName { get; set; } = "";

    [Parameter, EditorRequired]
    public bool IsHidden { get; set; } = true;
}
