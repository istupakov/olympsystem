@using Olymp.WebApp.Services.AntiCheat
@using Olymp.WebApp.Components.Submissions
@using Microsoft.AspNetCore.Components.QuickGrid

@if (Similarity.Count > 0 || Ai.Count > 0)
{
    <div class="card mb-3"><div class="card-body">
        <label for="report-author" class="form-label">@SiteResources.SubmissionAuthor</label>
        <input id="report-author" class="form-control mb-3" @bind="_author" />
    </div></div>
    <nav class="mb-3"><ul class="nav nav-underline">
        <li class="nav-item"><button class="nav-link @(!_aiTab ? "active" : null)" @onclick="() => _aiTab = false">@SiteResources.StaffSimilarity (@SimilarRows.Count)</button></li>
        <li class="nav-item"><button class="nav-link @(_aiTab ? "active" : null)" @onclick="() => _aiTab = true">@SiteResources.StaffAiDetection (@AiRows.Count)</button></li>
    </ul></nav>
    @if (!_aiTab)
    {
        <StaffGrid @key="FilterKey" TGridItem="SimilarityRow" Items="SimilarRows" ItemKey="@(item => item.Id)" OrderKey="@(item => item.Id)" EmptyText="@SiteResources.StaffNoMatches">
            <TemplateColumn Title="@SiteResources.Problem" Sortable="true" SortBy="_similarityProblemSort" Context="item">@ProblemLink(item.Case.Submission1.Problem)</TemplateColumn>
            <TemplateColumn Title="@SiteResources.StaffFirstAuthor" Sortable="true" SortBy="_firstAuthorSort" Context="item">@AuthorLink(item.Case.Submission1.User)</TemplateColumn>
            <TemplateColumn Title="@SiteResources.StaffFirstSubmission" Sortable="true" SortBy="_firstSubmissionSort" Context="item"><a target="_blank" rel="noopener" href="jury/submissions/@item.Case.Submission1.Id">#@item.Case.Submission1.Id</a></TemplateColumn>
            <TemplateColumn Title="@SiteResources.StaffSecondAuthor" Sortable="true" SortBy="_secondAuthorSort" Context="item">@AuthorLink(item.Case.Submission2.User)</TemplateColumn>
            <TemplateColumn Title="@SiteResources.StaffSecondSubmission" Sortable="true" SortBy="_secondSubmissionSort" Context="item"><a target="_blank" rel="noopener" href="jury/submissions/@item.Case.Submission2.Id">#@item.Case.Submission2.Id</a></TemplateColumn>
            <TemplateColumn Title="@SiteResources.StaffSimilarity" Sortable="true" SortBy="_similaritySort" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending" Context="item">@item.Case.Similarity.ToString("P2")</TemplateColumn>
        </StaffGrid>
    }
    else
    {
        <StaffGrid @key="FilterKey" TGridItem="AiRow" Items="AiRows" ItemKey="@(item => item.Id)" OrderKey="@(item => item.Id)" EmptyText="@SiteResources.StaffNoMatches">
            <TemplateColumn Title="@SiteResources.Problem" Sortable="true" SortBy="_aiProblemSort" Context="item">@ProblemLink(item.Case.Submission.Problem)</TemplateColumn>
            <TemplateColumn Title="@SiteResources.SubmissionAuthor" Sortable="true" SortBy="_aiAuthorSort" Context="item">@AuthorLink(item.Case.Submission.User)</TemplateColumn>
            <TemplateColumn Title="@SiteResources.Submissions" Sortable="true" SortBy="_aiSubmissionSort" Context="item"><a target="_blank" rel="noopener" href="jury/submissions/@item.Case.Submission.Id">#@item.Case.Submission.Id</a></TemplateColumn>
            <TemplateColumn Title="@SiteResources.StaffAiDetection" Sortable="true" SortBy="_aiSort" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending" Context="item">@item.Case.Result.Score.ToString("P2")</TemplateColumn>
            <TemplateColumn Title="@SiteResources.StaffAnalysisDetails" Context="item"><button class="btn btn-sm btn-outline-secondary" @onclick="() => _selected = item.Case">@SiteResources.StaffAnalysisDetails</button></TemplateColumn>
        </StaffGrid>
        @if (_selected is { } selected && AiRows.Any(item => ReferenceEquals(item.Case, selected)))
        {
            <section class="card mt-3"><h3 class="card-header h5">#@selected.Submission.Id · @selected.Submission.Problem.NameWithNumber</h3><div class="card-body">
                <p>@SiteResources.StaffCyrillicComments: @selected.Result.CyrillicComments · @SiteResources.StaffEnglishComments: @selected.Result.EnglishComments</p>
                @foreach (string fragment in selected.Result.SuspiciousFragments ?? []) { <pre class="overflow-auto">@fragment</pre> }
            </div></section>
        }
    }
}

@code {
    [Parameter] public IReadOnlyList<PlagiarismReport> Similarity { get; set; } = [];
    [Parameter] public IReadOnlyList<AIUsingReport> Ai { get; set; } = [];
    private string _author = "";
    private bool _aiTab;
    [Parameter] public IReadOnlySet<int> ExcludedProblems { get; set; } = new HashSet<int>();
    [Parameter] public int? PreferredAuthorId { get; set; }
    [Parameter] public int? PreferredSubmissionId { get; set; }
    private (string, string) FilterKey => (_author, string.Join(',', ExcludedProblems.Order()));
    private AIUsingCase? _selected;
    private readonly GridSort<SimilarityRow> _similaritySort = GridSort<SimilarityRow>.ByAscending(item => item.Case.Similarity);
    private readonly GridSort<AiRow> _aiSort = GridSort<AiRow>.ByAscending(item => item.Case.Result.Score);
    private readonly GridSort<SimilarityRow> _similarityProblemSort = GridSort<SimilarityRow>.ByAscending(item => item.Case.Submission1.Problem.Contest.Name)
        .ThenAscending(item => item.Case.Submission1.Problem.ContestId).ThenAscending(item => item.Case.Submission1.Problem.Number).ThenAscending(item => item.Case.Submission1.ProblemId);
    private readonly GridSort<SimilarityRow> _firstAuthorSort = GridSort<SimilarityRow>.ByAscending(item => item.Case.Submission1.User.Name).ThenAscending(item => item.Case.Submission1.UserId);
    private readonly GridSort<SimilarityRow> _secondAuthorSort = GridSort<SimilarityRow>.ByAscending(item => item.Case.Submission2.User.Name).ThenAscending(item => item.Case.Submission2.UserId);
    private readonly GridSort<SimilarityRow> _firstSubmissionSort = GridSort<SimilarityRow>.ByAscending(item => item.Case.Submission1.Id);
    private readonly GridSort<SimilarityRow> _secondSubmissionSort = GridSort<SimilarityRow>.ByAscending(item => item.Case.Submission2.Id);
    private readonly GridSort<AiRow> _aiProblemSort = GridSort<AiRow>.ByAscending(item => item.Case.Submission.Problem.Contest.Name)
        .ThenAscending(item => item.Case.Submission.Problem.ContestId).ThenAscending(item => item.Case.Submission.Problem.Number).ThenAscending(item => item.Case.Submission.ProblemId);
    private readonly GridSort<AiRow> _aiAuthorSort = GridSort<AiRow>.ByAscending(item => item.Case.Submission.User.Name).ThenAscending(item => item.Case.Submission.UserId);
    private readonly GridSort<AiRow> _aiSubmissionSort = GridSort<AiRow>.ByAscending(item => item.Case.Submission.Id);
    private IReadOnlyList<SimilarityRow> SimilarRows => Similarity.SelectMany(item => item.Cases).Select((item, index) => new SimilarityRow(index, Orient(item)))
        .Where(item => !ExcludedProblems.Contains(item.Case.Submission1.ProblemId) && (Matches(item.Case.Submission1.User) || Matches(item.Case.Submission2.User))).OrderByDescending(item => item.Case.Similarity).ToArray();
    private IReadOnlyList<AiRow> AiRows => Ai.SelectMany(item => item.Cases).Select((item, index) => new AiRow(index, item))
        .Where(item => !ExcludedProblems.Contains(item.Case.Submission.ProblemId) && Matches(item.Case.Submission.User)).OrderByDescending(item => item.Case.Result.Score).ToArray();
    private bool Matches(User author) => string.IsNullOrWhiteSpace(_author) || author.Name.Contains(_author.Trim(), StringComparison.CurrentCultureIgnoreCase) || author.Id.ToString() == _author.Trim();

    private PlagiarismCase Orient(PlagiarismCase item)
    {
        bool swap = PreferredSubmissionId is int submission ? item.Submission2.Id == submission && item.Submission1.Id != submission
            : PreferredAuthorId is int author && item.Submission2.UserId == author && item.Submission1.UserId != author;
        return swap ? new(item.Submission2, item.Submission1, item.Similarity) : item;
    }
    private RenderFragment ProblemLink(Problem problem) => @<div><a target="_blank" rel="noopener" href="jury/contests/@problem.ContestId/problems?problemId=@problem.Id">@problem.NameWithNumber</a><div class="small text-body-secondary">@StaffEntityLabel.Format(problem.ContestId, problem.Contest.Name)</div></div>;
    private RenderFragment AuthorLink(User author) => @<span>@if (author is Competitor participant) { <a target="_blank" rel="noopener" href="jury/contests/@participant.ContestId/participants/@participant.Id">@StaffEntityLabel.Format(author.Id, author.Name)</a> } else { @StaffEntityLabel.Format(author.Id, author.Name) }</span>;
    private sealed record SimilarityRow(int Id, PlagiarismCase Case);
    private sealed record AiRow(int Id, AIUsingCase Case);
}
