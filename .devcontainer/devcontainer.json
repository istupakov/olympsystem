{
  "name": "OlympSystem",
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.yaml"
  ],
  "service": "site",
  "runServices": ["site"],
  "workspaceFolder": "/workspaces/OlympSystem",
  "remoteUser": "ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "ubuntu",
      "installZsh": false,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
      "upgradePackages": false
    }
  },
  "forwardPorts": [5000, 5001, 5002, 5003],
  "portsAttributes": {
    "5000": {
      "label": "Olymp.WebApp (HTTP)",
      "protocol": "http",
      "requireLocalPort": true,
      "onAutoForward": "silent"
    },
    "5001": {
      "label": "Olymp.WebApp (HTTPS)",
      "protocol": "https",
      "requireLocalPort": true,
      "onAutoForward": "openBrowserOnce"
    },
    "5002": {
      "label": "Browser refresh (WS)",
      "protocol": "http",
      "requireLocalPort": true,
      "onAutoForward": "silent"
    },
    "5003": {
      "label": "Browser refresh (WSS)",
      "protocol": "https",
      "requireLocalPort": true,
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends gcc g++ texlive-latex-base texlive-lang-cyrillic cm-super && bash .devcontainer/setup-https.sh && dotnet tool restore && dotnet restore",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "redhat.vscode-yaml"
      ]
    }
  }
}
